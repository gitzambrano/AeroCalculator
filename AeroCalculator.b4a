Sub AltType_Click
	If indAltType<>2 And indSpdType<>7 Then
		Gps1.Stop
		Ready = False
		GpsCheck = 1
	Else If indAltType=2 Then
		If GpsCheck2 = 1 Then
			rp.CheckAndRequest(rp.PERMISSION_ACCESS_FINE_LOCATION)
			Wait For Activity_PermissionResult (Permission As String, Result1 As Boolean)
			GpsCheck2 = 0
			GpsStatus = Result1
		End If
		If GpsStatus Then
		    If Gps1.GPSEnabled = False And GpsCheck=1 Then
	            ToastMessageShow("Please enable the GPS device.", True)
		    	StartActivity(Gps1.LocationSettingsIntent) 'Will open the relevant settings screen.
		    	GpsCheck = 0
		    Else If Gps1.GPSEnabled = False And GpsCheck=0 Then
		    	ToastMessageShow("GPS not enabled.", True)
	        End If
		    If Not(Ready) Then
		    	Gps1.Start(100,1)
		    	Ready = True
		    End If
		Else
			ToastMessageShow("Denied location access", True)
		End If
	End If
	If indAltType < 0 Then
	Else If indAltType=0 Or indAltType=1 Or indAltType=2 Then
		If indAltType=0 Then
			btnAltType.Text = "Hp"
		Else If indAltType=1 Then
			btnAltType.Text = "Hg"
		Else If indAltType=2 Then
			btnAltType.Text = "Hg"	
		End If
		edtAlt.Hint = "Altitude"
		pa.StopListening
		If indAltUnit < 0 Then
		Else If indAltUnit = 0 Then
			btnAltUnit.Text = "ft"
			kAlt = 0.3048
		Else If indAltUnit = 1 Then
			btnAltUnit.Text = "m"
			kAlt = 1
		Else If indAltUnit = 2 Then
			btnAltUnit.Text = "km"
			kAlt = 1000
		Else If indAltUnit = 3 Then
			btnAltUnit.Text = "nm"
			kAlt = 1852
		Else If indAltUnit = 4 Then
			btnAltUnit.Text = "mi"
			kAlt = 1609.344
		Else If indAltUnit = 5 Then
			btnAltUnit.Text = "in"
			kAlt = 0.0254
		End If
		If indAltType = 2 Then
			edtAlt.Text = NumberFormat2(GPSalt / kAlt,1,1,1,False)
		End If	
	Else If indAltType = 3 Then
		btnAltType.Text = "P"
		edtAlt.Hint = "Pressure"
		pa.StopListening
		If indAltUnit < 0 Then
		Else If indAltUnit = 0 Then
			btnAltUnit.Text = "mbar"
			kPres = 100
		Else If indAltUnit = 1 Then
			btnAltUnit.Text = "Pa"
			kPres = 1
		Else If indAltUnit = 2 Then
			btnAltUnit.Text = "hPa"
			kPres = 100
		Else If indAltUnit = 3 Then
			btnAltUnit.Text = "atm"
			kPres = 101325
		Else If indAltUnit = 4 Then
			btnAltUnit.Text = "mmHg"
			kPres = 133.3223684
		Else If indAltUnit = 5 Then
			btnAltUnit.Text = "psi"
			kPres = 6894.75729
		End If
	Else If indAltType = 4 Then
		pa.Initialize2(pa.TYPE_PRESSURE,3)
		Dim listen As Boolean
		listen=pa.StartListening("Sensor1")
		If listen = False Then
		Msgbox2Async("Pressure Sensor is not supported in this device.", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
		Wait For Msbox_Result (Idx98 As Int)
		End If
		btnAltType.Text = "P"
		btnAltUnit.Text = "mbar"
		kPres = 100
		If indAltUnit < 0 Then
		Else If indAltUnit = 0 Then
			btnAltUnit.Text = "mbar"
			kPres2 = 1
		Else If indAltUnit = 1 Then
			btnAltUnit.Text = "Pa"
			kPres2 = 1*100
		Else If indAltUnit = 2 Then
			btnAltUnit.Text = "hPa"
			kPres2 = 0.01*100
		Else If indAltUnit = 3 Then
			btnAltUnit.Text = "atm"
			kPres2 = 1/101325*100
		Else If indAltUnit = 4 Then
			btnAltUnit.Text = "mmHg"
			kPres2 = 0.007500616827042*100
		Else If indAltUnit = 5 Then
			btnAltUnit.Text = "psi"
			kPres2 = 0.0001450378911491*100
		End If
		edtAlt.Text = NumberFormat2(PressureSensor*kPres2,1,2,2,False)
	End If	
End Sub

