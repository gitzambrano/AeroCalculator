Sub ShowTechnicalHelp(Field As String)
	Dim Key As String
	Select Field
	Case "alt"
		Select indAltType
		Case 0: Key = "Hp"
		Case 1: Key = "Hg"
		Case 2: Key = "Hg"
		Case 3: Key = "P"
		Case 4: Key = "P"
		Case Else: Key = "Hp"
		End Select
	Case "temp"
		If indTempType = 0 Then Key = "Δ ISA" Else Key = "OAT"
	Case "spd"
		Select indSpdType
		Case 0: Key = "TAS"
		Case 1: Key = "CAS"
		Case 2: Key = "EAS"
		Case 3: Key = "Mach"
		Case 4: Key = "CL"
		Case 5: Key = "Vs Factor"
		Case 6, 7: Key = "Ground Speed"
		Case 8: Key = "Qdyn"
		Case 9: Key = "Qc"
		Case Else: Key = "TAS"
		End Select
	Case "Weight"
		Key = "Weight"
	Case "Sref"
		Key = "Sref"
	Case "cref"
		Key = "cref"
	Case "CLmax"
		Key = "CLmax"
	Case "nz"
		If indNzType = 2 Then
			Key = "BankTurn"
		Else If indNzType = 1 Then
			Key = "NzTurn"
		Else
			Key = "NzPullup"
		End If
	Case "angle1"
		If indAngle1Type = 0 Then Key = "Track" Else Key = "Heading"
	Case "angle2"
		If indAngle2Type = 0 Then Key = "Sideslip" Else Key = "Drift"
	Case "headWind"
		If indWindType = 0 Then Key = "HeadWind" Else Key = "Wind Speed"
	Case "crossWind"
		If indWindType = 0 Then Key = "CrossWind" Else Key = "Wind Speed"
	Case "windRef"
		If indWindType = 0 Then Key = "Runway Angle" Else Key = "Wind Direction"
	Case "airplane"
		AeroSheet.ShowHelp(Activity, "Airplane Selection", "Airplane Selection" & CRLF & CRLF & "Definition: Select an aircraft profile from the saved aircraft library, or modify the individual geometric parameters directly." & CRLF & CRLF & "Model: Stored aircraft configuration database.")
		Return
	Case Else
		Key = Field
	End Select
	Dim helpText As String = AeroNames.Help(Key)
	AeroSheet.ShowHelp(Activity, Key, helpText)
End Sub

Sub ShowResultHelp(idx As Int)
	Dim keys() As String = Array As String( _
		"Pressure Altitude", "Geometric Altitude", "Geopotential Altitude", "Density Altitude", "Temperature Altitude", _
		"Pressure", "Density", "Temperature", "Delta ISA", "Total Temperature", "Viscosity", "Sound Speed", _
		"True Airspeed", "Calibrated Airspeed", "Equivalent Airspeed", "Ground Speed", "Stall Speed Vs", "Vs Factor", _
		"Lift Coefficient CL", "Mach", "Reynolds", "Pressure Ratio δ", "Density Ratio σ", "Temperature Ratio θ", _
		"Dynamic Pressure", "Impact Pressure", "Total Pressure", "DynPressure * S / g", "Lift Force", "Weight/Delta W/δ", _
		"Load Factor Nz", "Bank Angle φ", "Turn Radius", "Turn Rate", "Track Angle", "Heading Angle Ψ", "Drift Angle", _
		"Sideslip Angle β", "Wind Speed", "Wind Direction", "AlongTrack Headwind", "AlongTrack Crosswind")
	If idx >= 0 And idx < keys.Length Then
		Dim k As String = keys(idx)
		Dim helpText As String = AeroNames.Help(k)
		AeroSheet.ShowHelp(Activity, k, helpText)
	End If
End Sub

Sub pnlTest_Click
	Dim pTarget As Panel = Sender
	ShowResultHelp(pTarget.Tag)
End Sub

