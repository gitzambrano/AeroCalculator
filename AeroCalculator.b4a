		kWeight = 0.45359237
	Else If indWeightUnit = 2 Then
		btnWeightUnit.Text = "ton"
		kWeight = 1000
	Else If indWeightUnit = 3 Then
		btnWeightUnit.Text = "slug"
		kWeight =  14.5939029
	Else If indWeightUnit = 4 Then
