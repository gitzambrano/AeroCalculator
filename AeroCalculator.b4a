Sub Activity_Create(FirstTime As Boolean)
	Activity.RemoveAllViews
			
	'Keep the complete application UI inside the system-bar-safe content area.
	imeInsets.Initialize("imeInsets")
	root.Initialize("")
	Dim Content As Rect = imeInsets.GetContentRect
	Activity.AddView(root, Content.Left, Content.Top, Content.Width, Content.Height)
	imeInsets.UpdatePercentageReference(root.Width, root.Height)

	' Criando screen de settings e iniciando GPS
    If FirstTime Then
		Gps1.Initialize("GPS")
		If manager.GetAll.Size = 0 Then SetDefaults
	Else			
	End If
	GpsCheck = 1
	GpsCheck2 = 1
	GpsStatus = False
	
	'Iniciando container com as paginas
	container.Initialize
	
	' Condicoes iniciais	
	kAlt = 0.3048
	kPres = 100
	kPres2 = 1
	kTemp = 1
	cTemp = 273.15
	kTemp2 = 1
	cTemp2 = 0
	kSpd = 1852 / 3600
	kWeight = 1
	kSref = 1
	kcref = 1
	indAltUnit = 0
 	indTempUnit = 0 
 	indSpdUnit = 0 
 	indWeightUnit = 0 
 	indSrefUnit = 0 
	indcrefUnit = 0
	indAngle1Unit = 0
	indAngle2Unit = 0
	indWindRefAngleUnit = 0
 	indAltType = 0
 	indTempType = 1 
	indSpdType = 1
	indWindType = 0
	kSpd1 = 1852 / 3600
	kSpd2 = 1852 / 3600
	KAngle1 = 3.14159265358979323846 / 180
	KAngle2 = 3.14159265358979323846 / 180
	KAngle3 = 3.14159265358979323846 / 180
	
	'Themes
	If manager.GetString("theme").CompareTo("Ancient Brown")=0 Then	
		ColorPnlTitle =  Colors.RGB(140, 90, 43)       ' #8C5A2B Warm Leather Sepia
		ColorTitleText = Colors.White
		ColorPnlLine =   Colors.White
		ColorPnlLine2 =  Colors.RGB(221, 210, 192)     ' #DDD2C0
		ColorPnlLine3 =  Colors.RGB(231, 222, 206)     ' #E7DECE
		ColorBut3 =      Colors.Transparent
		ColorBut4 = 	 Colors.Transparent
		ColorButText2 =  Colors.RGB(245, 239, 235)
		ColorButText3 =  Colors.White
		ColorBut1 = 	 Colors.RGB(237, 229, 216)     ' #EDE5D8
		ColorBut2 =      Colors.RGB(228, 219, 208)     ' #E4DBD0
		ColorButText1 =  Colors.RGB(45, 35, 25)        ' #2D2319
		ColorEdt =       Colors.RGB(240, 233, 220)     ' #F0E9DC Field Fill
		ColorEdtText =   Colors.RGB(140, 90, 43)       ' #8C5A2B Field Text
		ColorEdtHint =   Colors.RGB(140, 128, 112)     ' #8C8070
		ColorPnlInput1 = Colors.RGB(250, 246, 238)     ' #FAF6EE Row 1
		ColorPnlInput2 = Colors.RGB(244, 239, 230)     ' #F4EFE6 Row 2
		ColorPnlInput3 = Colors.RGB(250, 246, 238)	
		ColorPnlInput4 = Colors.RGB(244, 239, 230)
		ColorPnlInput5 = Colors.RGB(234, 227, 213)     ' #EAE3D5 Canvas
'	Else If manager.GetString("theme").CompareTo("Green Peace")=0 Then
'			ColorPnlTitle =  Colors.RGB(0, 150, 136)
'			ColorTitleText = Colors.White
'			'ColorPnlDown =   ColorPnlTitle
'			ColorPnlLine =   Colors.White
'			ColorPnlLine2 =  Colors.DarkGray
'			ColorPnlLine3 =  ColorPnlTitle
'			ColorBut3 =      Colors.Transparent
'			ColorBut4 = 	 Colors.Transparent
'			ColorButText2 =  Colors.RGB(236, 236, 236)
'			ColorButText3 =  Colors.White
'			ColorBut1 = 	 Colors.ARGB(255,218,253,249)
'			ColorBut2 =      Colors.White
'			ColorButText1 =  Colors.Black
'			ColorEdt =       Colors.White
'			ColorEdtText =   Colors.Black
'			ColorEdtHint =   Colors.Gray
'			ColorPnlInput1 = Colors.RGB(222, 242, 241)
'			ColorPnlInput2 = Colors.RGB(222, 242, 241)
'			ColorPnlInput3 = Colors.White
'			ColorPnlInput4 = Colors.RGB(222, 242, 241)
'			ColorPnlInput5 = Colors.RGB(222, 242, 241)
	Else If manager.GetString("theme").CompareTo("Green Peace")=0 Then
		ColorPnlTitle =  Colors.RGB(0, 105, 120)       ' #006978 Deep Teal Cyan
		ColorTitleText = Colors.White
		ColorPnlLine =   Colors.White
		ColorPnlLine2 =  Colors.RGB(213, 220, 230)     ' #D5DCE6
		ColorPnlLine3 =  Colors.RGB(227, 232, 239)     ' #E3E8EF
		ColorBut3 =      Colors.Transparent
		ColorBut4 = 	 Colors.Transparent
		ColorButText2 =  Colors.RGB(239, 239, 239)
		ColorButText3 =  Colors.RGB(255, 255, 255)
		ColorBut1 = 	 Colors.RGB(248, 250, 252)     ' #F8FAFC
		ColorBut2 =      Colors.RGB(233, 238, 244)     ' #E9EEF4
		ColorButText1 =  Colors.RGB(23, 32, 51)        ' #172033
		ColorEdt =       Colors.RGB(234, 245, 247)     ' #EAF5F7 Field Fill
		ColorEdtText =   Colors.RGB(0, 105, 120)       ' #006978 Field Text
		ColorEdtHint =   Colors.RGB(90, 102, 120)      ' #5A6678
		ColorPnlInput1 = Colors.RGB(247, 249, 252)     ' #F7F9FC Row 1
		ColorPnlInput2 = Colors.White                  ' #FFFFFF Row 2
		ColorPnlInput3 = Colors.RGB(234, 245, 247)
		ColorPnlInput4 = Colors.RGB(247, 249, 252)
		ColorPnlInput5 = Colors.RGB(241, 244, 248)     ' #F1F4F8 Canvas	
	Else If manager.GetString("theme").CompareTo("Dark Shadows")=0 Then
		ColorPnlTitle =  Colors.RGB(13, 18, 27)        ' #0D121B Header
		ColorTitleText = Colors.White
		ColorPnlLine =   Colors.RGB(0, 229, 255)       ' #00E5FF Aero Cyan indicator!
		ColorPnlLine2 =  Colors.RGB(30, 39, 56)        ' #1E2738
		ColorPnlLine3 =  Colors.RGB(23, 30, 43)        ' #171E2B
		ColorBut3 =      Colors.Transparent
		ColorBut4 = 	 Colors.Transparent
		ColorButText2 =  Colors.RGB(163, 177, 198)     ' #A3B1C6
		ColorButText3 =  Colors.RGB(0, 229, 255)       ' #00E5FF
		ColorBut1 = 	 Colors.RGB(26, 35, 50)        ' #1A2332
		ColorBut2 =      Colors.RGB(18, 25, 37)        ' #121925
		ColorButText1 =  Colors.RGB(241, 245, 249)     ' #F1F5F9
		ColorEdt =       Colors.RGB(15, 27, 40)        ' #0F1B28 Field Fill
		ColorEdtText =   Colors.RGB(0, 229, 255)       ' #00E5FF Cyan input text
		ColorEdtHint =   Colors.RGB(148, 163, 184)     ' #94A3B8
		ColorPnlInput1 = Colors.RGB(10, 14, 21)        ' #0A0E15 Row 1
		ColorPnlInput2 = Colors.RGB(14, 19, 28)        ' #0E131C Row 2
		ColorPnlInput3 = Colors.RGB(15, 27, 40)	
		ColorPnlInput4 = Colors.RGB(14, 19, 28)
		ColorPnlInput5 = Colors.RGB(7, 9, 14)          ' #07090E Canvas
	Else If manager.GetString("theme").CompareTo("Blue Sky")=0 Then
		ColorPnlTitle =  Colors.RGB(11, 23, 48)        ' #0B1730 Navy Header
		ColorTitleText = Colors.White
		ColorPnlLine =   Colors.RGB(34, 211, 238)      ' #22D3EE Electric Cyan
		ColorPnlLine2 =  Colors.RGB(24, 43, 82)        ' #182B52
		ColorPnlLine3 =  Colors.RGB(38, 59, 99)        ' #263B63
		ColorBut3 =      Colors.Transparent
		ColorBut4 = 	 Colors.Transparent
		ColorButText2 =  Colors.RGB(162, 181, 216)     ' #A2B5D8
		ColorButText3 =  Colors.RGB(34, 211, 238)      ' #22D3EE
		ColorBut1 = 	 Colors.RGB(19, 37, 71)        ' #132547
		ColorBut2 =      Colors.RGB(15, 29, 58)        ' #0F1D3A
		ColorButText1 =  Colors.RGB(241, 246, 255)     ' #F1F6FF
		ColorEdt =       Colors.RGB(14, 32, 64)        ' #0E2040
		ColorEdtText =   Colors.RGB(34, 211, 238)      ' #22D3EE Electric Cyan text
		ColorEdtHint =   Colors.RGB(138, 160, 198)     ' #8AA0C6
		ColorPnlInput1 = Colors.RGB(15, 29, 58)        ' #0F1D3A Row 1
		ColorPnlInput2 = Colors.RGB(19, 37, 71)        ' #132547 Row 2
		ColorPnlInput3 = Colors.RGB(14, 32, 64)
		ColorPnlInput4 = Colors.RGB(19, 37, 71)
		ColorPnlInput5 = Colors.RGB(10, 20, 40)        ' #0A1428 Canvas
	Else If manager.GetString("theme").CompareTo("Red Alert")=0 Then
		ColorPnlTitle = Colors.RGB(183, 28, 28)
		ColorTitleText = Colors.White
		ColorPnlLine = Colors.White
		ColorPnlLine2 = Colors.RGB(239, 154, 154)
		ColorPnlLine3 = Colors.RGB(255, 205, 210)
		ColorBut3 = Colors.Transparent
		ColorBut4 = Colors.Transparent
		ColorButText2 = Colors.RGB(255, 235, 238)
		ColorButText3 = Colors.White
		ColorBut1 = Colors.RGB(255, 235, 238)
		ColorBut2 = Colors.RGB(255, 205, 210)
		ColorButText1 = Colors.RGB(74, 10, 10)
		ColorEdt = Colors.RGB(255, 245, 245)
		ColorEdtText = Colors.RGB(183, 28, 28)
		ColorEdtHint = Colors.RGB(180, 120, 120)
		ColorPnlInput1 = Colors.RGB(255, 225, 225)
		ColorPnlInput2 = Colors.RGB(255, 235, 238)
		ColorPnlInput3 = Colors.RGB(255, 245, 245)
		ColorPnlInput4 = Colors.RGB(255, 225, 225)
		ColorPnlInput5 = Colors.RGB(255, 215, 215)
	Else If manager.GetString("theme").CompareTo("Orange Juice")=0 Then
		ColorPnlTitle = Colors.RGB(230, 81, 0)
		ColorTitleText = Colors.White
		ColorPnlLine = Colors.White
		ColorPnlLine2 = Colors.RGB(255, 204, 128)
		ColorPnlLine3 = Colors.RGB(255, 224, 178)
		ColorBut3 = Colors.Transparent
		ColorBut4 = Colors.Transparent
		ColorButText2 = Colors.RGB(255, 243, 224)
		ColorButText3 = Colors.White
		ColorBut1 = Colors.RGB(255, 248, 225)
		ColorBut2 = Colors.RGB(255, 236, 179)
		ColorButText1 = Colors.RGB(93, 64, 0)
		ColorEdt = Colors.RGB(255, 253, 231)
		ColorEdtText = Colors.RGB(230, 81, 0)
		ColorEdtHint = Colors.RGB(176, 149, 117)
		ColorPnlInput1 = Colors.RGB(255, 243, 205)
		ColorPnlInput2 = Colors.RGB(255, 248, 225)
		ColorPnlInput3 = Colors.RGB(255, 253, 231)
		ColorPnlInput4 = Colors.RGB(255, 243, 205)
		ColorPnlInput5 = Colors.RGB(255, 238, 186)
	End If

	'Color shown behind transparent system bars on edge-to-edge Android versions.
	Activity.Color = ColorPnlTitle
	root.Color = ColorPnlInput5

	'Tamanho e numero de paineis de inputs
	ib = 8dip
	tb = 40dip
	Dim PanelNb As Int
	PanelNb = 14

	'Escalonamento com a area util (exclui status/navigation bars).
	Dim hh, yy As Double
	hh = 99dip + PanelNb * (ib * 2 + tb) + PanelNb * 1dip + 1dip
	yy = root.Height
	xx = root.Width

	sc = yy / hh
	If sc<1 Then
		sc=1
	End If
	If root.Width > root.Height Then
		ld = 1
		HeaderTopH = 40dip
		HeaderTabsY = 40dip
		HeaderTabsH = 36dip
		HeaderHeight = 76dip
	Else
		ld = 0
		HeaderTopH = 56dip * sc
		HeaderTabsY = 56dip * sc
		HeaderTabsH = 42dip * sc
		HeaderHeight = HeaderTopH + HeaderTabsH
	End If
	
	'Criando pagina de Airplanes
	pnlBack0.Initialize("")
	pnlBack0.Color = ColorPnlInput5
    scvMain0.Initialize(3000)
	pnlBack0.AddView(scvMain0, 0, 0, root.Width, root.Height-HeaderHeight)
	lst.Initialize(Me, scvMain0, "", "lst_Click", "lst_LongClick", 1dip)
	lst.DividerColor = ColorPnlLine3
	lastAirpClickTime = 0
	lastAirpClickID = -1
	container.AddPage(pnlBack0,"Airplanes")
	
	' Inicializando variaveis para definir se vamos editar ou adicionar um aviao.
	ID_edt = 0
	Airp.add = 0
	
	' Criando pagina de inputs
	pnlBack1.Initialize("")
	pnlBack1.Color = ColorPnlInput5
    scvMain1.Initialize(100%y)
	pnlBack1.AddView(scvMain1, 0, 0, root.Width, root.Height-HeaderHeight)
 

	' Criando tela de inputs
	Dim j As Int
	For j=0 To PanelNb-1
		pnlInput.Initialize("pnlInput")
		pnlline.Initialize("pnlline")
		If j=0 Then
			scvMain1.Panel.AddView(pnlInput, 0, 0, 100%x, (ib*2+tb)*sc)
			scvMain1.Panel.AddView(pnlline, 0%x, (PanelNb * (ib * 2 + tb) + (PanelNb) * 1dip) * sc-1dip, 100%x, 1dip * sc)
		Else
			scvMain1.Panel.AddView(pnlInput, 0%x, (j * (ib*2+tb)+j*1dip)*sc, 100%x, (ib*2+tb)*sc)
			scvMain1.Panel.AddView(pnlline, 0%x, (j * (ib*2+tb)+j*1dip-1dip)*sc, 100%x,1dip*sc)
		End If
		
	    pnlInput.Tag=j
	    If (j Mod 2)=1 Then
			pnlInput.Color = ColorPnlInput1		
	    Else
	        pnlInput.Color = ColorPnlInput2
		End If
		pnlline.Color = ColorPnlLine3
		
		Dim filter As IME
		filter.Initialize("")	
		
		Select j
		Case 0
			btnAirplane.Initialize("btnAirplane")
			pnlInput.AddView(btnAirplane, 3%x, ib*sc, 44%x, tb*sc)
			btnAirplane.Text = "Airplane"
			btnAirplane.TextSize = 15*sc
			btnAirplane.TextColor = ColorButText1
			btnAirplane.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2),Array As Int(ColorBut1, ColorPnlTitle))
			panelspn.Initialize("panelspn")
			pnlInput.AddView(panelspn, 50%x, ib * sc, 47%x, tb * sc)
			panelspn.Background = EditGradient(ColorEdt, ColorPnlLine2)
			spnAirp.Initialize("spnAirp")
			spnAirp.TextSize = 14*sc
			SpinnerCreate
			'SetNinePatchDrawable(spnAirp, "spinner_ab_default_holo_light_am")
		Case 1
		    btnAltType.Initialize("btnAltType")
			pnlInput.AddView(btnAltType, 3%x, ib*sc, 44%x, tb*sc)
			If xx > 340dip Or sc > 1 Then
				btnAltType.Text = MakeSubscript("Altitude H", "p", "")
			Else
				btnAltType.Text = MakeSubscript("H", "p", "")
			End If
			btnAltType.TextSize = 15*sc
			btnAltType.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2),Array As Int(ColorBut1, ColorPnlTitle))
			edtAlt.Initialize("edtAlt")
		    pnlInput.AddView(edtAlt, 50%x, ib*sc, 27%x, tb*sc)
			edtAlt.Hint="Altitude"
			edtAlt.Gravity = Gravity.CENTER
			edtAlt.InputType = edtAlt.INPUT_TYPE_DECIMAL_NUMBERS
			edtAlt.ForceDoneButton = True
			edtAlt.TextSize = 13*sc
			filter.SetCustomFilter(edtAlt, edtAlt.INPUT_TYPE_DECIMAL_NUMBERS, "0123456789.-")
			btnAltUnit.Initialize("btnAltUnit")
			btnAltUnit.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2),Array As Int(ColorBut1, ColorPnlTitle))
		    pnlInput.AddView(btnAltUnit, 80%x, ib*sc, 17%x, tb*sc)
		    btnAltUnit.Text="ft"
			btnAltUnit.TextSize = 15*sc
			edtAlt.TextColor = ColorEdtText
			edtAlt.Background = EditGradient(ColorEdt, ColorPnlLine2)
			edtAlt.HintColor = ColorEdtHint
			edtAlt.Typeface = Typeface.DEFAULT_BOLD
			btnAltType.TextColor = ColorButText1
			btnAltUnit.TextColor = ColorButText1
			'SetNinePatchButton2(edtAlt, "apptheme_textfield_default_holo_light","","", "apptheme_textfield_activated_holo_light","")
		Case 2
		    btnTempType.Initialize("btnTempType")
