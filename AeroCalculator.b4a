			btnSpdUnit.Text = "atm"
			kSpd = 101325
		Else If indSpdUnit = 4 Then
			btnSpdUnit.Text = "mmHg"
			kSpd = 133.3223684
		Else If indSpdUnit = 5 Then
			btnSpdUnit.Text = "psi"
			kSpd = 6894.75729
		End If
	End If
	If indSpdType=7 Then
		edtSpd.Text = NumberFormat2(GPSspeed / kSpd, 1, 1, 1, False)
	End If
	
End Sub

Sub Weight_Click
	Dim w As String
	Dim count As Int: count=0
	Dim ii As Int
	If indWeightType = 0 Then
		btnWeight.Text = "Weight"
		edtWeight.Text = ""
	Else
		For ii=1 To 6
			w = a.GetDefault(ID_inp & "_W" & ii,"")
			If w.CompareTo("") <> 0 Then
			count = count + 1
			End If
			If count=indWeightType Then Exit
		Next
		If ii = 1 Then
			btnWeight.Text  = "MTOW"
		Else If ii = 2 Then
			btnWeight.Text  = "MLW"
		Else If ii = 3 Then
			btnWeight.Text  = "MZFW"
		Else If ii = 4 Then
			btnWeight.Text  = "BOW"
		Else If ii = 5 Then
			btnWeight.Text  = "Heavy"
		Else If ii = 6 Then
			btnWeight.Text  = "Light"
		End If
		edtWeight.Text = a.GetDefault(ID_inp & "_W" & ii,"")
		indWeightUnit = a.Get(ID_inp & "_Wunit")
		WeightUnit_Click
	End If
End Sub

Sub WeightUnit_Click
	If indWeightUnit < 0 Then
	Else If indWeightUnit = 0 Then
