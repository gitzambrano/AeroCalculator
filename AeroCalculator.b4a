Sub CLmax_Click
	Dim w As String
	Dim count As Int: count=0
	Dim ii As Int
	If indCLmaxType = 0 Then
		Dim rs3 As RichString
		rs3.Initialize("CL{T}MAX{T}")
		rs3.RelativeSize2(.7,"{T}")
		btnCLmax.Text = rs3
		edtCLmax.Text = ""
	Else
		For ii=1 To 14
			w = a.GetDefault(ID_inp & "_F" & (ii-1),"")
			If w.CompareTo("") <> 0 Then
			count = count + 1
			End If
			If count=indCLmaxType Then Exit
		Next
		Dim rs3 As RichString
		rs3.Initialize("CL{T}MAX{T} F" & (ii-1))
		rs3.RelativeSize2(.7,"{T}")
		btnCLmax.Text = rs3
		If sc > 1 Or ld = 1 Or xx>350dip Then
			Dim rs4 As RichString
			rs4.Initialize("CL{T}MAX{T} - F" & (ii-1))
			rs4.RelativeSize2(.7,"{T}")
			btnCLmax.Text = rs4
		End If
		edtCLmax.Text = a.GetDefault(ID_inp & "_F" & (ii-1),"")
	End If
End Sub

