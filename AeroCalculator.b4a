Sub Activity_KeyPress (KeyCode As Int) As Boolean 'Return True to consume the event
	If KeyCode = KeyCodes.KEYCODE_BACK Then
		If AeroSheet.IsInitialized And AeroSheet.IsShowing Then
			AeroSheet.Dismiss
			Return True
		End If
		If SettingsPopupOpen Then
			CloseSettingsPopup
			Return True
		End If
		If CurrentPage = 2 Then
			pager.GotoPage(1, True)
			Return True 
		End If
	End If
	Return False
End Sub

Sub Calculate
	
	'Set default units and inputs
	DefaultInputs
	
	'Constantes da Atmosfera Padrao
	Thp=11000
	e=4.2558797  
	Rho0=1.225
	P0=101325
	Vsound0=340.294  
	mu0=0.000017894
	exp=2.71828182846
	
	' Usuario escolheu Altitude Geometrica como Input
	Dim Hgeom_input_m,Hp_input_m As Double
	If indAltType = 1 Or indAltType = 2 Then
		Hgeom_input_m = AltValue
		Hgeop_m = (6356766/(6356766+Hgeom_input_m))*Hgeom_input_m
		Hgeom = Hgeom_input_m/0.3048
		Hp_input_m = PressureAltitudeFromGeometricAltitude(Hgeop_m)
	End If
	
	' Usuario escolheu Altitude Pressao como Input
	If indAltType = 0 Then
		Hp = AltValue
	Else If indAltType = 1 Or indAltType = 2 Then
		Hp = Hp_input_m
	End If
	
	' Usuario escolheu Altitude Pressao ou Geometrica como Input
	If indAltType = 0 Or indAltType = 1 Or indAltType = 2 Then
		SetStandardAtmosphereFromPressureAltitude(Hp)
		P = P_P0 * P0
	' Usuario escolheu Pressao Atmosferica como Input
	Else If indAltType = 3 Or indAltType = 4 Then
		If indAltType = 3 Then
			P = AltValue
		Else If  indAltType = 4 Then
			P = PressureSensor * kPres
		End If
		Hp = PressureAltitudeFromStaticPressure(P)
		SetStandardAtmosphereFromPressureAltitude(Hp)
	 End If
	 
	' Usuario escolheu Delta ISA
	If indTempType = 0 Then
		isa = TempValue*kTemp
		T_kelvin = T_std + isa
	' Usuario escolheu OAT
	Else
		T_kelvin = TempValue*kTemp + cTemp
		isa = T_kelvin - T_std
	End If
	T_degC = T_kelvin-273.15
	T_T0 = T_kelvin/288.15
	'DhpDh = T_std/(T_std+isa)
	Vsound = Sqrt(T_T0)*Vsound0
	'Rho_std = Rho_Rho0*Rho0
	'Rho = Rho_std/(1+isa/T_std)
	Rho_Rho0=P_P0/T_T0
	Rho=Rho_Rho0*Rho0
	mu = mu0*(Power(T_kelvin,1.5)/(T_kelvin+120)/11.984)
	Hd = DensityAltitudeFromDensity(Rho)/0.3048
	
	If indAltType = 0 Or indAltType = 3 Or indAltType = 4 Then
	Hgeop_m = Hp - 29.271247 * isa* Logarithm(P_P0,exp)
	Hgeom = 6356766 * Hgeop_m / (6356766 - Hgeop_m) / 0.3048
	End If
	Hgeop = Hgeop_m/0.3048
	Hp_ft = Hp / 0.3048
	
	If T_kelvin>216.65 Then
		Htemp=11000/0.3048*(288.15-T_kelvin)/71.5
	Else
		Htemp=11000/0.3048
	End If
	
	' Usuario Escolheu Nz como Input
	If indNzType=0 Then
		Nz = NzValue
		Bank = 0
	Else If indNzType = 1 Then
		Nz = NzValue
		Bank = ACos(1/Nz)
	' Usuario Escolheu bank como Input
	Else If indNzType = 2 Then
		Nz = 1 / Cos(NzValue * 3.14159265358979 / 180)
		Bank = NzValue * 3.14159265358979 / 180
	End If
	
	'Calculo de Vs
	Vs_tas = Sqrt(2*weight*9.80665/Rho0/Sref/CLmax)/Sqrt(Rho/Rho0)
	Vs_mach = Vs_tas / Vsound
	Vs_cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((Vs_mach*Vs_mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
	
	' Usuario escolheu TAS como Input
	If indSpdType = 0 Then
		tas = SpdValue
		mach = tas / Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas
	' Usuario escolheu Mach como Input
	Else If indSpdType = 3 Then
		mach = SpdValue
		tas = mach * Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas 
	' Usuario escolheu EAS como Input
	Else If indSpdType = 2 Then
		eas = SpdValue
		tas = eas / Sqrt(Rho/Rho0)
		mach = tas / Vsound
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas
	' Usuario escolheu CL como Input
	Else If indSpdType = 4 Then
		CL = SpdValue
		eas = Sqrt(2*weight*Nz*9.80665/1.225/Sref/CL)
		tas = eas / Sqrt(Rho/Rho0)
		mach = tas / Vsound
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas
	' Usuario escolheu CAS como Input
	Else If indSpdType = 1 Then
		cas = SpdValue
		mach = Sqrt(5*(Power((((Power((((Power((cas/Vsound0),2))/5)+1),3.5)-1)/P_P0)+1),(1/3.5))-1))
		tas = mach * Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		VsFact = cas / Vs_cas
	' Usuario escolheu VS Factor como Input
	Else If indSpdType = 5 Then
		cas = (SpdValue * Vs_cas) + (SpdDelta)
		mach = Sqrt(5*(Power((((Power((((Power((cas/Vsound0),2))/5)+1),3.5)-1)/P_P0)+1),(1/3.5))-1))
		tas = mach * Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight * Nz * 9.80665 / 0.5 / 1.225 / Sref / (eas * eas)
		VsFact = cas / Vs_cas
	' Usuario escolheu Ground Speed do GPS como Input
	Else If indSpdType = 6 Or indSpdType = 7 Then
		gs = SpdValue
		WindCalc
		mach = tas / Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas
	' Usuario escolheu Pressao Dinamica como Input	
	Else If indSpdType = 8  Then
		Qd = SpdValue
		tas = Sqrt(Qd/0.5/Rho)
		mach = tas / Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas
	'Usuario Escolheu Pressao de Impacto como Input	
	Else If indSpdType = 9  Then
		Qc = SpdValue
		mach = Sqrt(5*(Power(((Qc/P)+1),(1/3.5)) - 1))
		tas = mach * Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas 
	End If
	
	' Outputs Adicionais
	re = Rho * tas * cref / mu
	Qd = 0.5* Rho * tas * tas
	Qc = P * (Power((1+0.2*mach*mach),3.5) -1 )
	Ptot = Qc + P
	Ttot = T_kelvin * (1+0.2*mach*mach)
	Ttot_degC = Ttot - 273.15
	
	' Validade dos Calculos
	If Hp_ft>(84852/0.3048) Then
		Msgbox2Async("Watch out! This app only models the atmosphere up to 84.852 kilometers", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
		Wait For Msbox_Result (Idx103 As Int)
	End If
	
	If indSpdType <> 6 And indSpdType <> 7 Then
		WindCalc
	End If
	
	' Criando Panels de Outputs
	For i=0 To PanelNb1-1
		Dim pnltest As Panel
		Dim pnlline As Panel
		pnltest.Initialize("pnlTest")
		pnlline.Initialize("pnlline")
		scvMain2.Panel.AddView(pnltest, 0, i*PanelHeight1, 100%x, PanelHeight1)
		scvMain2.Panel.AddView(pnlline, 0,(i+1)*PanelHeight1-1dip, 100%x, 1dip)
		pnlline.Color = ColorPnlLine3
	    pnltest.Tag=i
	    If (i Mod 2)=1 Then
	        pnltest.Color=ColorPnlInput3	
	    Else
	        pnltest.Color=ColorPnlInput4	
	    End If	    
		lblVar.Initialize("lblVar")
	    pnltest.AddView(lblVar, 8dip, 0dip, 52%x - 8dip, PanelHeight1)
	    lblVar.Tag=i
	    lblVar.TextSize=14
		lblVar.TextColor = ColorButText1
		lblVar.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	    lblRes.Initialize("lblRes")
	    pnltest.AddView(lblRes, 52%x, 0dip, 48%x - 8dip, PanelHeight1)
	    lblRes.Tag=i
	    lblRes.TextSize=15
		lblRes.Typeface = Typeface.DEFAULT_BOLD
		lblRes.TextColor = ColorEdtText
		lblRes.Gravity =  Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
		Try
			Dim joRes As JavaObject = lblRes
			joRes.RunMethod("setFontFeatureSettings", Array("tnum"))
		Catch
			Log("tnum skipped: " & LastException.Message)
		End Try
		WriteText
	Next

End Sub

Sub DefaultInputs
		' Setar default caso usuario nao preencha campos
	If edtAlt.Text.CompareTo("")=0 Then
		edtAlt.Text = 0
	End If
	If edtTemp.Text.CompareTo("")=0 Then
		edtTemp.Text = 0
	End If
	If edtSpd.Text.CompareTo("")=0 Then
		edtSpd.Text = 0
	End If
	If edtSpdDelta.Text.CompareTo("")=0 Then
		edtSpdDelta.Text = 0
	End If
	If edtWeight.Text.CompareTo("")=0 Then
		edtWeight.Text =  1
	End If
	If edtSref.Text.CompareTo("")=0 Then
		edtSref.Text =  1
	End If
	If edtcref.Text.CompareTo("")=0 Then
		edtcref.Text =  1
	End If
	If edtCLmax.Text.CompareTo("")=0 Then
		edtCLmax.Text =  1 
	End If
	If edtNz.Text.CompareTo("") = 0 Then
		If indNzType=0 Or indNzType=1 Then
			edtNz.Text = 1
		Else If indNzType = 2 Then
			edtNz.Text = 0
		End If
	End If
	If edtAngle1.Text.CompareTo("") = 0 Then
		edtAngle1.Text = 0
	End If
	If edtAngle2.Text.CompareTo("") = 0 Then
		edtAngle2.Text = 0
	End If
	If edtHeadWind.Text.CompareTo("") = 0 Then
		edtHeadWind.Text = 0
	End If
	If edtCrossWind.Text.CompareTo("") = 0 Or indWindType=1 Then
		edtCrossWind.Text = 0
	End If
	If edtWindRefAngle.Text.CompareTo("") = 0 Then
		edtWindRefAngle.Text = 0
	End If
	
	' Transformar para unidades SI
	weight = edtWeight.Text * kWeight
	Sref = edtSref.Text * kSref
	cref = edtcref.Text * kcref
	CLmax = edtCLmax.Text
	If indAltType=0 Or indAltType=1 Or indAltType=2 Then 
		AltValue = edtAlt.Text * kAlt
	Else
		AltValue = edtAlt.Text * kPres
	End If
	TempValue = edtTemp.Text
	If indSpdType=0 Or indSpdType=1 Or indSpdType=2 Or indSpdType=6 Or indSpdType=7 Or indSpdType=8 Or indSpdType=9 Then 
		SpdValue = edtSpd.Text * kSpd
	Else
		SpdValue = edtSpd.Text * 1
	End If
	SpdDelta = edtSpdDelta.Text * 0.51444444
	NzValue = edtNz.Text
	Angle1Value = edtAngle1.Text * KAngle1
	Angle2Value = edtAngle2.Text * KAngle2
	Headwind = edtHeadWind.Text * kSpd1
	CrossWind = edtCrossWind.Text  * kSpd2
	WindRefAngle = edtWindRefAngle.Text  * KAngle3
End Sub

Sub WindCalc
	u_wind_inert = -Headwind*Cos(WindRefAngle) + CrossWind*Sin(WindRefAngle)
	v_wind_inert = -CrossWind*Cos(WindRefAngle) - Headwind*Sin(WindRefAngle)
	WS = Sqrt(Headwind*Headwind + CrossWind*CrossWind)
	WD = ATan2(v_wind_inert, u_wind_inert) + 3.14159265358979

	Dim AirDirection, WindAlongAir, Discriminant, WindNormal, Ratio As Double

	If indSpdType = 6 Or indSpdType = 7 Then
		' Ground speed is known.
		If indAngle1Type = 0 Then
			' Track is known, so the complete ground-velocity vector is known.
			Track = Angle1Value
			u_inert = gs*Cos(Track)
			v_inert = gs*Sin(Track)
			u_airsp_inert = u_inert - u_wind_inert
			v_airsp_inert = v_inert - v_wind_inert
			tas = Sqrt(u_airsp_inert*u_airsp_inert + v_airsp_inert*v_airsp_inert)
			AirDirection = ATan2(v_airsp_inert, u_airsp_inert)
			If indAngle2Type = 0 Then
				Beta = Angle2Value
				Psi = AirDirection - Beta
			Else
				Drift = Angle2Value
				Psi = Track + Drift
				Beta = NormalizeSignedAngle(AirDirection - Psi)
			End If
		Else
			' Heading is known.
			Psi = Angle1Value
			If indAngle2Type = 1 Then
				' Drift fixes track, so the complete ground-velocity vector is known.
				Drift = Angle2Value
				Track = Psi - Drift
				u_inert = gs*Cos(Track)
				v_inert = gs*Sin(Track)
				u_airsp_inert = u_inert - u_wind_inert
				v_airsp_inert = v_inert - v_wind_inert
				tas = Sqrt(u_airsp_inert*u_airsp_inert + v_airsp_inert*v_airsp_inert)
				AirDirection = ATan2(v_airsp_inert, u_airsp_inert)
				Beta = NormalizeSignedAngle(AirDirection - Psi)
			Else
				' Heading and sideslip fix the air-velocity direction. Solve its magnitude.
				Beta = Angle2Value
				AirDirection = Psi + Beta
				WindAlongAir = u_wind_inert*Cos(AirDirection) + v_wind_inert*Sin(AirDirection)
				Discriminant = WindAlongAir*WindAlongAir + gs*gs - WS*WS
				If Discriminant < 0 Then
					MsgboxAsync("Ground speed is incompatible with the selected heading, sideslip, and wind.", "Error")
					tas = 0
					Return
				End If
				tas = -WindAlongAir + Sqrt(Discriminant)
				If tas < 0 Then
					MsgboxAsync("Ground speed is incompatible with the selected heading, sideslip, and wind.", "Error")
					tas = 0
					Return
				End If
				u_airsp_inert = tas*Cos(AirDirection)
				v_airsp_inert = tas*Sin(AirDirection)
				u_inert = u_airsp_inert + u_wind_inert
				v_inert = v_airsp_inert + v_wind_inert
				Track = ATan2(v_inert, u_inert)
			End If
		End If
	Else
		' TAS is known.
		If indAngle1Type = 1 And indAngle2Type = 0 Then
			' Heading and sideslip directly fix the air-velocity vector.
			Psi = Angle1Value
			Beta = Angle2Value
			AirDirection = Psi + Beta
		Else
			' The remaining combinations fix track. Solve the air direction that cancels cross-track wind.
			If indAngle1Type = 0 Then
				Track = Angle1Value
				If indAngle2Type = 0 Then
					Beta = Angle2Value
				Else
					Drift = Angle2Value
					Psi = Track + Drift
				End If
			Else
				Psi = Angle1Value
				Drift = Angle2Value
				Track = Psi - Drift
			End If

			WindNormal = -u_wind_inert*Sin(Track) + v_wind_inert*Cos(Track)
			Ratio = -WindNormal/tas
			If Abs(Ratio) > 1 Then
				MsgboxAsync("Selected track cannot be maintained with the current airspeed and wind.", "Error")
				gs = 0
				Return
			End If
			AirDirection = Track + ASin(Ratio)
			If indAngle1Type = 0 And indAngle2Type = 0 Then
				Psi = AirDirection - Beta
			Else
				Beta = NormalizeSignedAngle(AirDirection - Psi)
			End If
		End If

		u_airsp_inert = tas*Cos(AirDirection)
		v_airsp_inert = tas*Sin(AirDirection)
		u_inert = u_airsp_inert + u_wind_inert
		v_inert = v_airsp_inert + v_wind_inert
		gs = Sqrt(u_inert*u_inert + v_inert*v_inert)
		Track = ATan2(v_inert, u_inert)
	End If

	Drift = NormalizeSignedAngle(Psi - Track)
	Beta = NormalizeSignedAngle(Beta)

	HW = WS*Cos(WD-Track)
	CW = WS*Sin(WD-Track)

	If Abs(Drift) < 0.000001 Then Drift = 0
	If Abs(Track) < 0.000001 Then Track = 0
	If Abs(Beta) < 0.000001 Then Beta = 0
	If Abs(Psi) < 0.000001 Then Psi = 0
	If Abs(WS) < 0.000001 Then WS = 0
	If Abs(WD) < 0.000001 Then WD = 0
	If Abs(HW) < 0.000001 Then HW = 0
	If Abs(CW) < 0.000001 Then CW = 0

	Select manager.GetString("angleformat")
	Case "0/360 (0/π)"
		If Track < 0 Then
			Track = 2*3.14159265358979323846 + Track
		Else If Track >= 2*3.14159265358979323846 Then
			Track = Track - 2*3.14159265358979323846
		End If
		If Psi < 0 Then
			Psi = 2*3.14159265358979323846 + Psi
		Else If Psi >= 2*3.14159265358979323846 Then
			Psi = Psi - 2*3.14159265358979323846
		End If
		If WD < 0 Then
			WD = 2*3.14159265358979323846 + WD
		Else If WD >= 2*3.14159265358979323846 Then
			WD = WD - 2*3.14159265358979323846
		End If
	Case "-180/180 (-π/π)"
		Track = NormalizeSignedAngle(Track)
		Psi = NormalizeSignedAngle(Psi)
		WD = NormalizeSignedAngle(WD)
	End Select
End Sub

Sub NormalizeSignedAngle (Angle As Double) As Double
	Do While Angle > 3.14159265358979323846
		Angle = Angle - 2*3.14159265358979323846
	Loop
	Do While Angle <= -3.14159265358979323846
		Angle = Angle + 2*3.14159265358979323846
	Loop
	Return Angle
End Sub

Sub CalcError (Hgeop_input_m As Double, Hp_input_m As Double) As Double
	Dim Residual, LocalIsa, LocalT As Double
	SetStandardAtmosphereFromPressureAltitude(Hp_input_m)
	If indTempType = 0 Then
		LocalIsa = TempValue*kTemp
	Else
		LocalT = TempValue*kTemp + cTemp
		LocalIsa = LocalT - T_std
	End If
	Residual = Hp_input_m - Hgeop_input_m - 29.271247*LocalIsa*Logarithm(P_P0,exp)
	Return Residual
End Sub

Sub PressureAltitudeFromGeometricAltitude (Hgeop_input_m As Double) As Double
	Dim Lower, Upper, FLower, FUpper, Guess, FGuess As Double
	Dim Perturb, XLower, XUpper, Derivative, Candidate As Double
	Dim cont As Int
	Lower = -5000
	Upper = 84852
	FLower = CalcError(Hgeop_input_m, Lower)
	FUpper = CalcError(Hgeop_input_m, Upper)

	If FLower*FUpper > 0 Then
		Return Hgeop_input_m
	End If

	Guess = Hgeop_input_m
	If Guess <= Lower Or Guess >= Upper Then Guess = (Lower + Upper)/2
	Perturb = 1

	For cont = 0 To 39
		FGuess = CalcError(Hgeop_input_m, Guess)
		If Abs(FGuess) <= 0.001 Then
			Return Guess
		End If

		If FLower*FGuess <= 0 Then
			Upper = Guess
			FUpper = FGuess
		Else
			Lower = Guess
			FLower = FGuess
		End If

		XLower = Guess - Perturb
		XUpper = Guess + Perturb
		If XLower < Lower Then XLower = Lower
		If XUpper > Upper Then XUpper = Upper
		If XUpper > XLower Then
			Derivative = (CalcError(Hgeop_input_m, XUpper) - CalcError(Hgeop_input_m, XLower))/(XUpper-XLower)
		Else
			Derivative = 0
		End If

		If Abs(Derivative) > 0.000000001 Then
			Candidate = Guess - FGuess/Derivative
		Else
			Candidate = (Lower + Upper)/2
		End If
		If Candidate <= Lower Or Candidate >= Upper Then Candidate = (Lower + Upper)/2
		Guess = Candidate
	Next

	Return Guess
End Sub

Sub StandardDensityAtPressureAltitude (AltitudeM As Double) As Double
	Dim SavedT, SavedP, StandardDensity As Double
	SavedT = T_std
	SavedP = P_P0
	SetStandardAtmosphereFromPressureAltitude(AltitudeM)
	StandardDensity = P_P0*P0/(287.05287*T_std)
	T_std = SavedT
	P_P0 = SavedP
	Return StandardDensity
End Sub

Sub DensityAltitudeFromDensity (DensityValue As Double) As Double
	Dim Lower, Upper, Midpoint, MidDensity As Double
	Dim cont As Int
	Lower = -5000
	Upper = 84852

	If DensityValue >= StandardDensityAtPressureAltitude(Lower) Then
		Return Lower
	End If
	If DensityValue <= StandardDensityAtPressureAltitude(Upper) Then
		Return Upper
	End If

	For cont = 0 To 31
		Midpoint = (Lower + Upper)/2
		MidDensity = StandardDensityAtPressureAltitude(Midpoint)
		If MidDensity > DensityValue Then
			Lower = Midpoint
		Else
			Upper = Midpoint
		End If
	Next
	Return (Lower + Upper)/2
End Sub

Sub SetStandardAtmosphereFromPressureAltitude (AltitudeM As Double)
	If AltitudeM<11000 Then
		T_std=288.15-0.0065*AltitudeM
		P_P0=Power(T_std/288.15,5.2558797)
	Else If AltitudeM<20000 Then
		T_std=216.65
		P_P0=0.223360869430*Power(exp,-9.80665*(AltitudeM-11000)/(287.05287*216.65))
	Else If AltitudeM<32000 Then
		T_std=216.65+0.001*(AltitudeM-20000)
		P_P0=0.054032839124*Power(216.65/T_std,34.16320)
	Else If AltitudeM<47000 Then
		T_std=228.65+0.0028*(AltitudeM-32000)
		P_P0=0.008566649658*Power(228.65/T_std,12.20114)
	Else If AltitudeM<51000 Then
		T_std=270.65
		P_P0=0.001094554881*Power(exp,-9.80665*(AltitudeM-47000)/(287.05287*270.65))
	Else If AltitudeM<71000 Then
		T_std=270.65-0.0028*(AltitudeM-51000)
		P_P0=0.000660631908*Power(T_std/270.65,12.20114)
	Else
		T_std=214.65-0.002*(AltitudeM-71000)
		P_P0=0.000039046555*Power(T_std/214.65,17.08160)
	End If
End Sub

Sub PressureAltitudeFromStaticPressure (PressurePa As Double) As Double
	Dim PressureRatio As Double
	Dim LayerTemperature As Double
	Dim Result As Double
	PressureRatio=PressurePa/P0
	If PressureRatio>0.223360869430 Then
		LayerTemperature=288.15*Power(PressureRatio,1/5.2558797)
		Result=(288.15-LayerTemperature)/0.0065
	Else If PressureRatio>0.054032839124 Then
		Result=11000-287.05287*216.65/9.80665*Logarithm(PressureRatio/0.223360869430,exp)
	Else If PressureRatio>0.008566649658 Then
		LayerTemperature=216.65*Power(PressureRatio/0.054032839124,-1/34.16320)
		Result=20000+(LayerTemperature-216.65)/0.001
	Else If PressureRatio>0.001094554881 Then
		LayerTemperature=228.65*Power(PressureRatio/0.008566649658,-1/12.20114)
		Result=32000+(LayerTemperature-228.65)/0.0028
	Else If PressureRatio>0.000660631908 Then
		Result=47000-287.05287*270.65/9.80665*Logarithm(PressureRatio/0.001094554881,exp)
	Else If PressureRatio>0.000039046555 Then
		LayerTemperature=270.65*Power(PressureRatio/0.000660631908,1/12.20114)
		Result=51000+(LayerTemperature-270.65)/-0.0028
	Else
		LayerTemperature=214.65*Power(PressureRatio/0.000039046555,1/17.08160)
		Result=71000+(LayerTemperature-214.65)/-0.002
	End If
	Return Result
End Sub
Sub WriteText
	
	' Capturar Unidades dos Outputs
	Dim k2alt As Double
	Dim k2pres As Double
	Dim k2spd As Double
	Dim k2temp As Double
	Dim c2temp As Double
	Dim k2angle As Double
	
	Select manager.GetString("altitude")
	Case "ft"
	k2alt = 1
	Case "m"
	k2alt = 0.3048
	Case "km" 
	k2alt = 0.3048 / 1000
	Case "nm" 
	k2alt = 0.3048 / 1852
	Case "mi" 
	k2alt = 0.3048 / 1609.344
	Case "in" 
	k2alt = 0.3048 / 0.0254
	End Select
	
	Select manager.GetString("pressure")
	Case "mbar"
	k2pres = 1/100
	Case "Pa"
	k2pres = 1
	Case "hPa" 
	k2pres = 1/100
	Case "atm" 
	k2pres = 1/101325
	Case "mmHg" 
	k2pres = 0.007500616827042
	Case "psi" 
	k2pres = 0.0001450378911491
	End Select
	
	
	Select manager.GetString("temperature")
	Case "°C"
	k2temp = 1
	c2temp = 0
	Case "°F"
	k2temp = 9/5
	c2temp = 32
	Case "K" 
	k2temp = 1
	c2temp = 273.15
	End Select
	
	Select manager.GetString("speed") 
	Case "kt"
	k2spd = 3600/1852
	Case "m/s"
	k2spd = 1
	Case "km/h" 
	k2spd = 3.6
	Case "mph" 
	k2spd = 2.236936
	Case "ft/s" 
	k2spd = 1/0.3048
	End Select

	Select manager.GetString("angle") 
	Case "deg"
	k2angle = 180/3.14159265358979
	Case "rad"
	k2angle = 1
	End Select

	' Aumentar em uma casa decimal os outputs
	If manager.GetBoolean("outputformat") = True Then
	Dim d As Int
	d = 1
	Else
	d = 0
	End If

	' Escrever Outputs nos Paineis
	Select i
	Case 0
		lblVar.Text = MakeSubscript("Pressure Altitude H", "p", "")
		lblRes.Text = NumberFormat2(Hp_ft * k2alt, 1, 1 + d, 1 + d, False) & " " & manager.GetString("altitude")
		If IsNan(Hp_ft) Or IsInf(Hp_ft) Then
			lblRes.Text = "----"
		End If
	Case 1
		lblVar.Text = MakeSubscript("Geometric Altitude H", "g", "")
		lblRes.Text = NumberFormat2(Hgeom * k2alt, 1, 1 + d, 1 + d, False) & " " & manager.GetString("altitude")
		If IsNan(Hgeom) Or IsInf(Hgeom) Then
			lblRes.Text = "----"
		End If
	Case 2
		lblVar.Text = "Geopotential Altitude"
		lblRes.Text = NumberFormat2(Hgeop * k2alt, 1, 1 + d, 1 + d, False) & " " & manager.GetString("altitude")
		If IsNan(Hgeop) Or IsInf(Hgeop) Then
			lblRes.Text = "----"
		End If
	Case 3
		lblVar.Text = MakeSubscript("Density Altitude H", "ρ", "")
		lblRes.Text = NumberFormat2(Hd * k2alt, 1, 1 + d, 1 + d, False) & " " & manager.GetString("altitude")
		If IsNan(Hd) Or IsInf(Hd) Then
			lblRes.Text = "----"
		End If
	Case 4
		lblVar.Text = MakeSubscript("Temperature Altitude H", "T", "")
		lblRes.Text = NumberFormat2(Htemp * k2alt, 1, 1 + d, 1 + d, False) & " " & manager.GetString("altitude")
		If IsNan(Htemp) Or IsInf(Htemp) Then
			lblRes.Text = "----"
		End If	
	Case 5
		lblVar.Text = "Pressure p"
		lblRes.Text = NumberFormat2(P * k2pres, 1, 2 + d, 2 + d, False) & " " & manager.GetString("pressure")
		If IsNan(P) Or IsInf(P) Then
			lblRes.Text = "----"
		End If
	Case 6
		lblVar.Text = "Density ρ"
		lblRes.Text = NumberFormat2(Rho, 1, 3 + d, 3 + d, False) & " kg/m³"
		If IsNan(Rho) Or IsInf(Rho) Then
			lblRes.Text = "----"
		End If
	Case 7
		lblVar.Text = "Temperature T"
		lblRes.Text = NumberFormat2(T_degC * k2temp + c2temp, 1, 2 + d, 2 + d, False) & " " & manager.GetString("temperature")
		If IsNan(T_degC) Or IsInf(T_degC) Then
			lblRes.Text = "----"
		End If
	Case 8	
		lblVar.Text = "Δ ISA"
		lblRes.Text = NumberFormat2(isa * k2temp, 1, 2 + d, 2 + d, False) & " " & manager.GetString("temperature")
		If IsNan(isa) Or IsInf(isa) Then
			lblRes.Text = "----"
		End If
	Case 9
		lblVar.Text = MakeSubscript("Total Temperature T", "t", "")
		lblRes.Text = NumberFormat2(Ttot_degC * k2temp + c2temp, 1, 2 + d, 2 + d, False) & " " & manager.GetString("temperature")
		If IsNan(Ttot_degC) Or IsInf(Ttot_degC) Then
			lblRes.Text = "----"
		End If
	Case 10
		Dim rs As RichString
		rs.Initialize(NumberFormat2(mu * 100000, 1, 3 + d, 3 + d, False) & " × 10{T}{S}-5{S}{T} kg/m/s")
		rs.Superscript2("{S}")
		rs.RelativeSize2(.7,"{T}")
		lblVar.Text = "Viscosity μ"
		lblRes.Text = rs
		If IsNan(mu) Or IsInf(mu) Then
			lblRes.Text = "----"
		End If
	Case 11
		lblVar.Text = "Sound Speed a"
		lblRes.Text = NumberFormat2(Vsound * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(Vsound) Or IsInf(Vsound) Then
			lblRes.Text = "----"
		End If
	Case 12
		lblVar.Text = "True Airspeed"
		lblRes.Text = NumberFormat2(tas * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(tas) Or IsInf(tas) Then
			lblRes.Text = "----"
		End If
	Case 13
		lblVar.Text = "Calibrated Airspeed"
		lblRes.Text = NumberFormat2(cas * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(cas) Or IsInf(cas) Then
			lblRes.Text = "----"
	End If
	Case 14
		lblVar.Text = "Equivalent Airspeed"
		lblRes.Text = NumberFormat2(eas * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(eas) Or IsInf(eas) Then
			lblRes.Text = "----"
		End If
	Case 15
		lblVar.Text = "Ground Speed"
		lblRes.Text = NumberFormat2(gs * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(gs) Or IsInf(gs) Then
			lblRes.Text = "----"
		End If
	Case 16
		lblVar.Text = MakeSubscript("Stall Speed V", "s", "")
		lblRes.Text = NumberFormat2(Vs_cas * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(Vs_cas) Or IsInf(Vs_cas) Then
			lblRes.Text = "----"
		End If
	Case 17
		lblVar.Text = MakeSubscript("V", "s", " Factor")
		lblRes.Text = NumberFormat2(VsFact, 1, 3 + d, 3 + d, False)
		If IsNan(VsFact) Or IsInf(VsFact) Then
			lblRes.Text = "----"
		End If
	Case 18
		lblVar.Text = MakeSubscript("Lift Coefficient C", "L", "")
		lblRes.Text = NumberFormat2(CL, 1, 3 + d, 3 + d, False)
		If IsNan(CL) Or IsInf(CL) Then
			lblRes.Text = "----"
		End If
	Case 19
		lblVar.Text = "Mach"
		lblRes.Text = NumberFormat2(mach, 1, 3 + d, 3 + d, False)
		If IsNan(mach) Or IsInf(mach) Then
			lblRes.Text = "----"
		End If
	Case 20
		Dim rs1 As RichString
		rs1.Initialize(NumberFormat2(re / 1000000, 1, 2 + d, 2 + d, False) & " × 10{T}{S}6{T}{S}")
		rs1.Superscript2("{S}")
		rs1.RelativeSize2(.7,"{T}")
		lblVar.Text = "Reynolds Re"
		lblRes.Text = rs1
		If IsNan(re) Or IsInf(re) Then
			lblRes.Text = "----"
		End If
	Case 21
		lblVar.Text = "Pressure Ratio δ"
		lblRes.Text = NumberFormat2(P_P0, 1, 3 + d, 3 + d, False)
		If IsNan(P_P0) Or IsInf(P_P0) Then
			lblRes.Text = "----"
		End If
	Case 22
		lblVar.Text = "Density Ratio σ"
		lblRes.Text = NumberFormat2(Rho_Rho0, 1, 3 + d, 3 + d, False)
		If IsNan(Rho_Rho0) Or IsInf(Rho_Rho0) Then
			lblRes.Text = "----"
		End If
	Case 23
		lblVar.Text = "Temperature Ratio θ"
		lblRes.Text = NumberFormat2(T_T0, 1, 3 + d, 3 + d, False)
		If IsNan(T_T0) Or IsInf(T_T0) Then
			lblRes.Text = "----"
		End If
	Case 24
		lblVar.Text = "Dynamic Pressure q"
		lblRes.Text = NumberFormat2(Qd * k2pres, 1, 2 + d, 2 + d, False) & " " & manager.GetString("pressure")
		If IsNan(Qd) Or IsInf(Qd) Then
			lblRes.Text = "----"
		End If
	Case 25
		lblVar.Text = MakeSubscript("Impact Pressure q", "c", "")
		lblRes.Text = NumberFormat2(Qc * k2pres, 1, 2 + d, 2 + d, False) & " " & manager.GetString("pressure")
		If IsNan(Qc) Or IsInf(Qc) Then
			lblRes.Text = "----"
		End If
	Case 26
		lblVar.Text = MakeSubscript("Total Pressure p", "t", "")
		lblRes.Text = NumberFormat2(Ptot * k2pres, 1, 2 + d, 2 + d, False) & " " & manager.GetString("pressure")
		If IsNan(Ptot) Or IsInf(Ptot) Then
			lblRes.Text = "----"
		End If
	Case 27
		lblVar.Text = MakeSubscript("q S / g", "0", "")
		lblRes.Text = NumberFormat2(Qd * Sref / 9.80665, 1, 1 + d, 1 + d, False) & " kgf"
		If IsNan(Qd * Sref / 9.80665) Or IsInf(Qd * Sref / 9.80665) Then
			lblRes.Text = "----"
		End If
	Case 28
		lblVar.Text = "Lift Force"
		lblRes.Text = NumberFormat2(CL * Qd * Sref / 9.80665, 1, 1 + d, 1 + d, False) & " kgf"
		If IsNan(CL * Qd * Sref / 9.80665) Or IsInf(CL * Qd * Sref / 9.80665) Then
			lblRes.Text = "----"
		End If
	Case 29
		lblVar.Text = "Weight / δ"
		lblRes.Text = NumberFormat2(weight / P_P0, 1, 1 + d, 1 + d, False) & " kgf"
		If IsNan(weight / P_P0) Or IsInf(weight / P_P0) Then
			lblRes.Text = "----"
		End If
	Case 30
		lblVar.Text = MakeSubscript("Load Factor N", "z", "")
		lblRes.Text = NumberFormat2(Nz, 1, 2 + d, 2 + d, False) & " g"
		If IsNan(Nz) Or IsInf(Nz) Then
			lblRes.Text = "----"
	End If
	Case 31
		lblVar.Text = "Bank Angle φ"
		lblRes.Text = NumberFormat2(Bank * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle")
		If IsNan(Bank) Or IsInf(Bank) Then
			lblRes.Text = "----"
		End If
	Case 32
		lblVar.Text = "Turn Radius"
		lblRes.Text = NumberFormat2(tas*tas/(9.80665*Tan(Bank)*1000), 1, 3 + d, 3 + d, False) & " km"
		If IsNan(tas*tas/(9.80665*Tan(Bank)*1000)) Or IsInf(tas*tas/(9.80665*Tan(Bank)*1000)) Then
			lblRes.Text = "----"
		End If
	Case 33
		lblVar.Text = "Turn Rate"
		lblRes.Text = NumberFormat2((9.80665*Tan(Bank))/tas * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle") & "/s"
		If IsNan(9.80665*Tan(Bank)/tas) Or IsInf(9.80665*Tan(Bank)/tas) Then
			lblRes.Text = "----"
		End If
	Case 34
		lblVar.Text = "Track Angle"
		lblRes.Text = NumberFormat2(Track * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle")
		If IsNan(Track) Or IsInf(Track) Then
			lblRes.Text = "----"
		End If
	Case 35
		lblVar.Text = "Heading Angle Ψ"
		lblRes.Text = NumberFormat2(Psi * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle")
		If IsNan(Psi) Or IsInf(Psi) Then
			lblRes.Text = "----"
		End If
	Case 36
		lblVar.Text = "Drift Angle"
		lblRes.Text = NumberFormat2((Drift) * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle")
		If IsNan(Drift) Or IsInf(Drift) Then
			lblRes.Text = "----"
		End If
	Case 37
		lblVar.Text = "Sideslip Angle β"
		lblRes.Text = NumberFormat2(Beta * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle")
		If IsNan(Beta) Or IsInf(Beta) Then
			lblRes.Text = "----"
		End If
	Case 38
		lblVar.Text = "Wind Speed"
		lblRes.Text = NumberFormat2(WS * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(WS) Or IsInf(WS) Then
			lblRes.Text = "----"
		End If
	Case 39
		lblVar.Text = "Wind Direction"
		lblRes.Text = NumberFormat2(WD * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle")
		If IsNan(WD) Or IsInf(WD) Then
			lblRes.Text = "----"
		End If
	Case 40
		lblVar.Text = "Along-Track Headwind"
		lblRes.Text = NumberFormat2(HW * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(HW) Or IsInf(HW) Then
			lblRes.Text = "----"
		End If
	Case 41
		lblVar.Text = "Along-Track Crosswind"
		lblRes.Text = NumberFormat2(CW * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(CW) Or IsInf(CW) Then
			lblRes.Text = "----"
		End If
		End Select
End Sub

Sub IsNan(d As Double) As Boolean
   Return d <> d
End Sub

Sub IsInf(d As Double) As Boolean	
	Dim S As String
	S = d
	If S = "Infinity" Then
	Return True
Else
	Return False
End If
End Sub
	
Sub ButtonGradient(ColorList() As Int,ColorList2() As Int) As StateListDrawable
    Dim gdwEnabled As GradientDrawable
    gdwEnabled.Initialize("TOP_BOTTOM", ColorList)
    gdwEnabled.CornerRadius = 4dip
    Dim gdwPressed As GradientDrawable
    gdwPressed.Initialize("BOTTOM_TOP", ColorList2)
    gdwPressed.CornerRadius = 6dip
    Dim gdwDisabled As GradientDrawable
    gdwDisabled.Initialize("TOP_BOTTOM", ColorList)
    gdwDisabled.CornerRadius = 4dip
    Dim stdGradient As StateListDrawable
    stdGradient.Initialize
    stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
    stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
    stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
    Return stdGradient
End Sub

Public Sub EditGradient(BgColor As Int, BorderColor As Int) As ColorDrawable
    Dim cd As ColorDrawable
    cd.Initialize2(BgColor, 4dip, 1dip, BorderColor)
    Return cd
End Sub

Sub ButtonGradient2(ColorList() As Int) As StateListDrawable
    ' Flat tab button with transparent background
    Dim gdwEnabled As GradientDrawable
    gdwEnabled.Initialize("TOP_BOTTOM", Array As Int(ColorList(0), ColorList(0)))
    gdwEnabled.CornerRadius = 8
    Dim gdwPressed As GradientDrawable
    gdwPressed.Initialize("TOP_BOTTOM", Array As Int(ColorList(0), ColorList(0)))
    gdwPressed.CornerRadius = 8
    Dim gdwDisabled As GradientDrawable
    gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.LightGray))
    gdwDisabled.CornerRadius = 8
    Dim stdGradient As StateListDrawable
    stdGradient.Initialize
    stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
    stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
    stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
    Return stdGradient
End Sub

Sub Sensor1_SensorChanged(Values() As Float)
	'Dim pa As PhoneSensors
	pa = Sender
	PressureSensor = Values(0)
	If indAltType = 4 Then
		edtAlt.Text = NumberFormat2(PressureSensor*kPres2,1,3,3,False)
	End If
End Sub

Sub Sensor2_SensorChanged(Values() As Float)
	tmp = Sender
	TempSensor = Values(0)
	If indTempType = 2 Then
		edtTemp.Text = NumberFormat2(TempSensor*kTemp2+cTemp2,1,2,2,False)
	End If
End Sub

Sub GPS_LocationChanged (Location1 As Location)
    GPSspeed =  Location1.Speed
	GPSalt = Location1.Altitude
	If indSpdType = 7 Then
		edtSpd.Text = NumberFormat2(GPSspeed / kSpd,1,1,1,False)
	End If
	If indAltType = 2 Then
		edtAlt.Text = NumberFormat2(GPSalt / kAlt,1,1,1,False)
	End If
End Sub

Sub GPS_UserEnabled (Enabled As Boolean)
    If Enabled = True Then
	ToastMessageShow("GPS enabled.", True)
	End If
End Sub

Sub pnlTransparent_Touch(Action As Int, X As Float, Y As Float) As Boolean	
	Select Action
	Case Activity.ACTION_DOWN
		pnlTransparent.Color = ColorPnlInput2
		PopupMenu.Show
	Case Activity.ACTION_UP
		pnlTransparent.Color = Colors.Transparent
	End Select
	Return True
End Sub

Sub pnlTransparent1_Touch(Action As Int, X As Float, Y As Float) As Boolean
	Select Action
	Case Activity.ACTION_DOWN
		pnlTransparent1.Color = ColorPnlInput2
		Dim phoneV As PhoneVibrate
		Dim HideK As IME
		HideK.Initialize("")
		phoneV.Vibrate(30)
		HideK.HideKeyboard
		StartActivity("Airp")
	Case Activity.ACTION_UP
		pnlTransparent1.Color = Colors.Transparent
	End Select
	Return True
End Sub

Sub AddMenus
    Activity.AddMenuItem("Clear Inputs", "Menu")
	Activity.AddMenuItem("Import Airplanes", "Menu")
	Activity.AddMenuItem("Export Airplanes", "Menu")
	Activity.AddMenuItem("Settings", "Menu")
	Activity.AddMenuItem("Send Feedback", "Menu")
	Activity.AddMenuItem("About", "Menu")
    PopupMenu.AddMenuItem(2, 0, "Clear Inputs")
    PopupMenu.AddMenuItem(3, 1, "Import Airplanes")
    PopupMenu.AddMenuItem(4, 2, "Export Airplanes")
    PopupMenu.AddMenuItem(0, 3, "Settings")
	PopupMenu.AddMenuItem(5, 4, "Send Feedback")
    PopupMenu.AddMenuItem(1, 5, "About")
End Sub

Sub Menu_Click
    Dim menuclicked As String
	Dim MenuItem As Int
    menuclicked = Sender   
    Select menuclicked
    Case "Settings"
		MenuItem=0
	Case "About"
		MenuItem=1
	Case "Clear Inputs"
		MenuItem=2
	Case "Import Airplanes"
		MenuItem=3
	Case "Export Airplanes"
		MenuItem=4
	Case "Send Feedback"
		MenuItem=5
	End Select
	MenuCall (MenuItem)
End Sub

Sub PopupMenu_MenuItemClick(ItemId As Int) As Boolean
    MenuCall (ItemId)
	Return False
End Sub	

Sub MenuCall (MenuItem As Int)  
    Select MenuItem
    Case 0
		OpenSettingsPopup
	Case 1
		Dim pm As PackageManager
			Msgbox2Async(CRLF & "Aero Calculator" & CRLF & CRLF & DateTime.GetYear(DateTime.Now) & " / version " & pm.GetVersionName("flightdyn.aerocalculator") & CRLF & CRLF & "Gustavo José Zambrano" & CRLF & CRLF & "flightdyn@gmail.com" & CRLF, "    About","","","",LoadBitmap(File.DirAssets,"icon_bezel_transp_green.png"),True)
	    Wait For Msgbox_Result (Idx88 As Int)
		Return
	Case 2
		Msgbox2Async("Are you sure you want to clear the inputs?","Warning","Confirm","Cancel","",LoadBitmap(File.DirAssets,"icon_warning.png"),True)
		Wait For Msgbox_Result (confirmclear As Int)
		If confirmclear=DialogResponse.POSITIVE Then
			edtAlt.Text = ""
			edtTemp.Text = ""
			edtSpd.Text = ""
			edtSpdDelta.Text = ""
			edtWeight.Text =  ""
			edtSref.Text =  ""
			edtcref.Text =  ""
			edtCLmax.Text =  "" 
			edtNz.Text = ""
			edtAngle1.Text = ""
			edtAngle2.Text = ""
			edtHeadWind.Text = ""
			edtCrossWind.Text = ""
			edtWindRefAngle.Text = ""
			Dim phoneV As PhoneVibrate
			phoneV.Vibrate(80)
		Else
			Return
		End If

	
	Case 3
		Activity.CloseMenu
		PopupMenu.Dismiss
		Dim cc As ContentChooser
		cc.Initialize("cc")
		cc.Show("text/*", "Choose text file")
		Wait For CC_Result (Success As Boolean, Dir As String, FileName As String)
		'dlgFileExpl.Initialize(Activity, File.DirRootExternal, ".txt", False, False, "OK")
		'dlgFileExpl.Explorer2(False)
		Dim N As Int
		'If Not(dlgFileExpl.Selection.Canceled Or dlgFileExpl.Selection.ChosenFile = "") Then
		If Success Then
			Dim a1 As Map
			Dim N1 As Int
			'a1 = File.ReadMap(dlgFileExpl.Selection.ChosenPath,dlgFileExpl.Selection.ChosenFile)
			a1 = File.ReadMap(Dir,FileName)
			N1 = a1.GetDefault("N",0)
			Try
				'If N1<>0 And (dlgFileExpl.Selection.ChosenPath<>rp.GetSafeDirDefaultExternal("") Or dlgFileExpl.Selection.ChosenFile<>"airplanes.txt") Then
				If N1<>0 Then
					If lst.NumberOfItems>0 Then
						 Msgbox2Async("Add " & N1 & " airplanes to your database?","Importing","Confirm","Cancel","",LoadBitmap(File.DirAssets,"icon_question.png"),True)
						 Wait For Msgbox_Result (cfmover As Int)
					Else
						Dim cfmover As Int
						cfmover=DialogResponse.POSITIVE
					End If
					If cfmover=DialogResponse.POSITIVE Then
						Dim ii,N,He As Int
						He = 50dip
						N = a.GetDefault("N",0)
						For ii= 1 To N1
							a.Put((N+ii) & "_Name", a1.GetDefault((ii) & "_Name",""))
							a.Put((N+ii) & "_S", a1.GetDefault((ii)& "_S",""))
							a.Put((N+ii) & "_c", a1.GetDefault((ii) & "_c",""))
							a.Put((N+ii) & "_W1", a1.GetDefault((ii) & "_W1",""))
							a.Put((N+ii) & "_W2", a1.GetDefault((ii)& "_W2",""))
							a.Put((N+ii) & "_W3", a1.GetDefault((ii) & "_W3",""))
							a.Put((N+ii) & "_W4", a1.GetDefault((ii) & "_W4",""))
							a.Put((N+ii) & "_F0", a1.GetDefault((ii) & "_F0",""))
							a.Put((N+ii) & "_F1", a1.GetDefault((ii) & "_F1",""))
							a.Put((N+ii) & "_F2", a1.GetDefault((ii) & "_F2",""))
							a.Put((N+ii) & "_F3", a1.GetDefault((ii) & "_F3",""))
							a.Put((N+ii) & "_F4", a1.GetDefault((ii) & "_F4",""))
							a.Put((N+ii) & "_F5", a1.GetDefault((ii) & "_F5",""))
							a.Put((N+ii) & "_F6", a1.GetDefault((ii) & "_F6",""))
							a.Put((N+ii) & "_F7", a1.GetDefault((ii) & "_F7",""))
							a.Put((N+ii) & "_F8", a1.GetDefault((ii) & "_F8",""))
							a.Put((N+ii) & "_F9", a1.GetDefault((ii) & "_F9",""))
							a.Put((N+ii) & "_Sunit", a1.GetDefault((ii) & "_Sunit",0))
							a.Put((N+ii) & "_cunit", a1.GetDefault((ii) & "_cunit",0))
							a.Put((N+ii) & "_Wunit", a1.GetDefault((ii) & "_Wunit",0))
							a.Put("N", (N + N1))
							lst.AddCustomItem((N+ii), CreateItem((N+ii), He, (N+ii)), He)
							lst.ResizePanel
							File.WriteMap(rp.GetSafeDirDefaultExternal(""), "airplanes.txt", a)
							spnAirp.Add(a.Get((N+ii) & "_Name"))
							Dim ListAirp As List
							ListAirp.Initialize
							ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems-1)
							File.WriteList(rp.GetSafeDirDefaultExternal(""), "taglist.txt", ListAirp)
							ToastMessageShow(N1 & " Imported Airplanes.", True)
						Next
					End If
				Else
					Msgbox2Async("File importing not successfull", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
					Wait For Msgbox_Result (Idx90 As Int)
					Return
				End If
			Catch
				Msgbox2Async("File importing not successfull", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
				Wait For Msgbox_Result (Idx91 As Int)
				Return
			End Try
		End If
	
	Case 4
		Activity.CloseMenu
		PopupMenu.Dismiss
		dlgFileExpl.Initialize(Activity, File.DirRootExternal, "", False, False, "OK")			
		dlgFileExpl.Explorer2(False)
		If Not(dlgFileExpl.Selection.Canceled Or dlgFileExpl.Selection.ChosenPath = "")  Then
			Try
				Dim inputstring, outputstring As String
				inputstring = dlgFileExpl.Selection.ChosenFile
				If dlgFileExpl.Selection.ChosenFile="" Or dlgFileExpl.Selection.ChosenFile=Null Then
					outputstring = "airplanes.txt"
				Else If inputstring.Contains(".txt") Then
					outputstring = inputstring
				Else
					outputstring = inputstring & ".txt"
				End If
				If File.Exists(rp.GetSafeDirDefaultExternal(""),"airplanes.txt") Then
					File.Copy(rp.GetSafeDirDefaultExternal(""),"airplanes.txt",dlgFileExpl.Selection.ChosenPath,outputstring)
					ToastMessageShow("Exported database to " & outputstring & " file", True)
				Else
					Msgbox2Async("The aircraft database is empty", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
					Wait For Msgbox_Result (Idx92 As Int)
					Return
				End If
				Catch
					Msgbox2Async("File exporting not successfull", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
					Wait For Msgbox_Result (Idx93 As Int)
					Return
				End Try
			End If
	
	Case 5
		Try
	        Msgbox2Async(CRLF & "Choose the means to send feedback:" & CRLF, "Feedback and Bug Report", "Rate app at Playstore","","Feedback by E-mail",LoadBitmap(File.DirAssets,"icon_question.png"),True)
			Wait For Msgbox_Result (opt As Int)
			If opt =DialogResponse.POSITIVE Then
				Dim market As Intent, uri As String
				uri="market://details?id=flightdyn.aerocalculator"
				market.Initialize(market.ACTION_VIEW,uri)
				StartActivity(market)
				ToastMessageShow("Thank you for rating this app!",True)
			End If
			If opt =DialogResponse.NEGATIVE Then
				Dim mailapp As Email
				Dim pm As PackageManager
				Dim ph As Phone 
		   		mailapp.To.Add("flightdyn@gmail.com")
		   		mailapp.Subject = "Feedback - Aerospace Calculator " & pm.GetVersionName("flightdyn.aerocalculator")
		   		mailapp.Body = "App version: " & pm.GetVersionName("flightdyn.aerocalculator") & _
				CRLF & "Phone: " & ph.Manufacturer & " " & ph.Model & _
				CRLF & "Android SDK Version: " & ph.SdkVersion & CRLF & CRLF
				StartActivity(mailapp.GetIntent)
			End If
		Catch
			If opt =DialogResponse.POSITIVE Then
				Msgbox2Async("Could not open Playstore app", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
				Wait For Msgbox_Result (Idx94 As Int)
				Return
			End If
			If opt =DialogResponse.NEGATIVE Then
				Msgbox2Async("Could not open E-mail app", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
				Wait For Msgbox_Result (Idx95 As Int)
				Return
			End If
		End Try
	End Select

End Sub


Sub SetDefaults
    'defaults are only set on the first run.
    manager.SetString("altitude", "ft")
	manager.SetString("pressure", "mbar")
	manager.SetString("temperature", "°C")
	manager.SetString("speed", "kt")
	manager.SetString("angle", "rad")
	manager.SetString("angleformat", "0/360 (0/2π)")
	manager.SetBoolean("outputformat",False)
	manager.SetString("theme", "Green Peace") 
End Sub

Private Sub SetLetterSpacing(v As View, em As Float)
	Try
		Dim jo As JavaObject = v
		jo.RunMethod("setLetterSpacing", Array As Object(em))
	Catch
		Log("Letter spacing skipped: " & LastException.Message)
	End Try
End Sub

Private Sub SetTextLines(v As View, maxLines As Int)
	Dim jo As JavaObject = v
	jo.RunMethod("setMaxLines", Array(maxLines))
	Dim ta As JavaObject
	ta.InitializeStatic("android.text.TextUtils$TruncateAt")
	jo.RunMethod("setEllipsize", Array(ta.GetField("END")))
End Sub

Private Sub MakeSubscript(baseText As String, subText As String, extraText As String) As CSBuilder
	Dim cs As CSBuilder
	cs.Initialize.Append(baseText).VerticalAlign(4dip).RelativeSize(0.68).Append(subText).Pop.Pop.Append(extraText)
	Return cs
End Sub

Public Sub VibrateTap
	Try
		Dim jo As JavaObject = Activity
		jo.RunMethod("performHapticFeedback", Array As Object(3)) ' 3 = KEYBOARD_TAP
	Catch
		Log("VibrateTap: " & LastException.Message)
	End Try
End Sub

Private Sub ModernizeButton(btn As Button)
	Try
		Dim jo As JavaObject = btn
		jo.RunMethod("setAllCaps", Array(False))
		jo.RunMethod("setStateListAnimator", Array(Null))
	Catch
		Log("ModernizeButton skipped: " & LastException.Message)
	End Try
End Sub

Private Sub SettingsAddHeader(parent As Panel, cardW As Int, y As Int, title As String) As Int
	Dim lbl As Label
	lbl.Initialize("")
	lbl.Text = title
	lbl.TextColor = ColorEdtText
	lbl.Typeface = Typeface.DEFAULT_BOLD
	lbl.TextSize = 13
	SetLetterSpacing(lbl, 0.10)
	lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	parent.AddView(lbl, 16dip, y, cardW - 32dip, 30dip)
	Dim ln As Panel
	ln.Initialize("")
	ln.Color = ColorPnlLine2
	parent.AddView(ln, 16dip, y + 32dip, cardW - 32dip, 1dip)
	Return y + 40dip
End Sub

Private Sub SettingsAddRow(parent As Panel, cardW As Int, y As Int, rowH As Int, title As String, subtitle As String, eventName As String) As Button
	Dim lbl As Label
	lbl.Initialize("")
	Dim cs As CSBuilder
	cs.Initialize
	cs.Bold.Append(title).Pop.Append(CRLF).RelativeSize(0.85).Color(ColorEdtHint).Append(subtitle).Pop.Pop
	lbl.Text = cs
	lbl.TextColor = ColorButText1
	lbl.TextSize = 14
	lbl.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	SetTextLines(lbl, 5)
	parent.AddView(lbl, 16dip, y, cardW * 0.55 - 20dip, rowH)
	Dim b As Button
	b.Initialize(eventName)
	b.TextColor = ColorEdtText
	b.Typeface = Typeface.DEFAULT_BOLD
	b.TextSize = 13
	b.SingleLine = True
	b.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2), Array As Int(ColorBut1, ColorPnlTitle))
	parent.AddView(b, cardW * 0.57, y + (rowH - 44dip) / 2, cardW * 0.39, 44dip)
	ModernizeButton(b)
	Return b
End Sub

Private Sub RefreshSettingsButtons
	If Not(SettingsPopupOpen) Then Return
	If btnSettingTheme.IsInitialized Then btnSettingTheme.Text = manager.GetString("theme")
	If btnSettingAltUnit.IsInitialized Then btnSettingAltUnit.Text = manager.GetString("altitude")
	If btnSettingTempUnit.IsInitialized Then btnSettingTempUnit.Text = manager.GetString("temperature")
	If btnSettingSpdUnit.IsInitialized Then btnSettingSpdUnit.Text = manager.GetString("speed")
	If btnSettingAngleUnit.IsInitialized Then btnSettingAngleUnit.Text = manager.GetString("angle")
	If btnSettingAngleFmt.IsInitialized Then
		Dim fmt As String = manager.GetString("angleformat")
		If fmt.Length > 12 Then fmt = fmt.SubString2(0, 12) & "..."
		btnSettingAngleFmt.Text = fmt
	End If
	If btnSettingPressureUnit.IsInitialized Then btnSettingPressureUnit.Text = manager.GetString("pressure")
	If btnSettingFormat.IsInitialized Then
		If manager.GetBoolean("outputformat") Then btnSettingFormat.Text = "+1 decimal"
		If Not(manager.GetBoolean("outputformat")) Then btnSettingFormat.Text = "Standard"
	End If
End Sub

Private Sub OpenSettingsPopup
	If SettingsPopupOpen Then CloseSettingsPopup
	pnlSettingsPopup.Initialize("pnlSettingsPopup")
	pnlSettingsPopup.Color = 0x99000000
	root.AddView(pnlSettingsPopup, 0, 0, root.Width, root.Height)
	SettingsPopupOpen = True
	pnlSettingsPopup.BringToFront

	Dim cardW As Int = root.Width
	Dim cardH As Int = root.Height
	Dim cardLeft As Int = 0
	Dim cardTop As Int = 0
	Dim rowH As Int = 80dip
	Dim hdrH As Int = 40dip
	Dim nRows As Int = 8
	Dim nHdr As Int = 2
	Dim contentH As Int = 10dip + nHdr * hdrH + nRows * rowH + 12dip
	Dim card As Panel
	card.Initialize("")
	card.Color = ColorPnlInput2
	pnlSettingsPopup.AddView(card, cardLeft, cardTop, cardW, cardH)

	' Title bar
	Dim titleBar As Panel
	titleBar.Initialize("")
	titleBar.Color = ColorPnlTitle
	card.AddView(titleBar, 0, 0, cardW, 52dip)
	Dim lblTitle As Label
	lblTitle.Initialize("")
	lblTitle.Text = "SETTINGS"
	lblTitle.TextColor = ColorTitleText
	lblTitle.Typeface = Typeface.DEFAULT_BOLD
	lblTitle.TextSize = 17
	SetLetterSpacing(lblTitle, 0.08)
	lblTitle.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	titleBar.AddView(lblTitle, 16dip, 0, cardW - 72dip, 52dip)
	Dim btnClose As Button
	btnClose.Initialize("btnCloseSettings")
	btnClose.Text = Chr(215) ' x
	btnClose.TextColor = ColorTitleText
	btnClose.TextSize = 20
	btnClose.Color = Colors.Transparent
	titleBar.AddView(btnClose, cardW - 52dip, 2dip, 48dip, 48dip)

	' Scrollable content
	Dim scv As ScrollView
	scv.Initialize(contentH)
	card.AddView(scv, 0, 52dip, cardW, cardH - 52dip)
	Dim y As Int = 10dip

	' --- DISPLAY ---
	y = SettingsAddHeader(scv.Panel, cardW, y, "DISPLAY")
	btnSettingTheme = SettingsAddRow(scv.Panel, cardW, y, rowH, "Theme", "Visual color palette", "btnSettingTheme")
	y = y + rowH

	' --- OUTPUT UNITS ---
	y = SettingsAddHeader(scv.Panel, cardW, y, "OUTPUT UNITS")
	btnSettingAltUnit = SettingsAddRow(scv.Panel, cardW, y, rowH, "Altitude Unit", "Unit for altitude in results", "btnSettingAltUnit")
	y = y + rowH
	btnSettingPressureUnit = SettingsAddRow(scv.Panel, cardW, y, rowH, "Pressure Unit", "Unit for pressure in results", "btnSettingPressureUnit")
	y = y + rowH
	btnSettingTempUnit = SettingsAddRow(scv.Panel, cardW, y, rowH, "Temperature Unit", "Unit for temperature in results", "btnSettingTempUnit")
	y = y + rowH
	btnSettingSpdUnit = SettingsAddRow(scv.Panel, cardW, y, rowH, "Speed Unit", "Unit for speed in results", "btnSettingSpdUnit")
	y = y + rowH
	btnSettingAngleUnit = SettingsAddRow(scv.Panel, cardW, y, rowH, "Angle Unit", "Unit for angles in results", "btnSettingAngleUnit")
	y = y + rowH
	btnSettingAngleFmt = SettingsAddRow(scv.Panel, cardW, y, rowH, "Angle Interval", "Convention for angle range", "btnSettingAngleFmt")
	y = y + rowH
	btnSettingFormat = SettingsAddRow(scv.Panel, cardW, y, rowH, "Number Format", "Decimal places in results", "btnSettingFormat")
	y = y + rowH

	' --- AIRCRAFT DATA ---
	y = SettingsAddHeader(scv.Panel, cardW, y, "AIRCRAFT DATA")
	Dim btnImport As Button = SettingsAddRow(scv.Panel, cardW, y, rowH, "Import Airplanes", "Restore or merge a backup file", "btnSettingImport")
	btnImport.Text = "IMPORT"
	y = y + rowH
	Dim btnExport As Button = SettingsAddRow(scv.Panel, cardW, y, rowH, "Export Airplanes", "Back up all saved aircraft profiles", "btnSettingExport")
	btnExport.Text = "EXPORT"
	y = y + rowH

	scv.Panel.Height = y + 12dip
	RefreshSettingsButtons
End Sub

Private Sub CloseSettingsPopup
	If SettingsPopupOpen Then
		pnlSettingsPopup.RemoveView
		SettingsPopupOpen = False
	End If
End Sub

Sub btnCloseSettings_Click
	CloseSettingsPopup
End Sub

Sub btnSettingTheme_Click
	Dim items As List
	items.Initialize
	items.Add("Green Peace|Teal daylight interface")
	items.Add("Ancient Brown|Warm sepia parchment")
	items.Add("Dark Shadows|Cockpit dark cyan")
	items.Add("Blue Sky|Midnight blue cyan")
	items.Add("Red Alert|Dark crimson alert")
	items.Add("Orange Juice|Cockpit amber warm")
	Dim themes() As String = Array As String("Green Peace","Ancient Brown","Dark Shadows","Blue Sky","Red Alert","Orange Juice")
	Dim current As String = manager.GetString("theme")
	Dim sel As Int = 0
	For ii = 0 To themes.Length-1
		If themes(ii) = current Then sel = ii
	Next
	Wait For (AeroSheet.Show(Activity, items, "Theme", sel)) Complete (idx As Int)
	If idx < 0 Then Return
	If themes(idx) = current Then
		CloseSettingsPopup
		Return
	End If
	manager.SetString("theme", themes(idx))
	CloseSettingsPopup
	RestartActivity
End Sub

Sub btnSettingAltUnit_Click
	Dim items As List
	items.Initialize
	items.Add("ft|Feet — standard aviation")
	items.Add("m|Meters — SI unit")
	items.Add("km|Kilometers")
	items.Add("nm|Nautical miles")
	items.Add("mi|Statute miles")
	items.Add("in|Inches")
	Dim opts() As String = Array As String("ft","m","km","nm","mi","in")
	Dim cur As String = manager.GetString("altitude")
	Dim sel As Int = 0
	For i2 = 0 To opts.Length-1
		If opts(i2) = cur Then sel = i2
	Next
	Wait For (AeroSheet.Show(Activity, items, "Altitude Unit", sel)) Complete (idx As Int)
	If idx < 0 Then Return
	manager.SetString("altitude", opts(idx))
	RefreshSettingsButtons
	ApplyOutputUnits
End Sub

Sub btnSettingPressureUnit_Click
	Dim items As List
	items.Initialize
	items.Add("mbar|Millibar (hPa)")
	items.Add("Pa|Pascal — SI unit")
	items.Add("hPa|Hectopascal")
	items.Add("atm|Standard atmosphere")
	items.Add("mmHg|Millimeters of mercury")
	items.Add("psi|Pounds per square inch")
	Dim opts() As String = Array As String("mbar","Pa","hPa","atm","mmHg","psi")
	Dim cur As String = manager.GetString("pressure")
	Dim sel As Int = 0
	For i2 = 0 To opts.Length-1
		If opts(i2) = cur Then sel = i2
	Next
	Wait For (AeroSheet.Show(Activity, items, "Pressure Unit", sel)) Complete (idx As Int)
	If idx < 0 Then Return
	manager.SetString("pressure", opts(idx))
	RefreshSettingsButtons
	ApplyOutputUnits
End Sub

Sub btnSettingTempUnit_Click
	Dim items As List
	items.Initialize
	Dim opts() As String = Array As String("\u00b0C","\u00b0F","K")
	items.Add(opts(0) & "|Degrees Celsius")
	items.Add(opts(1) & "|Degrees Fahrenheit")
	items.Add(opts(2) & "|Kelvin — absolute")
	Dim cur As String = manager.GetString("temperature")
	Dim sel As Int = 0
	For i2 = 0 To opts.Length-1
		If opts(i2) = cur Then sel = i2
	Next
	Wait For (AeroSheet.Show(Activity, items, "Temperature Unit", sel)) Complete (idx As Int)
	If idx < 0 Then Return
	manager.SetString("temperature", opts(idx))
	RefreshSettingsButtons
	ApplyOutputUnits
End Sub

Sub btnSettingSpdUnit_Click
	Dim items As List
	items.Initialize
	items.Add("kt|Knots — aviation standard")
	items.Add("m/s|Meters per second — SI unit")
	items.Add("km/h|Kilometers per hour")
	items.Add("mph|Miles per hour")
	items.Add("ft/s|Feet per second")
	Dim opts() As String = Array As String("kt","m/s","km/h","mph","ft/s")
	Dim cur As String = manager.GetString("speed")
	Dim sel As Int = 0
	For i2 = 0 To opts.Length-1
		If opts(i2) = cur Then sel = i2
	Next
	Wait For (AeroSheet.Show(Activity, items, "Speed Unit", sel)) Complete (idx As Int)
	If idx < 0 Then Return
	manager.SetString("speed", opts(idx))
	RefreshSettingsButtons
	ApplyOutputUnits
End Sub

Sub btnSettingAngleUnit_Click
	Dim items As List
	items.Initialize
	items.Add("deg|Degrees")
	items.Add("rad|Radians")
	Dim cur As String = manager.GetString("angle")
	Dim sel As Int = 0 : If cur = "rad" Then sel = 1
	Wait For (AeroSheet.Show(Activity, items, "Angle Unit", sel)) Complete (idx As Int)
	If idx < 0 Then Return
	Dim opts() As String = Array As String("deg","rad")
	manager.SetString("angle", opts(idx))
	RefreshSettingsButtons
	ApplyOutputUnits
End Sub

Sub btnSettingAngleFmt_Click
	Dim items As List
	items.Initialize
	items.Add("0/360 (0/2\u03c0)|Positive convention")
	items.Add("-180/180 (-\u03c0/\u03c0)|Signed convention")
	Dim cur As String = manager.GetString("angleformat")
	Dim sel As Int = 0 : If cur.StartsWith("-180") Then sel = 1
	Wait For (AeroSheet.Show(Activity, items, "Angle Interval", sel)) Complete (idx As Int)
	If idx < 0 Then Return
	Dim opts() As String = Array As String("0/360 (0/2\u03c0)","-180/180 (-\u03c0/\u03c0)")
	manager.SetString("angleformat", opts(idx))
	RefreshSettingsButtons
	ApplyOutputUnits
End Sub

Sub btnSettingFormat_Click
	Dim items As List
	items.Initialize
	items.Add("Standard|Default decimal places")
	items.Add("+1 decimal|One extra decimal place in results")
	Dim cur As Boolean = manager.GetBoolean("outputformat")
	Dim sel As Int = 0
	If cur Then sel = 1
	Wait For (AeroSheet.Show(Activity, items, "Number Format", sel)) Complete (idx As Int)
	If idx < 0 Then Return
	manager.SetBoolean("outputformat", idx = 1)
	RefreshSettingsButtons
	ApplyOutputUnits
End Sub

Sub btnSettingImport_Click
	CloseSettingsPopup
	MenuCall(3) ' Reuse existing Import Airplanes logic
End Sub

Sub btnSettingExport_Click
	CloseSettingsPopup
	MenuCall(4) ' Reuse existing Export Airplanes logic
End Sub

Sub pnlSettingsPopup_Click
	' Tapping scrim does NOT close (by design, user must tap X)
End Sub

Private Sub ApplyOutputUnits
	' Trigger recalculation with updated output settings
	Calculate
End Sub

Sub CreatePreferenceScreen
    screen.Initialize("Settings", "")
    'create  categories
    Dim cat1, cat3 As PreferenceCategory
    cat1.Initialize("Output Units and Format")
	cat1.AddList("altitude", "Altitude Unit", "Set desired unit for altitude in outputs", "ft", _
        Array As String("ft", "m", "km", "nm", "mi", "in"))
	cat1.AddList("pressure", "Pressure Unit", "Set desired unit for pressure in outputs", "mbar", _
        Array As String("mbar", "Pa", "hPa", "atm", "mmHg", "psi"))
	cat1.AddList("temperature", "Temperature Unit", "Set desired unit for temperature in outputs", "°C", _
        Array As String("°C", "°F", "K"))	
	cat1.AddList("speed", "Speed Unit", "Set desired unit for speed in outputs", "kt", _
	Array As String("kt", "m/s", "km/h", "mph", "ft/s"))
	cat1.AddList("angle", "Angle Unit", "Set desired unit for angle in outputs", "deg", _
	Array As String("deg", "rad"))
		cat1.AddList("angleformat", "Angle Interval Definition", "Set desired format for angle in outputs", "0/360 (0/2π)", _
	Array As String("0/360 (0/2π)", "-180/180 (-π/π)"))
	cat1.AddCheckBox("outputformat","Output Format","Increase one decimal place",False)

	cat3.Initialize("Interface Options")
	cat3.AddList("theme", "Theme", "Set desired theme", "Green Peace", _
		Array As String("Green Peace", "Ancient Brown", "Dark Shadows","Blue Sky","Red Alert", "Orange Juice"))
    'add the categories to the main screen
    screen.AddPreferenceCategory(cat3)
	screen.AddPreferenceCategory(cat1)
End Sub

Sub edtWeight_TextChanged (Old As String, New As String)
	Dim text As String
	If btnWeight.text.CompareTo("MTOW")=0 Then text = a.GetDefault(ID_inp & "_W1","")
	If btnWeight.text.CompareTo("MLW")=0  Then text = a.GetDefault(ID_inp & "_W2","")
	If btnWeight.text.CompareTo("MZFW")=0  Then text = a.GetDefault(ID_inp & "_W3","")
	If btnWeight.text.CompareTo("BOW")=0  Then text=a.GetDefault(ID_inp & "_W4","")
	If btnWeight.text.CompareTo("Heavy")=0  Then text=a.GetDefault(ID_inp & "_W5","")
	If btnWeight.text.CompareTo("Light")=0  Then text=a.GetDefault(ID_inp & "_W6","")

	If New.CompareTo(text)<>0 Then
		indWeightType = 0
		btnWeight.text  = "Weight"
	End If
End Sub

Sub edtCLmax_TextChanged (Old As String, New As String)
	Dim text As String = ""
	If indCLmaxType > 0 Then
		Dim count As Int = 0
		For ii = 0 To 13
			Dim stored As String = a.GetDefault(ID_inp & "_F" & ii, "")
			If stored.CompareTo("") <> 0 And stored.CompareTo("null") <> 0 Then
				count = count + 1
				If count = indCLmaxType Then
					text = stored
					Exit
				End If
			End If
		Next
	End If
	If New.CompareTo(text) <> 0 Then
		indCLmaxType = 0
		If xx > 340dip Or sc > 1 Then
			btnCLmax.Text = MakeSubscript("Flap 0 - C", "L,max", "")
		Else
			btnCLmax.Text = MakeSubscript("C", "L,max", "")
		End If
	End If
End Sub

