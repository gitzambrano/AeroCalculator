Sub WindType
	Dim pnlv1,pnlv2 As Panel
	If indWindType < 0 Then
	Else If indWindType=0 Or indWindType=1 Then
		If indWindType=0 Then
			scvMain1.Panel.Height = (14 * (ib * 2 + tb) +14dip+3dip)*sc
			pnlv1 = scvMain1.Panel.GetView (24)
			pnlv1.Visible=True
			pnlv2 = scvMain1.Panel.GetView (26)
			pnlv2.Visible=True
			btnHeadWind.Text = "HeadWnd"
			edtHeadWind.Hint = "HeadWind"
			edtWindRefAngle.Hint="Reference Dir."
			btnWindRefAngle.Text = "RwyAngle"
			If xx > 300dip Then
				btnHeadWind.Text = "HeadWind"
			End If
			If xx > 400dip Then
				btnWindRefAngle.Text = "RunwayAngle"
				edtHeadWind.Hint = "HeadWind Speed"
				edtWindRefAngle.Hint="Reference Direction"
			End If
			If sc > 1 Or ld = 1 Then
				btnHeadWind.Text = "HeadWind"
				edtHeadWind.Hint = "HeadWind Speed"
				edtWindRefAngle.Hint="Reference Direction"
				btnWindRefAngle.Text = "Runway Angle"
			End If
			pnlv2.Top =( 13 * (ib*2+tb) + 13*1dip) *sc
			pnlv2.Height = (ib*2+tb) *sc
		Else If indWindType=1 Then
			scvMain1.Panel.Height = (13 * (ib * 2 + tb) + 13dip+3dip)	*sc	
			pnlv1 = scvMain1.Panel.GetView (24)
			pnlv1.Visible=False
			pnlv2 = scvMain1.Panel.GetView (26)
			'pnlv2.Visible = True
			btnHeadWind.Text = "WindSpd"
			edtHeadWind.Hint = "Speed"
			edtWindRefAngle.Hint="Direction"
			btnWindRefAngle.Text = "WindDir"
			If xx > 340dip Then
				btnHeadWind.Text = "Wind Spd"
				edtHeadWind.Hint = "Wind Speed"
				btnWindRefAngle.Text = "Wind Dir"
				edtWindRefAngle.Hint= "Wind Direction"
			End If
			If sc > 1 Or ld = 1 Then
				btnHeadWind.Text = "Wind Speed"
				edtHeadWind.Hint = "Wind Speed"
				edtWindRefAngle.Hint="Wind Direction"
				btnWindRefAngle.Text = "Wind Direction"
			End If
			pnlv2.Top = (12 * (ib*2+tb) + 12*1dip) *sc
			pnlv2.Height = (ib * 2 + tb) *sc
		End If
	End If
End Sub

