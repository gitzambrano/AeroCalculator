Sub btnAirp_Click
	' Vibrar e fechar teclado
	Dim phoneV As PhoneVibrate
	Dim HideK As IME
	HideK.Initialize("")
	phoneV.Vibrate(30)
	HideK.HideKeyboard
	
	' Ir para pagina de Inputs
	pager.GotoPage(0,True)
	
End Sub

Sub btnBack_Click
	' Vibrar e fechar teclado
	Dim phoneV As PhoneVibrate
	Dim HideK As IME
	HideK.Initialize("")	
	phoneV.Vibrate(30)
	HideK.HideKeyboard
	
	' Ir para pagina de Inputs
	pager.GotoPage(1,True)
	
End Sub

Sub btnCalc_Click
	' Vibrar e fechar teclado
	Dim phoneV As PhoneVibrate
	Dim HideK As IME
	HideK.Initialize("")	
    phoneV.Vibrate(30)
	HideK.HideKeyboard
	
	' Ir para pagina de Outputs e fazer Calculos
	pager.GotoPage(2,True)
	Calculate
End Sub

Sub Activity_KeyPress (KeyCode As Int) As Boolean 'Return True to consume the event
    ' Tecla voltar vai para a pagina de Inputs
	If KeyCode = KeyCodes.KEYCODE_BACK And CurrentPage = 2 Then
		pager.GotoPage(1, True)
		Return True 
	Else
	   Return False
	End If
End Sub

Sub Calculate
	
	'Set default units and inputs
	DefaultInputs
	
	'Constantes da Atmosfera Padrao
	Thp=11000
	e=4.2558797  
	Rho0=1.225
	P0=101325
	Vsound0=340.294  
	mu0=0.000017894
	exp=2.71828182846
	
	' Usuario escolheu Altitude Geometrica como Input
	Dim Hgeom_input_m,Hp_input_m,Error,perturb,deriv,relax As Double
	Dim cont As Int
	If indAltType = 1 Or  indAltType = 2 Then
		Hgeom_input_m = AltValue
		Hgeop_m = (6356766/(6356766+Hgeom_input_m))*Hgeom_input_m
		Hgeom = Hgeom_input_m/0.3048
		Error=1
		perturb = 0.001
		relax = 1
		Hp_input_m = Hgeop_m
		deriv = 0
		cont=0
		Do While cont<100 And Abs(Error)>0.001
			Hp_input_m = Hp_input_m - deriv * Error * relax
			deriv = (-CalcError(Hgeop_m,Hp_input_m) + CalcError(Hgeop_m,Hp_input_m+perturb)) / perturb
			Error = CalcError(Hgeop_m,Hp_input_m)
			cont = cont+1	
		Loop	
	End If
	
	' Usuario escolheu Altitude Pressao como Input
	If indAltType = 0 Then
		Hp = AltValue
	Else If indAltType = 1 Or indAltType = 2 Then
		Hp = Hp_input_m
	End If
	
	' Usuario escolheu Altitude Pressao ou Geometrica como Input
	If indAltType = 0 Or indAltType = 1 Or indAltType = 2 Then
		SetStandardAtmosphereFromPressureAltitude(Hp)
		P = P_P0 * P0
	' Usuario escolheu Pressao Atmosferica como Input
	Else If indAltType = 3 Or indAltType = 4 Then
		If indAltType = 3 Then
			P = AltValue
		Else If  indAltType = 4 Then
			P = PressureSensor * kPres
		End If
		Hp = PressureAltitudeFromStaticPressure(P)
		SetStandardAtmosphereFromPressureAltitude(Hp)
	 End If
	 
	' Usuario escolheu Delta ISA
	If indTempType = 0 Then
		isa = TempValue*kTemp
		T_kelvin = T_std + isa
	' Usuario escolheu OAT
	Else
		T_kelvin = TempValue*kTemp + cTemp
		isa = T_kelvin - T_std
	End If
	T_degC = T_kelvin-273.15
	T_T0 = T_kelvin/288.15
	'DhpDh = T_std/(T_std+isa)
	Vsound = Sqrt(T_T0)*Vsound0
	'Rho_std = Rho_Rho0*Rho0
	'Rho = Rho_std/(1+isa/T_std)
	Rho_Rho0=P_P0/T_T0
	Rho=Rho_Rho0*Rho0
	mu = mu0*(Power(T_kelvin,1.5)/(T_kelvin+120)/11.984)
	Hd = 145442.156 * (1-Power((P_P0/T_T0),0.234969))
	
	If indAltType = 0 Or indAltType = 3 Or indAltType = 4 Then
	Hgeop_m = Hp - 29.271247 * isa* Logarithm(P_P0,exp)
	Hgeom = 6356766 * Hgeop_m / (6356766 - Hgeop_m) / 0.3048
	End If
	Hgeop = Hgeop_m/0.3048
	Hp_ft = Hp / 0.3048
	
	If T_kelvin>216.65 Then
		Htemp=11000/0.3048*(288.15-T_kelvin)/71.5
	Else
		Htemp=11000/0.3048
	End If
	
	' Usuario Escolheu Nz como Input
	If indNzType=0 Then
		Nz = NzValue
		Bank = 0
	Else If indNzType = 1 Then
		Nz = NzValue
		Bank = ACos(1/Nz)
	' Usuario Escolheu bank como Input
	Else If indNzType = 2 Then
		Nz = 1 / Cos(NzValue * 3.14159265358979 / 180)
		Bank = NzValue * 3.14159265358979 / 180
	End If
	
	'Calculo de Vs
	Vs_tas = Sqrt(2*weight*9.80665/Rho0/Sref/CLmax)/Sqrt(Rho/Rho0)
	Vs_mach = Vs_tas / Vsound
	Vs_cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((Vs_mach*Vs_mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
	
	' Usuario escolheu TAS como Input
	If indSpdType = 0 Then
		tas = SpdValue
		mach = tas / Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas
	' Usuario escolheu Mach como Input
	Else If indSpdType = 3 Then
		mach = SpdValue
		tas = mach * Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas 
	' Usuario escolheu EAS como Input
	Else If indSpdType = 2 Then
		eas = SpdValue
		tas = eas / Sqrt(Rho/Rho0)
		mach = tas / Vsound
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas
	' Usuario escolheu CL como Input
	Else If indSpdType = 4 Then
		CL = SpdValue
		eas = Sqrt(2*weight*Nz*9.80665/1.225/Sref/CL)
		tas = eas / Sqrt(Rho/Rho0)
		mach = tas / Vsound
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas
	' Usuario escolheu CAS como Input
	Else If indSpdType = 1 Then
		cas = SpdValue
		mach = Sqrt(5*(Power((((Power((((Power((cas/Vsound0),2))/5)+1),3.5)-1)/P_P0)+1),(1/3.5))-1))
		tas = mach * Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		VsFact = cas / Vs_cas
	' Usuario escolheu VS Factor como Input
	Else If indSpdType = 5 Then
		cas = (SpdValue * Vs_cas) + (SpdDelta)
		mach = Sqrt(5*(Power((((Power((((Power((cas/Vsound0),2))/5)+1),3.5)-1)/P_P0)+1),(1/3.5))-1))
		tas = mach * Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight * Nz * 9.80665 / 0.5 / 1.225 / Sref / (eas * eas)
		VsFact = cas / Vs_cas
	' Usuario escolheu Ground Speed do GPS como Input
	Else If indSpdType = 6 Or indSpdType = 7 Then
		gs = SpdValue
		WindCalc
		mach = tas / Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas
	' Usuario escolheu Pressao Dinamica como Input	
	Else If indSpdType = 8  Then
		Qd = SpdValue
		tas = Sqrt(Qd/0.5/Rho)
		mach = tas / Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas
	'Usuario Escolheu Pressao de Impacto como Input	
	Else If indSpdType = 9  Then
		Qc = SpdValue
		mach = Sqrt(5*(Power(((Qc/P)+1),(1/3.5)) - 1))
		tas = mach * Vsound
		eas = tas * Sqrt(Rho/Rho0)
		CL = weight*Nz*9.80665/0.5/1.225/Sref/(eas*eas)
		cas = Vsound0*Sqrt(5*(Power(((P_P0*(Power((((mach*mach)/5)+1),3.5)-1))+1),(1/3.5))-1))
		VsFact = cas / Vs_cas 
	End If
	
	' Outputs Adicionais
	re = Rho * tas * cref / mu
	Qd = 0.5* Rho * tas * tas
	Qc = P * (Power((1+0.2*mach*mach),3.5) -1 )
	Ptot = Qc + P
	Ttot = T_kelvin * (1+0.2*mach*mach)
	Ttot_degC = Ttot - 273.15
	
	' Validade dos Calculos
	If Hp_ft>(84852/0.3048) Then
		Msgbox2Async("Watch out! This app only models the atmosphere up to 84.852 kilometers", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
		Wait For Msbox_Result (Idx103 As Int)
	End If
	
	If indSpdType <> 6 And indSpdType <> 7 Then
		WindCalc
	End If
	
	' Criando Panels de Outputs
	For i=0 To PanelNb1-1
		Dim pnltest As Panel
		Dim pnlline As Panel
		pnltest.Initialize("pnlTest")
		pnlline.Initialize("pnlline")
		scvMain2.Panel.AddView(pnltest, 0, i*PanelHeight1, 100%x, PanelHeight1)
		scvMain2.Panel.AddView(pnlline, 0,(i+1)*PanelHeight1-1dip, 100%x, 1dip)
		pnlline.Color = ColorPnlLine3
	    pnltest.Tag=i
	    If (i Mod 2)=1 Then
	        pnltest.Color=ColorPnlInput3	
	    Else
	        pnltest.Color=ColorPnlInput4	
	    End If	    
		lblVar.Initialize("lblVar")
	    pnltest.AddView(lblVar,5dip, 0dip, 54%x-5dip, PanelHeight1)
	    lblVar.Tag=i
	    lblVar.TextSize=15
		lblVar.TextColor = ColorEdtText
		lblVar.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
	    lblRes.Initialize("lblRes")
	    pnltest.AddView(lblRes,55%x, 0dip, 45%x,PanelHeight1)
	    lblRes.Tag=i
	    lblRes.TextSize=15
		lblRes.TextColor = ColorEdtText
		lblRes.Gravity =  Bit.Or(Gravity.CENTER_VERTICAL, Gravity.LEFT)
		WriteText
	Next

End Sub

Sub DefaultInputs
		' Setar default caso usuario nao preencha campos
	If edtAlt.Text.CompareTo("")=0 Then
		edtAlt.Text = 0
	End If
	If edtTemp.Text.CompareTo("")=0 Then
		edtTemp.Text = 0
	End If
	If edtSpd.Text.CompareTo("")=0 Then
		edtSpd.Text = 0
	End If
	If edtSpdDelta.Text.CompareTo("")=0 Then
		edtSpdDelta.Text = 0
	End If
	If edtWeight.Text.CompareTo("")=0 Then
		edtWeight.Text =  1
	End If
	If edtSref.Text.CompareTo("")=0 Then
		edtSref.Text =  1
	End If
	If edtcref.Text.CompareTo("")=0 Then
		edtcref.Text =  1
	End If
	If edtCLmax.Text.CompareTo("")=0 Then
		edtCLmax.Text =  1 
	End If
	If edtNz.Text.CompareTo("") = 0 Then
		If indNzType=0 Or indNzType=1 Then
			edtNz.Text = 1
		Else If indNzType = 2 Then
			edtNz.Text = 0
		End If
	End If
	If edtAngle1.Text.CompareTo("") = 0 Then
		edtAngle1.Text = 0
	End If
	If edtAngle2.Text.CompareTo("") = 0 Then
		edtAngle2.Text = 0
	End If
	If edtHeadWind.Text.CompareTo("") = 0 Then
		edtHeadWind.Text = 0
	End If
	If edtCrossWind.Text.CompareTo("") = 0 Or indWindType=1 Then
		edtCrossWind.Text = 0
	End If
	If edtWindRefAngle.Text.CompareTo("") = 0 Then
		edtWindRefAngle.Text = 0
	End If
	
	' Transformar para unidades SI
	weight = edtWeight.Text * kWeight
	Sref = edtSref.Text * kSref
	cref = edtcref.Text * kcref
	CLmax = edtCLmax.Text
	If indAltType=0 Or indAltType=1 Or indAltType=2 Then 
		AltValue = edtAlt.Text * kAlt
	Else
		AltValue = edtAlt.Text * kPres
	End If
	TempValue = edtTemp.Text
	If indSpdType=0 Or indSpdType=1 Or indSpdType=2 Or indSpdType=6 Or indSpdType=7 Or indSpdType=8 Or indSpdType=9 Then 
		SpdValue = edtSpd.Text * kSpd
	Else
		SpdValue = edtSpd.Text * 1
	End If
	SpdDelta = edtSpdDelta.Text * 0.51444444
	NzValue = edtNz.Text
	Angle1Value = edtAngle1.Text * KAngle1
	Angle2Value = edtAngle2.Text * KAngle2
	Headwind = edtHeadWind.Text * kSpd1
	CrossWind = edtCrossWind.Text  * kSpd2
	WindRefAngle = edtWindRefAngle.Text  * KAngle3
End Sub

Sub WindCalc
u_wind_inert = -Headwind*Cos(WindRefAngle)+ CrossWind*Sin(WindRefAngle)
v_wind_inert = -CrossWind * Cos(WindRefAngle)  - Headwind * Sin(WindRefAngle)
WS = Sqrt(Headwind * Headwind + CrossWind * CrossWind)
WD = ATan2(v_wind_inert, u_wind_inert)+ 3.14159265358979 
	
If indSpdType = 6 Or indSpdType = 7 Then
	If indAngle1Type = 0 Then
		Track = Angle1Value
		If indAngle2Type = 0 Then
			Beta = Angle2Value 
			u_inert = gs * Cos(Track) 
			v_inert = gs * Sin(Track)
			u_airsp_inert = u_inert - u_wind_inert
			v_airsp_inert = v_inert - v_wind_inert
			Psi = ATan2(v_airsp_inert, u_airsp_inert) - Beta
		Else If indAngle2Type = 1 Then
			Drift = Angle2Value 
			Psi = Track + Drift
			Beta = Track - Psi + ASin(Sin(2 * 3.14159265358979 - WD + 3.14159265358979 - Psi) * WS / gs)	
		End If
	Else If indAngle1Type = 1 Then
		Psi = Angle1Value
		If indAngle2Type = 0 Then
			Beta = Angle2Value 
			Track = Psi + Beta-ASin(Sin(2 * 3.14159265358979 - WD + 3.14159265358979 - Psi) * WS / gs)
		Else If indAngle2Type = 1 Then
			Drift = Angle2Value
			Track = Psi - Drift
			u_inert = gs * Cos(Track) 
			v_inert = gs * Sin(Track)
			u_airsp_inert = u_inert - u_wind_inert
			v_airsp_inert = v_inert - v_wind_inert
			Beta = ATan2(v_airsp_inert, u_airsp_inert) - Psi
		End If
	End If
	tas = (gs + WS * Cos(WD-Track)) / Cos(Psi + Beta-Track)
Else 		
	' Usuario Escolheu Psi como Output
	If indAngle1Type = 1 Then
		Psi = Angle1Value 
		If indAngle2Type = 0 Then
			Beta = Angle2Value 
			u_airsp_inert = tas*Cos(Psi+Beta) 
			v_airsp_inert = tas*Sin(Psi+Beta)	
			u_inert = u_airsp_inert + u_wind_inert
			v_inert = v_airsp_inert + v_wind_inert
			Track = ATan2(v_inert, u_inert) 
		Else If indAngle2Type = 1 Then
			Drift = Angle2Value 
			Track = Psi - Drift
			If ((WS / tas) * Sin(WD-Track)) > 1 Then
				MsgboxAsync("Heading Cannot be flown. Wind too strong!", "Error")
			End If
			Beta = -Drift + ASin((WS / tas) * Sin(WD-Track))
		End If
	' Usuario Escolheu Track como Output
	Else If indAngle1Type = 0 Then
		Track = Angle1Value
		If indAngle2Type = 0 Then
			Beta = Angle2Value
			Psi = Track-Beta + ASin((WS / tas) * Sin(WD-Track))
		Else If indAngle2Type = 1 Then
			Drift = Angle2Value 
			Beta = -Drift + ASin((WS / tas) * Sin(WD-Track))
			Psi = Drift + Track
		End If
	End If
	gs = tas*Cos(Psi+Beta-Track) - WS*Cos(WD-Track)
End If
		
	Drift = Psi - Track
		
	HW = WS * Cos(WD-Track)
	CW = WS * Sin(WD-Track)
	
	If Abs(Drift) < 0.000001 Then Drift = 0
	If Abs(Track) < 0.000001 Then Track = 0
	If Abs(Beta) < 0.000001 Then Beta = 0
	If Abs(Psi) < 0.000001 Then Psi = 0
	If Abs(WS) < 0.000001 Then WS = 0
	If Abs(WD) < 0.000001 Then WD = 0
	If Abs(HW) < 0.000001 Then HW = 0
	If Abs(CW) < 0.000001 Then CW = 0

	Select manager.GetString("angleformat")
	Case "0/360 (0/π)"
		If Track < 0 Then
			Track = 2 * 3.14159265358979323846 + Track
		Else If Track >= (2 * 3.14159265358979323846) Then
			Track = Track - 2 * 3.14159265358979323846 
		End If
		If Psi < 0 Then
			Psi = 2 * 3.14159265358979323846 + Psi
		Else If Psi >= (2 * 3.14159265358979323846) Then
			Psi = Psi - 2 * 3.14159265358979323846
		End If
		If WD < 0 Then
			WD = 2 * 3.14159265358979323846 + WD
		Else If WD >= (2 * 3.14159265358979323846) Then
			WD = WD - 2 * 3.14159265358979323846 
		End If		
	Case "-180/180 (-π/π)"
		If Track < -3.14159265358979323846 Then
			Track = 2 * 3.14159265358979323846 + Track
		Else If Track > 3.14159265358979323846 Then
			Track = Track - 2 * 3.14159265358979323846 
		End If
		If Psi < -3.14159265358979323846 Then
			Psi = 2 * 3.14159265358979323846 + Psi
		Else If Psi > 3.14159265358979323846 Then
			Psi = Psi - 2 * 3.14159265358979323846
		End If
		If WD < -3.14159265358979323846 Then
			WD = 2 * 3.14159265358979323846 + WD
		Else If WD > 3.14159265358979323846 Then
			WD = WD - 2 * 3.14159265358979323846 
		End If
	End Select
		
End Sub

Sub CalcError (Hgeop_input_m As Double, Hp_input_m As Double) As Double
	Dim Error As Double
	SetStandardAtmosphereFromPressureAltitude(Hp_input_m)
	If indTempType = 0 Then
		isa = TempValue*kTemp
		T_kelvin = T_std + isa
	Else
		T_kelvin = TempValue*kTemp + cTemp
		isa = T_kelvin - T_std
	End If
	Error = Hp_input_m - Hgeop_input_m - 29.271247 * isa* Logarithm(P_P0,exp)
	Error = Abs (Error)
	Return Error
End Sub

Sub SetStandardAtmosphereFromPressureAltitude (AltitudeM As Double)
	If AltitudeM<11000 Then
		T_std=288.15-0.0065*AltitudeM
		P_P0=Power(T_std/288.15,5.2558797)
	Else If AltitudeM<20000 Then
		T_std=216.65
		P_P0=0.223360869430*Power(exp,-9.80665*(AltitudeM-11000)/(287.05287*216.65))
	Else If AltitudeM<32000 Then
		T_std=216.65+0.001*(AltitudeM-20000)
		P_P0=0.054032839124*Power(216.65/T_std,34.16320)
	Else If AltitudeM<47000 Then
		T_std=228.65+0.0028*(AltitudeM-32000)
		P_P0=0.008566649658*Power(228.65/T_std,12.20114)
	Else If AltitudeM<51000 Then
		T_std=270.65
		P_P0=0.001094554881*Power(exp,-9.80665*(AltitudeM-47000)/(287.05287*270.65))
	Else If AltitudeM<71000 Then
		T_std=270.65-0.0028*(AltitudeM-51000)
		P_P0=0.000660631908*Power(T_std/270.65,12.20114)
	Else
		T_std=214.65-0.002*(AltitudeM-71000)
		P_P0=0.000039046555*Power(T_std/214.65,17.08160)
	End If
End Sub

Sub PressureAltitudeFromStaticPressure (PressurePa As Double) As Double
	Dim PressureRatio As Double
	Dim LayerTemperature As Double
	Dim Result As Double
	PressureRatio=PressurePa/P0
	If PressureRatio>0.223360869430 Then
		LayerTemperature=288.15*Power(PressureRatio,1/5.2558797)
		Result=(288.15-LayerTemperature)/0.0065
	Else If PressureRatio>0.054032839124 Then
		Result=11000-287.05287*216.65/9.80665*Logarithm(PressureRatio/0.223360869430,exp)
	Else If PressureRatio>0.008566649658 Then
		LayerTemperature=216.65*Power(PressureRatio/0.054032839124,-1/34.16320)
		Result=20000+(LayerTemperature-216.65)/0.001
	Else If PressureRatio>0.001094554881 Then
		LayerTemperature=228.65*Power(PressureRatio/0.008566649658,-1/12.20114)
		Result=32000+(LayerTemperature-228.65)/0.0028
	Else If PressureRatio>0.000660631908 Then
		Result=47000-287.05287*270.65/9.80665*Logarithm(PressureRatio/0.001094554881,exp)
	Else If PressureRatio>0.000039046555 Then
		LayerTemperature=270.65*Power(PressureRatio/0.000660631908,1/12.20114)
		Result=51000+(LayerTemperature-270.65)/-0.0028
	Else
		LayerTemperature=214.65*Power(PressureRatio/0.000039046555,1/17.08160)
		Result=71000+(LayerTemperature-214.65)/-0.002
	End If
	Return Result
End Sub
Sub WriteText
	
	' Capturar Unidades dos Outputs
	Dim k2alt As Double
	Dim k2pres As Double
	Dim k2spd As Double
	Dim k2temp As Double
	Dim c2temp As Double
	Dim k2angle As Double
	
	Select manager.GetString("altitude")
	Case "ft"
	k2alt = 1
	Case "m"
	k2alt = 0.3048
	Case "km" 
	k2alt = 0.3048 / 1000
	Case "nm" 
	k2alt = 0.3048 / 1852
	Case "mi" 
	k2alt = 0.3048 / 1609.344
	Case "in" 
	k2alt = 0.3048 / 0.0254
	End Select
	
	Select manager.GetString("pressure")
	Case "mbar"
	k2pres = 1/100
	Case "Pa"
	k2pres = 1
	Case "hPa" 
	k2pres = 1/100
	Case "atm" 
	k2pres = 1/101325
	Case "mmHg" 
	k2pres = 0.007500616827042
	Case "psi" 
	k2pres = 0.0001450378911491
	End Select
	
	
	Select manager.GetString("temperature")
	Case "°C"
	k2temp = 1
	c2temp = 0
	Case "°F"
	k2temp = 9/5
	c2temp = 32
	Case "K" 
	k2temp = 1
	c2temp = 273.15
	End Select
	
	Select manager.GetString("speed") 
	Case "kt"
	k2spd = 3600/1852
	Case "m/s"
	k2spd = 1
	Case "km/h" 
	k2spd = 3.6
	Case "mph" 
	k2spd = 2.236936
	Case "ft/s" 
	k2spd = 1/0.3048
	End Select

	Select manager.GetString("angle") 
	Case "deg"
	k2angle = 180/3.14159265358979
	Case "rad"
	k2angle = 1
	End Select

	' Aumentar em uma casa decimal os outputs
	If manager.GetBoolean("outputformat") = True Then
	Dim d As Int
	d = 1
	Else
	d = 0
	End If

	' Escrever Outputs nos Paineis
	Select i
	Case 0
		lblVar.Text = "Pressure Altitude"
		lblRes.Text = NumberFormat2(Hp_ft * k2alt, 1, 1 + d, 1 + d, False) & " " & manager.GetString("altitude")
		If IsNan(Hp_ft) Or IsInf(Hp_ft) Then
			lblRes.Text = "----"
		End If
	Case 1
		lblVar.Text = "Geometric Altitude"
		lblRes.Text = NumberFormat2(Hgeom * k2alt, 1, 1 + d, 1 + d, False) & " " & manager.GetString("altitude")
		If IsNan(Hgeom) Or IsInf(Hgeom) Then
			lblRes.Text = "----"
		End If
	Case 2
		lblVar.Text = "Geopotencial Altitude"
		lblRes.Text = NumberFormat2(Hgeop * k2alt, 1, 1 + d, 1 + d, False) & " " & manager.GetString("altitude")
		If IsNan(Hgeop) Or IsInf(Hgeop) Then
			lblRes.Text = "----"
		End If
	Case 3
		lblVar.Text = "Density Altitude"
		lblRes.Text = NumberFormat2(Hd * k2alt, 1, 1 + d, 1 + d, False) & " " & manager.GetString("altitude")
		If IsNan(Hd) Or IsInf(Hd) Then
			lblRes.Text = "----"
		End If
	Case 4
		lblVar.Text = "Temperature Altitude"
		lblRes.Text = NumberFormat2(Htemp * k2alt, 1, 1 + d, 1 + d, False) & " " & manager.GetString("altitude")
		If IsNan(Htemp) Or IsInf(Htemp) Then
			lblRes.Text = "----"
		End If	
	Case 5
		lblVar.Text = "Pressure"
		lblRes.Text = NumberFormat2(P * k2pres, 1, 2 + d, 2 + d, False) & " " & manager.GetString("pressure")
		If IsNan(P) Or IsInf(P) Then
			lblRes.Text = "----"
		End If
	Case 6
		lblVar.Text = "Density"
		lblRes.Text = NumberFormat2(Rho, 1, 3 + d, 3 + d, False) & " kg/m³"
		If IsNan(Rho) Or IsInf(Rho) Then
			lblRes.Text = "----"
		End If
	Case 7
		lblVar.Text = "Temperature"
		lblRes.Text = NumberFormat2(T_degC * k2temp + c2temp, 1, 2 + d, 2 + d, False) & " " & manager.GetString("temperature")
		If IsNan(T_degC) Or IsInf(T_degC) Then
			lblRes.Text = "----"
		End If
	Case 8	
		lblVar.Text = "Delta ISA"
		lblRes.Text = NumberFormat2(isa * k2temp, 1, 2 + d, 2 + d, False) & " " & manager.GetString("temperature")
		If IsNan(isa) Or IsInf(isa) Then
			lblRes.Text = "----"
		End If
	Case 9
		lblVar.Text = "Total Temperature"
		lblRes.Text = NumberFormat2(Ttot_degC * k2temp + c2temp, 1, 2 + d, 2 + d, False) & " " & manager.GetString("temperature")
		If IsNan(Ttot_degC) Or IsInf(Ttot_degC) Then
			lblRes.Text = "----"
		End If
	Case 10
		Dim rs As RichString
		rs.Initialize(NumberFormat2(mu * 100000, 1, 3 + d, 3 + d, False) & " × 10{T}{S}-5{S}{T} kg/m/s")
		rs.Superscript2("{S}")
		rs.RelativeSize2(.7,"{T}")
		lblVar.Text = "Viscosity"
		lblRes.Text = rs
		If IsNan(mu) Or IsInf(mu) Then
			lblRes.Text = "----"
		End If
	Case 11
		lblVar.Text = "Sound Speed"
		lblRes.Text = NumberFormat2(Vsound * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(Vsound) Or IsInf(Vsound) Then
			lblRes.Text = "----"
		End If
	Case 12
		lblVar.Text = "True Airspeed"
		lblRes.Text = NumberFormat2(tas * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(tas) Or IsInf(tas) Then
			lblRes.Text = "----"
		End If
	Case 13
		lblVar.Text = "Calibrated Airspeed"
		lblRes.Text = NumberFormat2(cas * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(cas) Or IsInf(cas) Then
			lblRes.Text = "----"
	End If
	Case 14
		lblVar.Text = "Equivalent Airspeed"
		lblRes.Text = NumberFormat2(eas * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(eas) Or IsInf(eas) Then
			lblRes.Text = "----"
		End If
	Case 15
		lblVar.Text = "Ground Speed"
		lblRes.Text = NumberFormat2(gs * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(gs) Or IsInf(gs) Then
			lblRes.Text = "----"
		End If
	Case 16
		lblVar.Text = "Stall Speed Vs"
		lblRes.Text = NumberFormat2(Vs_cas * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(Vs_cas) Or IsInf(Vs_cas) Then
			lblRes.Text = "----"
		End If
	Case 17
		lblVar.Text = "Vs Factor"
		lblRes.Text = NumberFormat2(VsFact, 1, 3 + d, 3 + d, False)
		If IsNan(VsFact) Or IsInf(VsFact) Then
			lblRes.Text = "----"
		End If
	Case 18
		lblVar.Text = "Lift Coefficient CL"
		lblRes.Text = NumberFormat2(CL, 1, 3 + d, 3 + d, False)
		If IsNan(CL) Or IsInf(CL) Then
			lblRes.Text = "----"
		End If
	Case 19
		lblVar.Text = "Mach"
		lblRes.Text = NumberFormat2(mach, 1, 3 + d, 3 + d, False)
		If IsNan(mach) Or IsInf(mach) Then
			lblRes.Text = "----"
		End If
	Case 20
		Dim rs1 As RichString
		rs1.Initialize(NumberFormat2(re / 1000000, 1, 2 + d, 2 + d, False) & " × 10{T}{S}6{T}{S}")
		rs1.Superscript2("{S}")
		rs1.RelativeSize2(.7,"{T}")
		lblVar.Text = "Reynolds"
		lblRes.Text = rs1
		If IsNan(re) Or IsInf(re) Then
			lblRes.Text = "----"
		End If
	Case 21
		lblVar.Text = "Pressure Ratio δ"
		lblRes.Text = NumberFormat2(P_P0, 1, 3 + d, 3 + d, False)
		If IsNan(P_P0) Or IsInf(P_P0) Then
			lblRes.Text = "----"
		End If
	Case 22
		lblVar.Text = "Density Ratio σ"
		lblRes.Text = NumberFormat2(Rho_Rho0, 1, 3 + d, 3 + d, False)
		If IsNan(Rho_Rho0) Or IsInf(Rho_Rho0) Then
			lblRes.Text = "----"
		End If
	Case 23
		lblVar.Text = "Temperature Ratio θ"
		lblRes.Text = NumberFormat2(T_T0, 1, 3 + d, 3 + d, False)
		If IsNan(T_T0) Or IsInf(T_T0) Then
			lblRes.Text = "----"
		End If
	Case 24
		lblVar.Text = "Dynamic Pressure"
		lblRes.Text = NumberFormat2(Qd * k2pres, 1, 2 + d, 2 + d, False) & " " & manager.GetString("pressure")
		If IsNan(Qd) Or IsInf(Qd) Then
			lblRes.Text = "----"
		End If
	Case 25
		lblVar.Text = "Impact Pressure"
		lblRes.Text = NumberFormat2(Qc * k2pres, 1, 2 + d, 2 + d, False) & " " & manager.GetString("pressure")
		If IsNan(Qc) Or IsInf(Qc) Then
			lblRes.Text = "----"
		End If
	Case 26
		lblVar.Text = "Total Pressure"
		lblRes.Text = NumberFormat2(Ptot * k2pres, 1, 2 + d, 2 + d, False) & " " & manager.GetString("pressure")
		If IsNan(Ptot) Or IsInf(Ptot) Then
			lblRes.Text = "----"
		End If
	Case 27
		lblVar.Text = "DynPressure * S / g"
		lblRes.Text = NumberFormat2(Qd * Sref / 9.80665, 1, 1 + d, 1 + d, False) & " kgf"
		If IsNan(Qd * Sref / 9.80665) Or IsInf(Qd * Sref / 9.80665) Then
			lblRes.Text = "----"
		End If
	Case 28
		lblVar.Text = "Lift Force"
		lblRes.Text = NumberFormat2(CL * Qd * Sref / 9.80665, 1, 1 + d, 1 + d, False) & " kgf"
		If IsNan(CL * Qd * Sref / 9.80665) Or IsInf(CL * Qd * Sref / 9.80665) Then
			lblRes.Text = "----"
		End If
	Case 29
		lblVar.Text = "Weight/Delta W/δ"
		lblRes.Text = NumberFormat2(weight / P_P0, 1, 1 + d, 1 + d, False) & " kgf"
		If IsNan(weight / P_P0) Or IsInf(weight / P_P0) Then
			lblRes.Text = "----"
		End If
	Case 30
		lblVar.Text = "Load Factor Nz"
		lblRes.Text = NumberFormat2(Nz, 1, 2 + d, 2 + d, False) & " g"
		If IsNan(Nz) Or IsInf(Nz) Then
			lblRes.Text = "----"
	End If
	Case 31
		lblVar.Text = "Bank Angle φ"
		lblRes.Text = NumberFormat2(Bank * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle")
		If IsNan(Bank) Or IsInf(Bank) Then
			lblRes.Text = "----"
		End If
	Case 32
		lblVar.Text = "Turn Radius"
		lblRes.Text = NumberFormat2(gs*gs/(9.80665*Tan(Bank)*1000), 1, 3 + d, 3 + d, False) & " Km"
		If IsNan(gs*gs/(9.80665*Tan(Bank)*1000)) Or IsInf(gs*gs/(9.80665*Tan(Bank)*1000)) Then
			lblRes.Text = "----"
		End If
	Case 33
		lblVar.Text = "Turn Rate"
		lblRes.Text = NumberFormat2((9.80665*Tan(Bank))/gs * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle") & "/s"
		If IsNan(9.80665*Tan(Bank)/gs) Or IsInf(9.80665*Tan(Bank)/gs) Then
			lblRes.Text = "----"
		End If
	Case 34
		lblVar.Text = "Track Angle"
		lblRes.Text = NumberFormat2(Track * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle")
		If IsNan(Track) Or IsInf(Track) Then
			lblRes.Text = "----"
		End If
	Case 35
		lblVar.Text = "Heading Angle Ψ"
		lblRes.Text = NumberFormat2(Psi * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle")
		If IsNan(Psi) Or IsInf(Psi) Then
			lblRes.Text = "----"
		End If
	Case 36
		lblVar.Text = "Drift Angle"
		lblRes.Text = NumberFormat2((Drift) * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle")
		If IsNan(Drift) Or IsInf(Drift) Then
			lblRes.Text = "----"
		End If
	Case 37
		lblVar.Text = "Sideslip Angle β"
		lblRes.Text = NumberFormat2(Beta * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle")
		If IsNan(Beta) Or IsInf(Beta) Then
			lblRes.Text = "----"
		End If
	Case 38
		lblVar.Text = "Wind Speed"
		lblRes.Text = NumberFormat2(WS * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(WS) Or IsInf(WS) Then
			lblRes.Text = "----"
		End If
	Case 39
		lblVar.Text = "Wind Direction"
		lblRes.Text = NumberFormat2(WD * k2angle, 1, 2 + d, 2 + d, False) & " " & manager.GetString("angle")
		If IsNan(WD) Or IsInf(WD) Then
			lblRes.Text = "----"
		End If
	Case 40
		lblVar.Text = "AlongTrack Headwind"
		lblRes.Text = NumberFormat2(HW * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(HW) Or IsInf(HW) Then
			lblRes.Text = "----"
		End If
	Case 41
		lblVar.Text = "AlongTrack Crosswind"
		lblRes.Text = NumberFormat2(CW * k2spd, 1, 2 + d, 2 + d, False) & " " & manager.GetString("speed")
		If IsNan(CW) Or IsInf(CW) Then
			lblRes.Text = "----"
		End If
		End Select
End Sub

Sub IsNan(d As Double) As Boolean
   Return d <> d
End Sub

Sub IsInf(d As Double) As Boolean	
	Dim S As String
	S = d
	If S = "Infinity" Then
	Return True
Else
	Return False
End If
End Sub
	
Sub ButtonGradient(ColorList() As Int,ColorList2() As Int) As StateListDrawable
    ' Define a GradientDrawable for Enabled state
    Dim gdwEnabled As GradientDrawable
    gdwEnabled.Initialize("TOP_BOTTOM",ColorList)
    gdwEnabled.CornerRadius = 4
    ' Define a GradientDrawable for Pressed state
    Dim gdwPressed As GradientDrawable
    gdwPressed.Initialize("BOTTOM_TOP",ColorList2)
    gdwPressed.CornerRadius = 6
    ' Define a GradientDrawable for Disabled state
    Dim gdwDisabled As GradientDrawable
    gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.DarkGray))
    gdwDisabled.CornerRadius = 4
    ' Define a StateListDrawable
    Dim stdGradient As StateListDrawable
    stdGradient.Initialize
    stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
    stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
    stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
    Return stdGradient
End Sub

Sub ButtonGradient2(ColorList() As Int) As StateListDrawable
    ' Define a GradientDrawable for Enabled state
    Dim gdwEnabled As GradientDrawable
    gdwEnabled.Initialize("TOP_BOTTOM",ColorList)
    gdwEnabled.CornerRadius = 4
    ' Define a GradientDrawable for Pressed state
    Dim gdwPressed As GradientDrawable
    gdwPressed.Initialize("TOP_BOTTOM",ColorList)
    gdwPressed.CornerRadius = 12
    ' Define a GradientDrawable for Disabled state
    Dim gdwDisabled As GradientDrawable
    gdwDisabled.Initialize("TOP_BOTTOM", Array As Int(Colors.LightGray, Colors.DarkGray))
    gdwDisabled.CornerRadius = 4
    ' Define a StateListDrawable
    Dim stdGradient As StateListDrawable
    stdGradient.Initialize
    stdGradient.AddState2(Array As Int(stdGradient.State_enabled, -stdGradient.State_Pressed), gdwEnabled)
    stdGradient.AddState(stdGradient.State_Pressed, gdwPressed)
    stdGradient.AddState(stdGradient.State_Disabled, gdwDisabled)
    Return stdGradient
End Sub

Sub Sensor1_SensorChanged(Values() As Float)
	'Dim pa As PhoneSensors
	pa = Sender
	PressureSensor = Values(0)
	If indAltType = 4 Then
		edtAlt.Text = NumberFormat2(PressureSensor*kPres2,1,3,3,False)
	End If
End Sub

Sub Sensor2_SensorChanged(Values() As Float)
	tmp = Sender
	TempSensor = Values(0)
	If indTempType = 2 Then
		edtTemp.Text = NumberFormat2(TempSensor*kTemp2+cTemp2,1,2,2,False)
	End If
End Sub

Sub GPS_LocationChanged (Location1 As Location)
    GPSspeed =  Location1.Speed
	GPSalt = Location1.Altitude
	If indSpdType = 7 Then
		edtSpd.Text = NumberFormat2(GPSspeed / kSpd,1,1,1,False)
	End If
	If indAltType = 2 Then
		edtAlt.Text = NumberFormat2(GPSalt / kAlt,1,1,1,False)
	End If
End Sub

Sub GPS_UserEnabled (Enabled As Boolean)
    If Enabled = True Then
	ToastMessageShow("GPS enabled.", True)
	End If
End Sub

Sub pnlTransparent_Touch(Action As Int, X As Float, Y As Float) As Boolean	
	Select Action
	Case Activity.ACTION_DOWN
		pnlTransparent.Color = ColorPnlInput2
	Case Activity.ACTION_UP
		pnlTransparent.Color = Colors.Transparent
	End Select
	PopupMenu.Show
	Return True
End Sub

Sub pnlTransparent1_Touch(Action As Int, X As Float, Y As Float) As Boolean
	Dim phoneV As PhoneVibrate
	Dim HideK As IME
	HideK.Initialize("")
    phoneV.Vibrate(30)
	HideK.HideKeyboard
	
	StartActivity("Airp")
	Select Action
	Case Activity.ACTION_DOWN
		pnlTransparent1.Color = ColorPnlInput2
	Case Activity.ACTION_UP
		pnlTransparent1.Color = Colors.Transparent
	End Select
	Return True
End Sub

Sub AddMenus
    Activity.AddMenuItem("Clear Inputs", "Menu")
	Activity.AddMenuItem("Import Airplanes", "Menu")
	Activity.AddMenuItem("Export Airplanes", "Menu")
	Activity.AddMenuItem("Settings", "Menu")
	Activity.AddMenuItem("Send Feedback", "Menu")
	Activity.AddMenuItem("About", "Menu")
    PopupMenu.AddMenuItem(2, 0, "Clear Inputs")
    PopupMenu.AddMenuItem(3, 1, "Import Airplanes")
    PopupMenu.AddMenuItem(4, 2, "Export Airplanes")
    PopupMenu.AddMenuItem(0, 3, "Settings")
	PopupMenu.AddMenuItem(5, 4, "Send Feedback")
    PopupMenu.AddMenuItem(1, 5, "About")
End Sub

Sub Menu_Click
    Dim menuclicked As String
	Dim MenuItem As Int
    menuclicked = Sender   
    Select menuclicked
    Case "Settings"
		MenuItem=0
	Case "About"
		MenuItem=1
	Case "Clear Inputs"
		MenuItem=2
	Case "Import Airplanes"
		MenuItem=3
	Case "Export Airplanes"
		MenuItem=4
	Case "Send Feedback"
		MenuItem=5
	End Select
	MenuCall (MenuItem)
End Sub

Sub PopupMenu_MenuItemClick(ItemId As Int) As Boolean
    MenuCall (ItemId)
	Return False
End Sub	

Sub MenuCall (MenuItem As Int)  
    Select MenuItem
    Case 0
		StartActivity(screen.CreateIntent)
	Case 1
		Dim pm As PackageManager
			Msgbox2Async(CRLF & "AeroCalculator" & CRLF & CRLF & "2025 / version " & pm.GetVersionName("flightdyn.aerocalculator") & CRLF & CRLF & "Gustavo José Zambrano" & CRLF & CRLF & "flightdyn@gmail.com" & CRLF, "    About","","","",LoadBitmap(File.DirAssets,"icon_bezel_transp_green.png"),True)
	    Wait For Msgbox_Result (Idx88 As Int)
		Return
	Case 2
		Msgbox2Async("Are you sure you want to clear the inputs?","Warning","Confirm","Cancel","",LoadBitmap(File.DirAssets,"icon_warning.png"),True)
		Wait For Msgbox_Result (confirmclear As Int)
		If confirmclear=DialogResponse.POSITIVE Then
			edtAlt.Text = ""
			edtTemp.Text = ""
			edtSpd.Text = ""
			edtSpdDelta.Text = ""
			edtWeight.Text =  ""
			edtSref.Text =  ""
			edtcref.Text =  ""
			edtCLmax.Text =  "" 
			edtNz.Text = ""
			edtAngle1.Text = ""
			edtAngle2.Text = ""
			edtHeadWind.Text = ""
			edtCrossWind.Text = ""
			edtWindRefAngle.Text = ""
			Dim phoneV As PhoneVibrate
			phoneV.Vibrate(80)
		Else
			Return
		End If

	
	Case 3
		Activity.CloseMenu
		PopupMenu.Dismiss
		Dim cc As ContentChooser
		cc.Initialize("cc")
		cc.Show("text/*", "Choose text file")
		Wait For CC_Result (Success As Boolean, Dir As String, FileName As String)
		'dlgFileExpl.Initialize(Activity, File.DirRootExternal, ".txt", False, False, "OK")
		'dlgFileExpl.Explorer2(False)
		Dim N As Int
		'If Not(dlgFileExpl.Selection.Canceled Or dlgFileExpl.Selection.ChosenFile = "") Then
		If Success Then
			Dim a1 As Map
			Dim N1 As Int
			'a1 = File.ReadMap(dlgFileExpl.Selection.ChosenPath,dlgFileExpl.Selection.ChosenFile)
			a1 = File.ReadMap(Dir,FileName)
			N1 = a1.GetDefault("N",0)
			Try
				'If N1<>0 And (dlgFileExpl.Selection.ChosenPath<>rp.GetSafeDirDefaultExternal("") Or dlgFileExpl.Selection.ChosenFile<>"airplanes.txt") Then
				If N1<>0 Then
					If lst.NumberOfItems>0 Then
						 Msgbox2Async("Add " & N1 & " airplanes to your database?","Importing","Confirm","Cancel","",LoadBitmap(File.DirAssets,"icon_question.png"),True)
						 Wait For Msgbox_Result (cfmover As Int)
					Else
						Dim cfmover As Int
						cfmover=DialogResponse.POSITIVE
					End If
					If cfmover=DialogResponse.POSITIVE Then
						Dim ii,N,He As Int
						He = 50dip
						N = a.GetDefault("N",0)
						For ii= 1 To N1
							a.Put((N+ii) & "_Name", a1.GetDefault((ii) & "_Name",""))
							a.Put((N+ii) & "_S", a1.GetDefault((ii)& "_S",""))
							a.Put((N+ii) & "_c", a1.GetDefault((ii) & "_c",""))
							a.Put((N+ii) & "_W1", a1.GetDefault((ii) & "_W1",""))
							a.Put((N+ii) & "_W2", a1.GetDefault((ii)& "_W2",""))
							a.Put((N+ii) & "_W3", a1.GetDefault((ii) & "_W3",""))
							a.Put((N+ii) & "_W4", a1.GetDefault((ii) & "_W4",""))
							a.Put((N+ii) & "_F0", a1.GetDefault((ii) & "_F0",""))
							a.Put((N+ii) & "_F1", a1.GetDefault((ii) & "_F1",""))
							a.Put((N+ii) & "_F2", a1.GetDefault((ii) & "_F2",""))
							a.Put((N+ii) & "_F3", a1.GetDefault((ii) & "_F3",""))
							a.Put((N+ii) & "_F4", a1.GetDefault((ii) & "_F4",""))
							a.Put((N+ii) & "_F5", a1.GetDefault((ii) & "_F5",""))
							a.Put((N+ii) & "_F6", a1.GetDefault((ii) & "_F6",""))
							a.Put((N+ii) & "_F7", a1.GetDefault((ii) & "_F7",""))
							a.Put((N+ii) & "_F8", a1.GetDefault((ii) & "_F8",""))
							a.Put((N+ii) & "_F9", a1.GetDefault((ii) & "_F9",""))
							a.Put((N+ii) & "_Sunit", a1.GetDefault((ii) & "_Sunit",0))
							a.Put((N+ii) & "_cunit", a1.GetDefault((ii) & "_cunit",0))
							a.Put((N+ii) & "_Wunit", a1.GetDefault((ii) & "_Wunit",0))
							a.Put("N", (N + N1))
							lst.AddCustomItem((N+ii), CreateItem((N+ii), He, (N+ii)), He)
							lst.ResizePanel
							File.WriteMap(rp.GetSafeDirDefaultExternal(""), "airplanes.txt", a)
							spnAirp.Add(a.Get((N+ii) & "_Name"))
							Dim ListAirp As List
							ListAirp.Initialize
							ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems-1)
							File.WriteList(rp.GetSafeDirDefaultExternal(""), "taglist.txt", ListAirp)
							ToastMessageShow(N1 & " Imported Airplanes.", True)
						Next
					End If
				Else
					Msgbox2Async("File importing not successfull", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
					Wait For Msgbox_Result (Idx90 As Int)
					Return
				End If
			Catch
				Msgbox2Async("File importing not successfull", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
				Wait For Msgbox_Result (Idx91 As Int)
				Return
			End Try
		End If
	
	Case 4
		Activity.CloseMenu
		PopupMenu.Dismiss
		dlgFileExpl.Initialize(Activity, File.DirRootExternal, "", False, False, "OK")			
		dlgFileExpl.Explorer2(False)
		If Not(dlgFileExpl.Selection.Canceled Or dlgFileExpl.Selection.ChosenPath = "")  Then
			Try
				Dim inputstring, outputstring As String
				inputstring = dlgFileExpl.Selection.ChosenFile
				If dlgFileExpl.Selection.ChosenFile="" Or dlgFileExpl.Selection.ChosenFile=Null Then
					outputstring = "airplanes.txt"
				Else If inputstring.Contains(".txt") Then
					outputstring = inputstring
				Else
					outputstring = inputstring & ".txt"
				End If
				If File.Exists(rp.GetSafeDirDefaultExternal(""),"airplanes.txt") Then
					File.Copy(rp.GetSafeDirDefaultExternal(""),"airplanes.txt",dlgFileExpl.Selection.ChosenPath,outputstring)
					ToastMessageShow("Exported database to " & outputstring & " file", True)
				Else
					Msgbox2Async("The aircraft database is empty", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
					Wait For Msgbox_Result (Idx92 As Int)
					Return
				End If
				Catch
					Msgbox2Async("File exporting not successfull", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
					Wait For Msgbox_Result (Idx93 As Int)
					Return
				End Try
			End If
	
	Case 5
		Try
	        Msgbox2Async(CRLF & "Choose the means to send feedback:" & CRLF, "Feedback and Bug Report", "Rate app at Playstore","","Feedback by E-mail",LoadBitmap(File.DirAssets,"icon_question.png"),True)
			Wait For Msgbox_Result (opt As Int)
			If opt =DialogResponse.POSITIVE Then
				Dim market As Intent, uri As String
				uri="market://details?id=flightdyn.aerocalculator"
				market.Initialize(market.ACTION_VIEW,uri)
				StartActivity(market)
				ToastMessageShow("Thank you for rating this app!",True)
			End If
			If opt =DialogResponse.NEGATIVE Then
				Dim mailapp As Email
				Dim pm As PackageManager
				Dim ph As Phone 
		   		mailapp.To.Add("flightdyn@gmail.com")
		   		mailapp.Subject = "Feedback - Aerospace Calculator " & pm.GetVersionName("flightdyn.aerocalculator")
		   		mailapp.Body = "App version: " & pm.GetVersionName("flightdyn.aerocalculator") & _
				CRLF & "Phone: " & ph.Manufacturer & " " & ph.Model & _
				CRLF & "Android SDK Version: " & ph.SdkVersion & CRLF & CRLF
				StartActivity(mailapp.GetIntent)
			End If
		Catch
			If opt =DialogResponse.POSITIVE Then
				Msgbox2Async("Could not open Playstore app", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
				Wait For Msgbox_Result (Idx94 As Int)
				Return
			End If
			If opt =DialogResponse.NEGATIVE Then
				Msgbox2Async("Could not open E-mail app", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
				Wait For Msgbox_Result (Idx95 As Int)
				Return
			End If
		End Try
	End Select

End Sub


Sub SetDefaults
    'defaults are only set on the first run.
    manager.SetString("altitude", "ft")
	manager.SetString("pressure", "mbar")
	manager.SetString("temperature", "°C")
	manager.SetString("speed", "kt")
	manager.SetString("angle", "rad")
	manager.SetString("angleformat", "0/360 (0/2π)")
	manager.SetBoolean("outputformat",False)
	manager.SetString("theme", "Green Peace") 
End Sub

Sub CreatePreferenceScreen
    screen.Initialize("Settings", "")
    'create  categories
    Dim cat1, cat3 As PreferenceCategory
    cat1.Initialize("Output Units and Format")
	cat1.AddList("altitude", "Altitude Unit", "Set desired unit for altitude in outputs", "ft", _
        Array As String("ft", "m", "km", "nm", "mi", "in"))
	cat1.AddList("pressure", "Pressure Unit", "Set desired unit for pressure in outputs", "mbar", _
        Array As String("mbar", "Pa", "hPa", "atm", "mmHg", "psi"))
	cat1.AddList("temperature", "Temperature Unit", "Set desired unit for temperature in outputs", "°C", _
        Array As String("°C", "°F", "K"))	
	cat1.AddList("speed", "Speed Unit", "Set desired unit for speed in outputs", "kt", _
	Array As String("kt", "m/s", "km/h", "mph", "ft/s"))
	cat1.AddList("angle", "Angle Unit", "Set desired unit for angle in outputs", "deg", _
	Array As String("deg", "rad"))
		cat1.AddList("angleformat", "Angle Interval Definition", "Set desired format for angle in outputs", "0/360 (0/2π)", _
	Array As String("0/360 (0/2π)", "-180/180 (-π/π)"))
	cat1.AddCheckBox("outputformat","Output Format","Increase one decimal place",False)

	cat3.Initialize("Interface Options")
	cat3.AddList("theme", "Theme", "Set desired theme", "Green Peace", _
		Array As String("Green Peace", "Ancient Brown", "Dark Shadows","Blue Sky","Red Alert", "Orange Juice"))
    'add the categories to the main screen
    screen.AddPreferenceCategory(cat3)
	screen.AddPreferenceCategory(cat1)
End Sub

Sub edtWeight_TextChanged (Old As String, New As String)
	Dim text As String
	If btnWeight.text.CompareTo("MTOW")=0 Then text = a.GetDefault(ID_inp & "_W1","")
	If btnWeight.text.CompareTo("MLW")=0  Then text = a.GetDefault(ID_inp & "_W2","")
	If btnWeight.text.CompareTo("MZFW")=0  Then text = a.GetDefault(ID_inp & "_W3","")
	If btnWeight.text.CompareTo("BOW")=0  Then text=a.GetDefault(ID_inp & "_W4","")
	If btnWeight.text.CompareTo("Heavy")=0  Then text=a.GetDefault(ID_inp & "_W5","")
	If btnWeight.text.CompareTo("Light")=0  Then text=a.GetDefault(ID_inp & "_W6","")

	If New.CompareTo(text)<>0 Then
		indWeightType = 0
		btnWeight.text  = "Weight"
	End If
End Sub

Sub edtCLmax_TextChanged (Old As String, New As String)
	Dim text As String
	For ii=0 To 13
		If (btnCLmax.text.CompareTo("CLMAX - " & "F" & ii)=0 Or btnCLmax.text.CompareTo("CLMAX " & "F" & ii)=0) Then text = a.GetDefault(ID_inp & "_F" & ii,"")
	Next
	If New.CompareTo(text)<>0 Then
		indCLmaxType = 0
		Dim rs3 As RichString
		rs3.Initialize("CL{T}MAX{T}")
		rs3.RelativeSize2(.7,"{T}")
		btnCLmax.text  = rs3
	End If
End Sub

