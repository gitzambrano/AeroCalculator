Sub TempUnit_Click
	If indTempUnit < 0 Then
	Else If indTempUnit = 0 Then
		btnTempUnit.Text = "°C"
		kTemp = 1
		cTemp = 273.15
		kTemp2 = 1
		cTemp2= 0
	Else If indTempUnit = 1 Then
		btnTempUnit.Text = "°F"
		kTemp = 5/9
		cTemp = -32 * 5/9 + 273.15
		kTemp2 = 1
		cTemp2 = 273.15
	Else If indTempUnit = 2 Then
		btnTempUnit.Text = "K"
		kTemp = 1
		cTemp = 0
		kTemp2 = 1
		cTemp2 = 273.15
	End If	
End Sub

Sub SpdType_Click
	If indAltType<>2 And indSpdType<>7 Then
		Gps1.Stop
		Ready = False
		GpsCheck = 1
	Else If indSpdType=7 Then
		If GpsCheck2 = 1 Then
			rp.CheckAndRequest(rp.PERMISSION_ACCESS_FINE_LOCATION)
			Wait For Activity_PermissionResult (Permission As String, Result As Boolean)
			GpsCheck2 = 0
			GpsStatus=Result
		End If
		If GpsStatus Then
		    If Gps1.GPSEnabled = False And GpsCheck=1 Then
	            ToastMessageShow("Please enable the GPS device.", True)
		    	StartActivity(Gps1.LocationSettingsIntent) 'Will open the relevant settings screen.
		    	GpsCheck = 0
		    Else If Gps1.GPSEnabled = False And GpsCheck=0 Then
		    	ToastMessageShow("GPS not enabled.", True)
	        End If
		    If Not(Ready) Then
		    	Gps1.Start(100,1)
		    	Ready = True
		    End If
		Else
			ToastMessageShow("Denied location access", True)
		End If
	End If
	If indSpdType < 0 Then
	Else If indSpdType = 0 Then
		btnSpdType.Text = "TAS"
		edtSpd.Hint = "Speed"
		btnSpdUnit.Visible = True
		btnSpdDelta.Visible = False
		edtSpd.Width = 36%x 
		edtSpdDelta.Visible = False
	Else If indSpdType = 1 Then
		btnSpdType.Text = "CAS"
		edtSpd.Hint = "Speed"
		btnSpdUnit.Visible = True
		btnSpdDelta.Visible = False
		edtSpd.Width = 36%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 2 Then
		btnSpdType.Text = "EAS"
		edtSpd.Hint = "Speed"
		btnSpdUnit.Visible = True
		btnSpdDelta.Visible = False
		edtSpd.Width = 36%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 3 Then
		btnSpdType.Text = "Mach"
		If sc > 1 Or ld = 1 Or xx>300dip Then
			edtSpd.Hint = "Mach Number"
		Else
			edtSpd.Hint = "Mach"
		End If
		btnSpdUnit.Visible = False
		btnSpdDelta.Visible = False
		edtSpd.Width = 36%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 4 Then
		edtSpd.Hint = "CL"
		btnSpdType.Text = "CL"
		btnSpdUnit.Visible = False
		btnSpdDelta.Visible = False
		edtSpd.Width = 36%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 5 Then
		btnSpdType.Text = "VsFact"
		edtSpd.Hint = "Fact"
		If sc > 1 Or ld = 1 Then
			btnSpdType.Text = "Vs Factor"
			edtSpd.Hint = "Factor"
		End If
		btnSpdUnit.Visible = False
		btnSpdDelta.Visible = True
		edtSpd.Width = 17%x
		edtSpdDelta.Visible = True
	Else If indSpdType = 6 Then
		btnSpdType.Text = "GrSpd"
		edtSpd.Hint = "Speed"
		If xx > 300dip Then
			btnSpdType.Text = "Grd Spd"
		End If
		If sc > 1 Or ld = 1 Then
			btnSpdType.Text = "Ground Speed"
		End If
		btnSpdUnit.Visible = True
		btnSpdDelta.Visible = False
		edtSpd.Width = 36%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 7 Then
		btnSpdType.Text = "GrSpd"
		If xx > 300dip Then
			btnSpdType.Text = "Grd Spd"
		End If
		If sc > 1 Or ld = 1 Then
			btnSpdType.Text = "Ground Speed"
		End If
		btnSpdUnit.Visible = True
		edtSpd.Text = NumberFormat2(GPSspeed / kSpd, 1, 1, 1, False)
		btnSpdDelta.Visible = False
		edtSpd.Width = 36%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 8 Then
		If sc > 1 Or ld = 1 Or xx>300dip Then
			edtSpd.Hint = "Dyn. Pressure"
		Else
			edtSpd.Hint = "Qdyn"
		End If
		btnSpdType.Text = "Qdyn"
		btnSpdUnit.Visible = True
		btnSpdDelta.Visible = False
		edtSpd.Width = 36%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 9 Then
		If sc > 1 Or ld = 1 Or xx>300dip Then
			edtSpd.Hint = "Imp. Pressure"
		Else
			edtSpd.Hint = "Qc"
		End If
		btnSpdType.Text = "Qc"
		btnSpdUnit.Visible = True
		btnSpdDelta.Visible = False
		edtSpd.Width = 36%x
		edtSpdDelta.Visible = False
	End If
	SpdUnit_Click
End Sub

