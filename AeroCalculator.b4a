Public Sub TintImageView(iv As ImageView, clr As Int)
	Try
		Dim joMe As JavaObject = Me
		joMe.RunMethod("tintImageView", Array(iv, clr))
	Catch
		Log("TintImageView: " & LastException.Message)
	End Try
End Sub

Public Sub RestartActivity
	Try
		Dim joMe As JavaObject = Me
		joMe.RunMethod("restartActivity", Null)
	Catch
		Log("RestartActivity: " & LastException.Message)
	End Try
End Sub

Public Sub ConfigureAirplaneSpinner(spn As Spinner)
	Try
		Dim joMe As JavaObject = Me
		joMe.RunMethod("configureAirplaneSpinner", Array(spn))
	Catch
		Log("ConfigureAirplaneSpinner: " & LastException.Message)
	End Try
End Sub

#If Java
public static void restartActivity() {
    try {
        if (mostCurrent != null) {
            mostCurrent.recreate();
        }
    } catch (Exception e) {
        android.util.Log.e("AERO_RESTART", "restartActivity error: " + e.getMessage(), e);
    }
}

public static void configureAirplaneSpinner(Object spnObj) {
    try {
        if (spnObj instanceof anywheresoftware.b4a.objects.SpinnerWrapper) {
            final android.widget.Spinner spn = (android.widget.Spinner) ((anywheresoftware.b4a.objects.SpinnerWrapper)spnObj).getObject();
            spn.setBackground(null);
            spn.setOnHierarchyChangeListener(new android.view.ViewGroup.OnHierarchyChangeListener() {
                @Override
                public void onChildViewAdded(android.view.View parent, android.view.View child) {
                    if (child instanceof android.widget.TextView) {
                        ((android.widget.TextView) child).setGravity(android.view.Gravity.CENTER);
                    }
                }
                @Override
                public void onChildViewRemoved(android.view.View parent, android.view.View child) {}
            });
            android.view.View selected = spn.getSelectedView();
            if (selected instanceof android.widget.TextView) {
                ((android.widget.TextView) selected).setGravity(android.view.Gravity.CENTER);
            }
        }
    } catch (Exception e) {
        android.util.Log.e("AERO_SPN", "configureAirplaneSpinner error: " + e.getMessage(), e);
    }
}

public static void tintImageView(Object ivObj, int color) {
    try {
        if (ivObj instanceof anywheresoftware.b4a.objects.ImageViewWrapper) {
            ivObj = ((anywheresoftware.b4a.objects.ImageViewWrapper)ivObj).getObject();
        }
        if (ivObj instanceof android.view.View) {
            android.view.View v = (android.view.View) ivObj;
            android.graphics.PorterDuffColorFilter filter = new android.graphics.PorterDuffColorFilter(color, android.graphics.PorterDuff.Mode.SRC_IN);
            if (v.getBackground() != null) {
                v.getBackground().setColorFilter(filter);
            }
            if (v instanceof android.widget.ImageView) {
                android.widget.ImageView iv = (android.widget.ImageView) v;
                if (iv.getDrawable() != null) {
                    iv.getDrawable().setColorFilter(filter);
                }
                iv.setColorFilter(filter);
            }
            v.invalidate();
            android.util.Log.i("AERO_TINT", "TintImageView success with color: " + color + " bg=" + (v.getBackground() != null));
        } else {
            android.util.Log.e("AERO_TINT", "ivObj is not a View: " + ivObj);
        }
    } catch (Exception e) {
        android.util.Log.e("AERO_TINT", "Tint error: " + e.getMessage(), e);
    }
}
#End If


