			btnCrossWind.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2),Array As Int(ColorBut1, ColorPnlTitle))
			edtCrossWind.Initialize("edtCrossWind")
		    pnlInput.AddView(edtCrossWind, 50%x, ib*sc, 27%x, tb*sc)
			edtCrossWind.Hint = "CrossWind"
			If sc > 1 Or ld = 1 Or xx>340dip Then
				edtCrossWind.Hint = "CrossWind Speed"	
			End If
			edtCrossWind.Gravity = Gravity.CENTER
			edtCrossWind.TextSize = 13*sc
			edtCrossWind.InputType = edtCrossWind.INPUT_TYPE_DECIMAL_NUMBERS
			edtCrossWind.ForceDoneButton = True
			filter.SetCustomFilter(edtCrossWind, edtCrossWind.INPUT_TYPE_DECIMAL_NUMBERS, "0123456789.-")
	        btnCrossWindUnit.Initialize("btnCrossWindUnit")
			btnCrossWindUnit.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2),Array As Int(ColorBut1, ColorPnlTitle))
		    pnlInput.AddView(btnCrossWindUnit, 80%x, ib*sc, 17%x, tb*sc)
		    btnCrossWindUnit.Text="kt"
			btnCrossWindUnit.TextSize = 15*sc
			edtCrossWind.TextColor = ColorEdtText
			edtCrossWind.Background = EditGradient(ColorEdt, ColorPnlLine2)
			edtCrossWind.HintColor = ColorEdtHint
			edtCrossWind.Typeface = Typeface.DEFAULT_BOLD
			btnCrossWind.TextColor = ColorButText1
			btnCrossWindUnit.TextColor = ColorButText1
			'SetNinePatchButton2(edtCrossWind, "apptheme_textfield_default_holo_light","","", "apptheme_textfield_activated_holo_light","")
	    Case 13
		    btnWindRefAngle.Initialize("btnWindRefAngle")
		    pnlInput.AddView(btnWindRefAngle, 3%x, ib*sc, 44%x, tb*sc)
			If xx > 400dip Or sc > 1 Or ld = 1 Then
				btnWindRefAngle.Text = "Runway Angle"
			Else
				btnWindRefAngle.Text = "Rnwy Angle"
			End If
			btnWindRefAngle.TextSize = 15*sc
			btnWindRefAngle.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2),Array As Int(ColorBut1, ColorPnlTitle))
			edtWindRefAngle.Initialize("edtWindRefAngle")
		    pnlInput.AddView(edtWindRefAngle, 50%x, ib*sc, 27%x, tb*sc)
			edtWindRefAngle.Hint="Reference Dir"
			If sc > 1 Or ld = 1 Or xx>400dip Then
				edtWindRefAngle.Hint="Reference Direction"	
			End If
			edtWindRefAngle.Gravity = Gravity.CENTER
			edtWindRefAngle.TextSize = 13*sc
			edtWindRefAngle.InputType = edtWindRefAngle.INPUT_TYPE_DECIMAL_NUMBERS
			edtWindRefAngle.ForceDoneButton = True
			filter.SetCustomFilter(edtWindRefAngle, edtWindRefAngle.INPUT_TYPE_DECIMAL_NUMBERS, "0123456789.-")
	        btnWindRefAngleUnit.Initialize("btnWindRefAngleUnit")
			btnWindRefAngleUnit.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2),Array As Int(ColorBut1, ColorPnlTitle))
		    pnlInput.AddView(btnWindRefAngleUnit, 80%x, ib*sc, 17%x, tb*sc)
		    btnWindRefAngleUnit.Text="deg"
			btnWindRefAngleUnit.TextSize = 15*sc
			edtWindRefAngle.TextColor = ColorEdtText
			edtWindRefAngle.Background = EditGradient(ColorEdt, ColorPnlLine2)
			edtWindRefAngle.HintColor = ColorEdtHint
			edtWindRefAngle.Typeface = Typeface.DEFAULT_BOLD
			btnWindRefAngle.TextColor = ColorButText1
			btnWindRefAngleUnit.TextColor = ColorButText1
			'SetNinePatchButton2(edtWindRefAngle, "apptheme_textfield_default_holo_light","","", "apptheme_textfield_activated_holo_light","")
		End Select
	Next

	scvMain1.Panel.Height = (PanelNb * (ib*2+tb) + PanelNb* 1dip + 3dip)*sc
	container.AddPage(pnlBack1,"Inputs")

' Criando pagina de outputs
	PanelNb1 = 42
	PanelHeight1 = 40dip

	pnlBack2.Initialize("")
	pnlBack2.Color = ColorPnlInput5
	scvMain2.Initialize(500)
    pnlBack2.AddView(scvMain2, 0, 0, root.Width, root.Height-HeaderHeight)
	scvMain2.Panel.Height = PanelNb1 * PanelHeight1 + 3dip

	container.AddPage(pnlBack2, "Outputs")

' Criando painel superior e botoes
	Dim pnltitle As Panel 
	pnltitle.Initialize("pnltitle")
	root.AddView(pnltitle, 0, 0, root.Width, HeaderHeight)
	pnltitle.Color = ColorPnlTitle

	Dim img1 As ImageView
	Dim bmpImage1 As Bitmap
	Dim bmpImage2 As Bitmap
	Dim bmpImage3 As Bitmap
	bmpImage1.Initialize(File.DirAssets,"icon_bezel_transp_white.png")
	img1.Initialize("img1")
	img1.Bitmap = bmpImage1
	img1.Gravity=Gravity.FILL
	Dim iconSize As Int = 38dip * sc
	If ld = 1 Then iconSize = 28dip
	Dim iconTop As Int = (HeaderTopH - iconSize) / 2
	pnltitle.AddView(img1, 4%x, iconTop, iconSize, iconSize)
	
	Dim menuW As Int = 3%x + (32dip * sc)
	pnlTransparent.Initialize("pnlTransparent")
	pnlTransparent.Color =  Colors.Transparent
	pnltitle.AddView(pnlTransparent, 100%x - menuW, 0, menuW, HeaderTopH)
	bmpImage2.Initialize(File.DirAssets,"android-3-dot-menu.png")
	img2.Initialize("img2")
	img2.Bitmap = bmpImage2
	img2.Gravity = Gravity.FILL
	Dim actionIconTop As Int = (HeaderTopH - 22dip * sc) / 2
	pnlTransparent.AddView(img2, 0, actionIconTop, 22dip * sc, 22dip * sc)
	img2.Left = (pnlTransparent.Width - img2.Width) / 2

	pnlTransparent1.Initialize("pnlTransparent1")
	pnlTransparent1.Color =  Colors.Transparent
	pnltitle.AddView(pnlTransparent1, pnlTransparent.Left - menuW, 0, menuW, HeaderTopH)
	bmpImage3.Initialize(File.DirAssets,"icon_plus_white.png")
	img3.Initialize("img3")
	img3.Bitmap = bmpImage3
	img3.Gravity = Gravity.FILL
	pnlTransparent1.AddView(img3, 0, actionIconTop, 22dip * sc, 22dip * sc)
	img3.Left = (pnlTransparent1.Width - img3.Width) / 2

	Dim titleLeft As Int = 4%x + iconSize + 10dip * sc
	Dim titleW As Int = pnlTransparent1.Left - titleLeft - 4dip
	Dim lbl1 As Label
	lbl1.Initialize("lbl1")
	Dim titleSize As Float = 20 * sc
	If titleSize > 21.5 Then titleSize = 21.5
	If titleW < 170dip Then titleSize = 18
	If root.Width <= 340dip Then titleSize = 18
	lbl1.TextSize = titleSize
	lbl1.TextColor = ColorTitleText
	lbl1.Gravity = Gravity.CENTER_VERTICAL
	lbl1.SingleLine = True
	lbl1.Text = "Aero Calculator"
	lbl1.Typeface = Typeface.LoadFromAssets("Xenara-Bold.ttf")
	pnltitle.AddView(lbl1, titleLeft, 0, titleW, HeaderTopH)
	pnlTransparent.BringToFront
	pnlTransparent1.BringToFront

	btnAirp.Initialize("btnAirp")
	pnltitle.AddView(btnAirp, 0, HeaderTabsY, 33.33333333%x, HeaderTabsH)
	btnAirp.Text = "AIRPLANES"
	btnAirp.TextSize = 13 * sc
	btnAirp.Typeface = Typeface.DEFAULT_BOLD
	btnAirp.Background = ButtonGradient2(Array As Int(ColorBut3, ColorBut4))
	btnAirp.TextColor = ColorButText2
	btnAirp.Gravity = Gravity.CENTER
	btnAirp.Padding = Array As Int (0, 0, 0, 7dip * sc)
	btnAirp.SendToBack

	btnBack.Initialize("btnBack")
	pnltitle.AddView(btnBack, 33.33333333%x, HeaderTabsY, 33.33334%x, HeaderTabsH)
	btnBack.Text = "INPUTS"
	btnBack.TextSize = 13 * sc
	btnBack.Typeface = Typeface.DEFAULT_BOLD
	btnBack.Background = ButtonGradient2(Array As Int(ColorBut3, ColorBut4))
	btnBack.TextColor = ColorButText2
	btnBack.Gravity = Gravity.CENTER
	btnBack.Padding = Array As Int (0, 0, 0, 7dip * sc)
	btnBack.SendToBack

	btnCalc.Initialize("btnCalc")
	pnltitle.AddView(btnCalc, 66.666666666%x, HeaderTabsY, 33.33333333%x, HeaderTabsH)
	btnCalc.Text = "CALCULATE"
	btnCalc.TextSize = 13 * sc
	btnCalc.Typeface = Typeface.DEFAULT_BOLD
	btnCalc.Background = ButtonGradient2(Array As Int(ColorBut3, ColorBut4))
	btnCalc.TextColor = ColorButText2
	btnCalc.Gravity = Gravity.CENTER
	btnCalc.Padding = Array As Int (0, 0, 0, 7dip * sc)
	btnCalc.SendToBack
	
	'Linha divisoria de titulo para o scrollview
	Dim line2 As Panel
	line2.Initialize("line2")
	pnltitle.AddView(line2, 0%x, HeaderHeight - 1dip * sc, 100%x, 1dip * sc)
	line2.Color = ColorPnlLine2
	line2.Elevation = 5dip

	'Now we have a container with our panels just add it to the pager object
	pager.Initialize2(container,"pager")
	
	' Criando linha marcadora de pagina
	line.Initialize("line")
	pnltitle.AddView(line, 0%x, HeaderHeight - 4dip * sc, 33.33333333%x, 4dip * sc)
	line.Color = ColorPnlLine
	line.Elevation = 5dip

	'Now we can add the pager to the activity
	root.AddView(pager, 0, HeaderHeight, root.Width, root.Height - HeaderHeight)
	
	'Adicionando menus
	Dim pnlT As Panel
	pnlT.Initialize("pnlT")
	pnlT.Color =  Colors.Transparent
	root.AddView(pnlT, 90%x, 0, 9%x, HeaderTopH)
	PopupMenu.Initialize("PopupMenu", pnlT)
	AddMenus

	AeroSheet.Initialize(Me, "AeroSheet")
	AeroSheet.SetColors(ColorEdtText, ColorPnlInput2, ColorButText1, ColorEdtText, ColorPnlLine2)
	SettingsPopupOpen = False

	Dim allButtons() As Button = Array As Button(btnAirp, btnBack, btnCalc, btnAirplane, _
		btnAltType, btnAltUnit, btnTempType, btnTempUnit, btnSpdType, btnSpdUnit, _
		btnWeight, btnWeightUnit, btnSref, btnSrefUnit, btncref, btncrefUnit, _
		btnCLmax, btnCLmaxUnit, btnNzType, btnNzUnit, btnAngle1Type, btnAngle1Unit, _
		btnAngle2Type, btnAngle2Unit, btnHeadWind, btnHeadWindUnit, btnCrossWind, btnCrossWindUnit, _
		btnWindRefAngle, btnWindRefAngleUnit, btnSpdDelta)
	For Each b As Button In allButtons
		If b.IsInitialized Then ModernizeButton(b)
	Next
End Sub

Sub Activity_Resume
	
	If manager.GetUpdatedKeys.Size>0 Then
		Dim phn As Phone
		phn.SetScreenOrientation(0)
		phn.SetScreenOrientation(1)
		phn.SetScreenOrientation(-1)
	End If
	
	pnlTransparent1.Color =  Colors.Transparent
	
	Dim HideK As IME
	HideK.Initialize("")
	HideK.HideKeyboard
	
	Dim in As Intent = Activity.GetStartingIntent
	If in.IsInitialized Then
		If in.HasExtra("theme") Then
			Dim reqTheme As String = "" & in.GetExtra("theme")
			If reqTheme <> "" And reqTheme <> manager.GetString("theme") Then
				manager.SetString("theme", reqTheme)
				Activity.RemoveAllViews
				Activity_Create(False)
				Return
			End If
		End If
		If in.HasExtra("tab") Then
			Dim reqTab As Int = in.GetExtra("tab")
			If reqTab = 0 Then
				btnAirp_Click
			Else If reqTab = 1 Then
				btnBack_Click
			Else If reqTab = 2 Then
				btnCalc_Click
			End If
		End If
	End If
	
	' Recupera variaveis do arquivo interno lastmod.txt
	Dim m As Map
	m.Initialize
	If File.Exists(File.DirInternal, "lastmod.txt") Then
		m = File.ReadMap(File.DirInternal,"lastmod.txt")
		edtAlt.Text = m.GetDefault("var0","")
		edtTemp.Text = m.GetDefault("var1","")
		edtSpd.Text = m.GetDefault("var2","")
		edtWeight.Text = m.GetDefault("var3","")
		edtSref.Text = m.GetDefault("var4","")
		edtcref.Text = m.GetDefault("var5","")
		edtCLmax.Text = m.GetDefault("var6","")
		edtNz.Text = m.GetDefault("var7","")
		edtAngle1.Text = m.GetDefault("var8","")
		edtAngle2.Text = m.GetDefault("var9","")
		edtHeadWind.Text = m.GetDefault("var10","")
		edtCrossWind.Text = m.GetDefault("var11","")
		edtWindRefAngle.Text = m.GetDefault("var12","")
		indAltType = m.GetDefault("var13",0)
		indAltUnit = m.GetDefault("var14",0)
		indTempType = m.GetDefault("var15",0)
		indAltUnit = m.GetDefault("var16",0)
		indSpdType = m.GetDefault("var17",0)
	 	indSpdUnit = m.GetDefault("var18",0)
		indWeightUnit = m.GetDefault("var19",0)
	 	indSrefUnit = m.GetDefault("var20",0)
		indcrefUnit = m.GetDefault("var21",0)
		indNzType = m.GetDefault("var22",0)
		indAngle1Type = m.GetDefault("var23",0)
		indAngle1Unit = m.GetDefault("var24",0)
		indAngle2Type = m.GetDefault("var25",0)
		indAngle2Unit = m.GetDefault("var26",0)		
		indHeadWindUnit = m.GetDefault("var27",0)
		indCrossWindUnit = m.GetDefault("var28",0)
		indWindRefAngleUnit = m.GetDefault("var29",0)
		edtSpdDelta.Text = m.GetDefault("var30","")
		indWindType = m.GetDefault("var31",0)
		spinnerPos = m.GetDefault("var32", 0)
		indWeightType = m.GetDefault("var33", 0)
		indCLmaxType = m.GetDefault("var34", 0)
		' Inicializacoes
		AltType_Click
		AltUnit_Click
		TempType_Click
		TempUnit_Click
		SpdType_Click
	 	SpdUnit_Click
		WeightUnit_Click
	 	SrefUnit_Click
		crefUnit_Click
		NzType_Click
		Angle1Type_Click
		Angle1Unit_Click
		Angle2Type_Click
		Angle2Unit_Click
		WindType
		HeadWindUnit_Click
		CrossWindUnit_Click
		WindRefAngleUnit_Click
	End If	

	'Go to default page
	If Airp.add=1 Or ID_edt>0 Then
	pager.GotoPage(0, False)
	Else
	pager.GotoPage(CurrentPage, False)
	End If
	
	' Descobrir se estamos em modo Landscape ou Portrait
	If root.Width > root.Height Then
		ld = 1
	Else
		ld = 0
	End If
	
	' Populando lista de avioes
	Dim N As Int
	a.Initialize
	If File.Exists(rp.GetSafeDirDefaultExternal(""), "airplanes.txt") Then
		a = File.ReadMap(rp.GetSafeDirDefaultExternal(""), "airplanes.txt")
		N = a.GetDefault("N", 0)
	Else
		N = 0
	End If
	If N = 0 Then
		N = 2
		a.Put("N", 2)
		a.Put("1_Name", "Boeing 737-800")
		a.Put("1_S", "124.6")
		a.Put("1_c", "4.17")
		a.Put("1_Sunit", 0)
		a.Put("1_cunit", 0)
		a.Put("1_Wunit", 0)
		a.Put("1_W1", "79015")
		a.Put("1_W2", "66361")
		a.Put("1_W3", "62731")
		a.Put("1_W4", "41413")
		a.Put("1_F0", "1.8")
		a.Put("1_F1", "1.9")
		a.Put("1_F2", "2.0")
		a.Put("1_F3", "2.2")
		
		a.Put("2_Name", "Airbus A320-200")
		a.Put("2_S", "122.6")
		a.Put("2_c", "4.19")
		a.Put("2_Sunit", 0)
		a.Put("2_cunit", 0)
		a.Put("2_Wunit", 0)
		a.Put("2_W1", "78000")
		a.Put("2_W2", "66000")
		a.Put("2_W3", "62500")
		a.Put("2_W4", "42600")
		a.Put("2_F0", "1.75")
		a.Put("2_F1", "1.85")
		a.Put("2_F2", "2.1")
		a.Put("2_F3", "2.3")
		File.WriteMap(rp.GetSafeDirDefaultExternal(""), "airplanes.txt", a)
		Dim tagL As List: tagL.Initialize
		tagL.Add(1): tagL.Add(2)
		File.WriteList(rp.GetSafeDirDefaultExternal(""), "taglist.txt", tagL)
	End If
	
	Dim ListAirp As List
	ListAirp.Initialize
	Dim He, ID, ii, init As Int
	If (Airp.add=0 And ID_edt = 0) And lst.NumberOfItems=0 Then
		If File.Exists(rp.GetSafeDirDefaultExternal(""), "taglist.txt") Then
			ListAirp = File.ReadList(rp.GetSafeDirDefaultExternal(""), "taglist.txt")
			If ID_use = 0 And ListAirp.Size > 0 Then ID_use = ListAirp.Get(0)
			If ListAirp.Size = N Then
				'Inicializar e criar lista de avioes na aba Airplanes
				For ii= 1 To N
					ID = ListAirp.Get(ii-1)
					He = 68dip
					lst.AddCustomItem(ID, CreateItem(ii, He, ID), He)
				Next
				lst.ResizePanel
			Else
				ToastMessageShow("Recreating ID List.", False)
				Dim tagL As List: tagL.Initialize
				For ii= 1 To N
					ID = ii
					tagL.Add(ID)
					He = 68dip
					lst.AddCustomItem(ID, CreateItem(ii, He, ID), He)
				Next
				File.WriteList(rp.GetSafeDirDefaultExternal(""), "taglist.txt", tagL)
				lst.ResizePanel	
			End If	
		Else
			Dim tagL As List: tagL.Initialize
			For ii= 1 To N
				ID = ii
				tagL.Add(ID)
				He = 68dip
				lst.AddCustomItem(ID, CreateItem(ii, He, ID), He)
			Next
			File.WriteList(rp.GetSafeDirDefaultExternal(""), "taglist.txt", tagL)
			lst.ResizePanel
		End If	
	Else If Airp.add=1 And ID_edt = 0 Then
		init=lst.NumberOfItems
		For ii= init+1 To N
			ID = ii
			He = 68dip
			lst.AddCustomItem(ID, CreateItem(ii, He, ID), He)
		Next
		lst.ResizePanel
		Dim ListAirp As List
		ListAirp.Initialize
		ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems-1)
		File.WriteList(rp.GetSafeDirDefaultExternal(""), "taglist.txt",ListAirp)
		Airp.add=0
	End If
	If ID_edt > 0 Then
		Dim pp As Panel
		Dim ll As Label
		pp=lst.FindPanelWithID(ID_edt)
		ll = pp.GetView(0)
		ll.Text=a.GetDefault(ID_edt & "_Name","")
		ID_edt=0
	End If
	
	'Popular spinner com avioes
	spnAirp.Clear
	spnAirp.Add("Custom Airplane")
	If File.Exists(rp.GetSafeDirDefaultExternal(""), "taglist.txt") Then
		ListAirp = File.ReadList(rp.GetSafeDirDefaultExternal(""), "taglist.txt")
		For ii = 0 To ListAirp.Size-1
			spnAirp.Add(a.Get(ListAirp.Get(ii) & "_Name"))
		Next
	Else
		If N<>0 Then
			For ii = 1 To N
				spnAirp.Add(a.Get(ii & "_Name"))
			Next
		End If
	End If
	
	If spinnerPos<=N Then
		spnAirp.SelectedIndex=spinnerPos
		spnAirp_ItemClick(spinnerPos,spnAirp)
	End If	
		
	'Variaveis Weight e CLmax do arquivo airplanes.txt
	If (File.Exists(rp.GetSafeDirDefaultExternal(""), "airplanes.txt")) And (File.Exists(File.DirInternal, "lastmod.txt")) Then
	indWeightType = m.GetDefault("var33", 0)
	indCLmaxType = m.GetDefault("var34", 0)
	Weight_Click
	CLmax_Click
	edtWeight.Text = m.GetDefault("var3", "")
	edtCLmax.Text = m.GetDefault("var6","")
	End If

	lst.DividerColor = ColorPnlLine3
		
End Sub

Sub Activity_Pause (UserClosed As Boolean)
	' Stop sensors
	pa.StopListening
	tmp.StopListening
	Gps1.Stop
	Ready = False
	
	' Escreve variaveis no arquivo interno lastmod.txt
	Dim m As Map
	m.Initialize
	DefaultInputs
	m.Put("var0", edtAlt.Text)
	m.Put("var1", edtTemp.Text)
	m.Put("var2", edtSpd.Text)
	m.Put("var3", edtWeight.Text)
	m.Put("var4", edtSref.Text)
	m.Put("var5", edtcref.Text)
	m.Put("var6", edtCLmax.Text)
	m.Put("var7", edtNz.Text)
	m.Put("var8", edtAngle1.Text)
	m.Put("var9", edtAngle2.Text)
	m.Put("var10", edtHeadWind.Text)
	m.Put("var11", edtCrossWind.Text)
	m.Put("var12", edtWindRefAngle.Text)
	m.Put("var13", indAltType)
	m.Put("var14", indAltUnit)
	m.Put("var15", indTempType)
	m.Put("var16", indAltUnit)
	m.Put("var17", indSpdType)
	m.Put("var18", indSpdUnit)
	m.Put("var19", indWeightUnit)
	m.Put("var20", indSrefUnit)
	m.Put("var21", indcrefUnit)
	m.Put("var22", indNzType)
	m.Put("var23", indAngle1Type)
	m.Put("var24", indAngle1Unit)
	m.Put("var25", indAngle2Type)
	m.Put("var26", indAngle2Unit)
	m.Put("var27", indHeadWindUnit)
	m.Put("var28", indCrossWindUnit)
	m.Put("var29", indWindRefAngleUnit)
	m.Put("var30", edtSpdDelta.Text)
	m.Put("var31", indWindType)
	m.Put("var32", spinnerPos)
	m.Put("var33", indWeightType)
	m.Put("var34", indCLmaxType)
	File.WriteMap(File.DirInternal, "lastmod.txt", m)
	
	' Escreve ordem dos avioes da aba AIRPLANES no arquivo taglist.txt
	If lst.IsInitialized And lst.NumberOfItems > 0 Then
		Dim ListAirp As List
		ListAirp.Initialize
		ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems-1)
		If ListAirp.IsInitialized And ListAirp.Size > 0 Then
			File.WriteList(rp.GetSafeDirDefaultExternal(""),"taglist.txt",ListAirp)
		End If
	End If
	
	'Grava para inicializacao
	Airp.add = 0
	
End Sub

Sub Pager_PageChanged (Position As Int)
	VibrateTap
	CurrentPage = Position
	
	' Fazer calculos se pagina de Outputs for selecionada e setar  painel marcador
	If CurrentPage = 2 Then
		Dim HideK As IME
		HideK.HideKeyboard
		line.SetLayoutAnimated(150,66.6666666666%x, HeaderHeight - 4dip * sc, 33.33333333%x, 4dip*sc)
		btnAirp.TextColor = ColorButText2
		btnBack.TextColor = ColorButText2
		btnCalc.TextColor = ColorButText3
		Calculate
	Else If CurrentPage = 1 Then
		line.SetLayoutAnimated(150,33.33333333%x, HeaderHeight - 4dip * sc, 33.33333333%x, 4dip*sc)
		btnAirp.TextColor = ColorButText2
		btnBack.TextColor = ColorButText3
		btnCalc.TextColor = ColorButText2
		Dim ListAirp As List
		ListAirp.Initialize
		ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems-1)
		spnAirp.Clear
		spnAirp.Add("Custom Airplane")
		For ii = 0 To ListAirp.Size-1
			spnAirp.Add(a.Get(ListAirp.Get(ii) & "_Name"))
		Next
	Else If CurrentPage = 0 Then
		Dim HideK As IME
		HideK.Initialize("")
		HideK.HideKeyboard
		line.SetLayoutAnimated(150,0%x, HeaderHeight - 4dip * sc, 33.33333333%x, 4dip*sc)
		btnAirp.TextColor = ColorButText3
		btnBack.TextColor = ColorButText2
		btnCalc.TextColor = ColorButText2
	End If
	
End Sub

Sub CreateItem(ii As Int, He As Int, ID As Int) As Panel
	' Criar panels e labes com nomes dos avioes
	Dim pnl As Panel: pnl.Initialize("")
	pnl.Tag = ID
	
	Dim planeName As String = a.GetDefault(ID & "_Name", "")
	Dim srefVal As String = a.GetDefault(ID & "_S", "")
	If srefVal.Length = 0 Then srefVal = a.GetDefault(ID & "_Sref", "")
	Dim crefVal As String = a.GetDefault(ID & "_c", "")
	If crefVal.Length = 0 Then crefVal = a.GetDefault(ID & "_cref", "")
	Dim srefUnitIdx As Int = a.GetDefault(ID & "_Sunit", 0)
	Dim crefUnitIdx As Int = a.GetDefault(ID & "_cunit", 0)
	Dim sUnits() As String = Array As String("m²", "ft²", "in²", "cm²", "mm²")
	Dim cUnits() As String = Array As String("m", "ft", "in", "cm", "mm")
	Dim sUnitStr As String = "m²"
	If srefUnitIdx >= 0 And srefUnitIdx < sUnits.Length Then sUnitStr = sUnits(srefUnitIdx)
	Dim cUnitStr As String = "m"
	If crefUnitIdx >= 0 And crefUnitIdx < cUnits.Length Then cUnitStr = cUnits(crefUnitIdx)

	Dim wVal As String = a.GetDefault(ID & "_W1", "")
	If wVal.Length = 0 Then wVal = a.GetDefault(ID & "_Weight1", "")
	If wVal.Length = 0 Then wVal = a.GetDefault(ID & "_W2", "")
	If wVal.Length = 0 Then wVal = a.GetDefault(ID & "_W3", "")
	If wVal.Length = 0 Then wVal = a.GetDefault(ID & "_W4", "")
	Dim wUnitIdx As Int = a.GetDefault(ID & "_Wunit", 0)
	Dim wUnits() As String = Array As String("kg", "lb", "ton", "slug", "oz")
	Dim wUnitStr As String = "kg"
	If wUnitIdx >= 0 And wUnitIdx < wUnits.Length Then wUnitStr = wUnits(wUnitIdx)

	Dim subStr As String = ""
	If srefVal.Length > 0 Then subStr = srefVal & " " & sUnitStr
	If wVal.Length > 0 Then
		If subStr.Length > 0 Then subStr = subStr & "  •  " & wVal & " " & wUnitStr Else subStr = wVal & " " & wUnitStr
	Else If crefVal.Length > 0 Then
		If subStr.Length > 0 Then subStr = subStr & "  •  " & crefVal & " " & cUnitStr Else subStr = crefVal & " " & cUnitStr
	End If

	' TWO dedicated labels for pixel-perfect vertical hierarchy and clean spacing:
	Dim lblTitle As Label: lblTitle.Initialize("")
	Dim lblSub As Label: lblSub.Initialize("")

	lblTitle.Tag = ID
	lblSub.Tag = ID

	Dim csTitle As CSBuilder
	csTitle.Initialize.Bold.Append(planeName).Pop
	If ID = ID_use Then
		csTitle.Append("   ").Bold.Color(ColorEdtText).RelativeSize(0.72).Append("ACTIVE").Pop.Pop.Pop
	End If
	lblTitle.Text = csTitle
	lblTitle.TextColor = ColorButText1
	lblTitle.TextSize = 15
	lblTitle.Gravity = Gravity.CENTER_VERTICAL
	lblTitle.SingleLine = True

	lblSub.Text = subStr
	lblSub.TextColor = ColorEdtHint
	lblSub.TextSize = 12.5
	lblSub.Gravity = Gravity.CENTER_VERTICAL
	lblSub.SingleLine = True

	Try
		Dim joT As JavaObject = lblTitle
		joT.RunMethod("setClickable", Array As Object(False))
		joT.RunMethod("setFocusable", Array As Object(False))
		joT.RunMethod("setLongClickable", Array As Object(False))
		Dim joS As JavaObject = lblSub
		joS.RunMethod("setClickable", Array As Object(False))
		joS.RunMethod("setFocusable", Array As Object(False))
		joS.RunMethod("setLongClickable", Array As Object(False))
	Catch
		Log("lbl touch pass-through skipped: " & LastException.Message)
	End Try

	' Layout buttons & labels:
	' Right margin of 10dip so Delete button is never truncated at right edge of screen
	Dim rightMargin As Int = 10dip
	Dim btnW As Int = 42dip
	Dim iconSz As Int = 26dip
	Dim labelW As Int = root.Width - rightMargin - 3 * btnW - 18dip

	pnl.AddView(lblTitle, 16dip, 11dip, labelW, 23dip)
	pnl.AddView(lblSub, 16dip, 37dip, labelW, 18dip)

	If ID = ID_use Then
		pnl.Background = EditGradient(ColorEdt, ColorPnlLine3)
		Dim pnlActiveBar As Panel
		pnlActiveBar.Initialize("")
		pnlActiveBar.Color = ColorEdtText
		pnl.AddView(pnlActiveBar, 0, 0, 4dip, He)
	Else
		pnl.Background = EditGradient(ColorPnlInput2, ColorPnlLine3)
	End If

	' 3 action buttons: Delete (rightmost), Edit (middle), Duplicate (left)
	Dim pnlTransp2 As Panel
	Dim pnlTransp3 As Panel
	Dim pnlTransp4 As Panel
	pnlTransp2.Initialize("pnlTransp2")
	pnlTransp2.Color = Colors.Transparent
	pnlTransp3.Initialize("pnlTransp3")
	pnlTransp3.Color = Colors.Transparent
	pnlTransp4.Initialize("pnlTransp4")
	pnlTransp4.Color = Colors.Transparent

	pnl.AddView(pnlTransp2, root.Width - rightMargin - 1 * btnW, 0, btnW, He)
	pnl.AddView(pnlTransp3, root.Width - rightMargin - 2 * btnW, 0, btnW, He)
	pnl.AddView(pnlTransp4, root.Width - rightMargin - 3 * btnW, 0, btnW, He)

	Dim im2 As ImageView: im2.Initialize("im2")
	Dim im3 As ImageView: im3.Initialize("im3")
	Dim im4 As ImageView: im4.Initialize("im4")
	im2.Bitmap = LoadBitmap(File.DirAssets, "icon_delete.png")
	im2.Gravity = Gravity.FILL
	im3.Bitmap = LoadBitmap(File.DirAssets, "icon_edit.png")
	im3.Gravity = Gravity.FILL
	im4.Bitmap = LoadBitmap(File.DirAssets, "icon_duplicate.png")
	im4.Gravity = Gravity.FILL

	Dim iconTop As Int = (He - iconSz) / 2
	pnlTransp2.AddView(im2, (btnW - iconSz) / 2, iconTop, iconSz, iconSz)
	pnlTransp3.AddView(im3, (btnW - iconSz) / 2, iconTop, iconSz, iconSz)
	pnlTransp4.AddView(im4, (btnW - iconSz) / 2, iconTop, iconSz, iconSz)

	TintImageView(im2, ColorEdtText)
	TintImageView(im3, ColorEdtText)
	TintImageView(im4, ColorEdtText)

	pnlTransp2.Tag = ID
	pnlTransp3.Tag = ID
	pnlTransp4.Tag = ID

	Return pnl
End Sub

Public Sub RefreshAirplanesList
	If lst.IsInitialized = False Then Return
	Dim ListAirp As List
	ListAirp.Initialize
	If lst.NumberOfItems > 0 Then
		ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems - 1)
	End If
	If ListAirp.IsInitialized = False Or ListAirp.Size = 0 Then
		If File.Exists(rp.GetSafeDirDefaultExternal(""), "taglist.txt") Then
			ListAirp = File.ReadList(rp.GetSafeDirDefaultExternal(""), "taglist.txt")
		End If
	End If
	If ListAirp.IsInitialized = False Or ListAirp.Size = 0 Then
		Dim N As Int = 0
		If a.IsInitialized And a.ContainsKey("N") Then
			N = a.Get("N")
		End If
		For ii = 1 To N
			ListAirp.Add(ii)
		Next
	End If
	If ListAirp.IsInitialized And ListAirp.Size > 0 Then
		Do While lst.NumberOfItems > 0
			lst.RemoveItemAt(0)
		Loop
		Dim He As Int = 68dip
		For ii = 0 To ListAirp.Size - 1
			Dim ID As Int = ListAirp.Get(ii)
			lst.AddCustomItem(ID, CreateItem(ii, He, ID), He)
		Next
		lst.ResizePanel
		lst.DividerColor = ColorPnlLine3
	End If
End Sub

Sub pnlTransp2_Touch (Action As Int, X As Float, Y As Float) As Boolean
	Dim pp As Panel
	pp = Sender
	
	ID_rem = pp.Tag	
	Select Action
	Case Activity.ACTION_DOWN
		pp.Color = ColorPnlLine2
	Case Activity.ACTION_UP
		pp.Color = Colors.Transparent
		Dim N As Int
		N=a.Get("N")
		Dim confirm As Int
		confirm=Msgbox2("Are you sure you want to delete this airplane?","Warning","Confirm","Cancel","",LoadBitmap(File.DirAssets,"icon_warning.png"))
		'Wait For Msgbox_Result (confirm As Int)
		If confirm=DialogResponse.POSITIVE Then
			If ID_rem<>N Then
				For ii=ID_rem To N-1 	
					a.Put(ii & "_Name", a.Get((ii+1) & "_Name"))
					a.Put(ii & "_S", a.GetDefault((ii+1)& "_S",""))
					a.Put(ii & "_c", a.GetDefault((ii+1) & "_c",""))
					a.Put(ii & "_W1", a.GetDefault((ii+1) & "_W1",""))
					a.Put(ii & "_W2", a.GetDefault((ii+1) & "_W2",""))
					a.Put(ii & "_W3", a.GetDefault((ii+1) & "_W3",""))
					a.Put(ii & "_W4", a.GetDefault((ii+1) & "_W4",""))
					a.Put(ii & "_W5", a.GetDefault((ii+1) & "_W5",""))
					a.Put(ii & "_W6", a.GetDefault((ii+1) & "_W6",""))
					a.Put(ii & "_F0", a.GetDefault((ii+1) & "_F0",""))
					a.Put(ii & "_F1", a.GetDefault((ii+1) & "_F1",""))
					a.Put(ii & "_F2", a.GetDefault((ii+1) & "_F2",""))
					a.Put(ii & "_F3", a.GetDefault((ii+1) & "_F3",""))
					a.Put(ii & "_F4", a.GetDefault((ii+1) & "_F4",""))
					a.Put(ii & "_F5", a.GetDefault((ii+1) & "_F5",""))
					a.Put(ii & "_F6", a.GetDefault((ii+1) & "_F6",""))
					a.Put(ii & "_F7", a.GetDefault((ii+1) & "_F7",""))
					a.Put(ii & "_F8", a.GetDefault((ii+1) & "_F8",""))
					a.Put(ii & "_F9", a.GetDefault((ii + 1) & "_F9",""))
					a.Put(ii & "_F10", a.GetDefault((ii + 1) & "_F10",""))
					a.Put(ii & "_F11", a.GetDefault((ii + 1) & "_F11",""))
					a.Put(ii & "_F12", a.GetDefault((ii + 1) & "_F12",""))
					a.Put(ii & "_F13", a.GetDefault((ii + 1) & "_F13",""))
					a.Put(ii & "_Sunit", a.GetDefault((ii+1) & "_Sunit",0))
					a.Put(ii & "_cunit", a.GetDefault((ii+1) & "_cunit",0))
					a.Put(ii & "_Wunit", a.GetDefault((ii + 1) & "_Wunit",0))
				Next
			End If
			
			Dim pnlanim As Panel
			pnlanim=lst.FindPanelWithID(ID_rem)
			Dim a1 As Animation
			a1.InitializeAlpha("a1",1,0)
			a1.Duration = 325
			a1.Start(pnlanim)
			
			Timer1.Initialize("Timer1", 325)
			Timer1.Enabled = True
			
		End If
	End Select
	Return True
End Sub

Sub Timer1_tick
	Timer1.Enabled = False
	
	Dim N As Int
	N=a.Get("N")
	
	Dim ListAirp As List
	ListAirp.Initialize
	ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems-1)

	For ii=1 To N
		lst.RemoveItemID(ii)
	Next			
	lst.ResizePanel

	Dim He, ID As Int
	Dim NewList As List
	Dim positiondel As Int
	positiondel = ListAirp.IndexOf(ID_rem)
	
	NewList.Initialize
	NewList=ListAirp
	NewList.RemoveAt(positiondel)
	For ii=0 To NewList.Size-1
		If NewList.Get(ii)>ID_rem Then
			NewList.Set(ii,(NewList.Get(ii)-1))
		End If
	Next
	For ii = 0 To NewList.Size-1
			ID = NewList.Get(ii)
			He = 68dip
			lst.AddCustomItem(ID, CreateItem(ii, He, ID), He)
	Next	
	lst.ResizePanel
	a.Remove(a.Get("N") & "_Name")
	a.Remove(a.Get("N") & "_S")
	a.Remove(a.Get("N") & "_c")
	a.Remove(a.Get("N") & "_W1")
	a.Remove(a.Get("N") & "_W2")
	a.Remove(a.Get("N") & "_W3")
	a.Remove(a.Get("N") & "_W4")
	a.Remove(a.Get("N") & "_W5")
	a.Remove(a.Get("N") & "_W6")
	a.Remove(a.Get("N") & "_F0")
	a.Remove(a.Get("N") & "_F1")
	a.Remove(a.Get("N") & "_F2")
	a.Remove(a.Get("N") & "_F3")
	a.Remove(a.Get("N") & "_F4")
	a.Remove(a.Get("N") & "_F5")
	a.Remove(a.Get("N") & "_F6")
	a.Remove(a.Get("N") & "_F7")
	a.Remove(a.Get("N") & "_F8")
	a.Remove(a.Get("N") & "_F9")
	a.Remove(a.Get("N") & "_F10")
	a.Remove(a.Get("N") & "_F11")
	a.Remove(a.Get("N") & "_F12")
	a.Remove(a.Get("N") & "_F13")
	a.Remove(a.Get("N") & "_Sunit")
	a.Remove(a.Get("N") & "_cunit")
	a.Remove(a.Get("N") & "_Wunit")
	a.Put("N", (N-1))
	File.WriteMap(rp.GetSafeDirDefaultExternal(""), "airplanes.txt", a)
	ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems-1)
	File.WriteList(rp.GetSafeDirDefaultExternal(""), "taglist.txt", ListAirp)
	lst.DividerColor = ColorPnlLine3

End Sub

