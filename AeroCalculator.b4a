Sub Activity_Create(FirstTime As Boolean)
			
	' Criando screen de settings e iniciando GPS
    If FirstTime Then
		CreatePreferenceScreen
		Gps1.Initialize("GPS")
		If manager.GetAll.Size = 0 Then SetDefaults
	Else			
	End If
	GpsCheck = 1
	GpsCheck2 = 1
	GpsStatus = False
	
	'Iniciando container com as paginas
	container.Initialize
	
	' Condicoes iniciais	
	kAlt = 0.3048
	kPres = 100
	kPres2 = 1
	kTemp = 1
	cTemp = 273.15
	kTemp2 = 1
	cTemp2 = 0
	kSpd = 1852 / 3600
	kWeight = 1
	kSref = 1
	kcref = 1
	indAltUnit = 0
 	indTempUnit = 0 
 	indSpdUnit = 0 
 	indWeightUnit = 0 
 	indSrefUnit = 0 
	indcrefUnit = 0
	indAngle1Unit = 0
	indAngle2Unit = 0
	indWindRefAngleUnit = 0
 	indAltType = 0
 	indTempType = 1 
	indSpdType = 1
	indWindType = 0
	kSpd1 = 1852 / 3600
	kSpd2 = 1852 / 3600
	KAngle1 = 3.14159265358979323846 / 180
	KAngle2 = 3.14159265358979323846 / 180
	KAngle3 = 3.14159265358979323846 / 180
	
	'Themes
	If manager.GetString("theme").CompareTo("Ancient Brown")=0 Then	
		ColorPnlTitle =  Colors.RGB(62,41,30)
		ColorTitleText = Colors.White
		'ColorPnlDown =   ColorPnlTitle
		ColorPnlLine =   Colors.White
		ColorPnlLine2 =  Colors.DarkGray
		ColorPnlLine3 =  ColorPnlTitle
		ColorBut3 =      Colors.Transparent
		ColorBut4 = 	 Colors.Transparent
		ColorButText2 =  Colors.RGB(236, 236, 236)
		ColorButText3 =  Colors.White
		ColorBut1 = 	 Colors.RGB(220,210,193)
		ColorBut2 =      Colors.RGB(243,237,210)
		ColorButText1 =  Colors.Black
		ColorEdt =       Colors.RGB(243,237,210)
		ColorEdtText =   Colors.Black
		ColorEdtHint =   Colors.Gray
		ColorPnlInput1 = Colors.RGB(228, 210, 180)	
		ColorPnlInput2 = Colors.RGB(228, 210, 180)
		ColorPnlInput3 = Colors.White	
		ColorPnlInput4 = Colors.RGB(243,237,210)
		ColorPnlInput5 = Colors.RGB(243,237,210)
'	Else If manager.GetString("theme").CompareTo("Green Peace")=0 Then
'			ColorPnlTitle =  Colors.RGB(0, 150, 136)
'			ColorTitleText = Colors.White
'			'ColorPnlDown =   ColorPnlTitle
'			ColorPnlLine =   Colors.White
'			ColorPnlLine2 =  Colors.DarkGray
'			ColorPnlLine3 =  ColorPnlTitle
'			ColorBut3 =      Colors.Transparent
'			ColorBut4 = 	 Colors.Transparent
'			ColorButText2 =  Colors.RGB(236, 236, 236)
'			ColorButText3 =  Colors.White
'			ColorBut1 = 	 Colors.ARGB(255,218,253,249)
'			ColorBut2 =      Colors.White
'			ColorButText1 =  Colors.Black
'			ColorEdt =       Colors.White
'			ColorEdtText =   Colors.Black
'			ColorEdtHint =   Colors.Gray
'			ColorPnlInput1 = Colors.RGB(222, 242, 241)
'			ColorPnlInput2 = Colors.RGB(222, 242, 241)
'			ColorPnlInput3 = Colors.White
'			ColorPnlInput4 = Colors.RGB(222, 242, 241)
'			ColorPnlInput5 = Colors.RGB(222, 242, 241)
	Else If manager.GetString("theme").CompareTo("Green Peace")=0 Then
		ColorPnlTitle =  Colors.RGB(0, 145, 131)
		ColorTitleText = Colors.White
		ColorPnlLine =   Colors.White
		ColorPnlLine2 =  Colors.DarkGray
		ColorPnlLine3 =  ColorPnlTitle
		ColorBut3 =      Colors.Transparent
		ColorBut4 = 	 Colors.Transparent
		ColorButText2 =  Colors.RGB(239, 239, 239)
		ColorButText3 =  Colors.RGB(255, 255, 255)
		ColorBut1 = 	 Colors.ARGB(255,228,255,251)
		ColorBut2 =      Colors.RGB(250, 255, 253)
		ColorButText1 =  Colors.Black	
		ColorEdt =       Colors.RGB(252, 255, 254)
		ColorEdtText =   Colors.Black
		ColorEdtHint =   Colors.Gray
		ColorPnlInput1 = Colors.RGB(233, 242, 241)	
		ColorPnlInput2 = Colors.RGB(233, 242, 241)
		ColorPnlInput3 = Colors.RGB(252, 255, 254)
		ColorPnlInput4 = Colors.RGB(233, 242, 241)
		ColorPnlInput5 = Colors.RGB(233, 242, 241)	
	Else If manager.GetString("theme").CompareTo("Dark Shadows")=0 Then
		ColorPnlTitle =  Colors.Black
		ColorTitleText = Colors.White
		'ColorPnlDown =   ColorPnlTitle
		ColorPnlLine =   Colors.RGB(249, 249, 249)
		ColorPnlLine2 =  Colors.DarkGray
		ColorPnlLine3 =  ColorPnlTitle
		ColorBut3 =      Colors.Transparent
		ColorBut4 = 	 Colors.Transparent
		ColorButText2 =  Colors.RGB(236, 236, 236)
		ColorButText3 =  Colors.White
		ColorBut1 = 	 Colors.LightGray
		ColorBut2 =      Colors.RGB(243,243,245)
		ColorButText1 =  Colors.Black	
		ColorEdt =       Colors.RGB(243,243,243)	
		ColorEdtText =   Colors.Black
		ColorEdtHint =   Colors.Gray
		ColorPnlInput1 = Colors.White		
		ColorPnlInput2 = Colors.White
		ColorPnlInput3 = Colors.White	
		ColorPnlInput4 = Colors.RGB(243, 243, 243)
		ColorPnlInput5 = Colors.White
	Else If manager.GetString("theme").CompareTo("Blue Sky")=0 Then
		ColorPnlTitle =  Colors.RGB(26,35,126)
		ColorTitleText = Colors.White
		'ColorPnlDown =   ColorPnlTitle
		ColorPnlLine =   Colors.RGB(242, 242, 248)
		ColorPnlLine2 =  Colors.DarkGray
		ColorPnlLine3 =  ColorPnlTitle
		ColorBut3 =      Colors.Transparent
		ColorBut4 = 	 Colors.Transparent
		ColorButText2 =  Colors.RGB(236, 236, 236)
		ColorButText3 =  Colors.White
		ColorBut1 = 	 Colors.RGB(212, 214, 228)
		ColorBut2 =      Colors.RGB(232, 234, 248)
		ColorButText1 =  Colors.Black	
		ColorEdt =       Colors.RGB(232, 234, 248)	
		ColorEdtText =   Colors.Black
		ColorEdtHint =   Colors.Gray
		ColorPnlInput1 = Colors.White		
		ColorPnlInput2 = Colors.White
		ColorPnlInput3 = Colors.White	
		ColorPnlInput4 = Colors.RGB(232, 234, 248)
		ColorPnlInput5 = Colors.White
	Else If manager.GetString("theme").CompareTo("Red Alert")=0 Then
		ColorPnlTitle =  Colors.RGB(176, 18, 10)
		ColorTitleText = Colors.White
		'ColorPnlDown =   ColorPnlTitle
		ColorPnlLine =   Colors.White
		ColorPnlLine2 =  Colors.DarkGray
		ColorPnlLine3 =  ColorPnlTitle
		ColorBut3 =      Colors.Transparent
		ColorBut4 = 	 Colors.Transparent
		ColorButText2 =  Colors.RGB(236, 236, 236)
		ColorButText3 =  Colors.White
		ColorBut1 = 	 Colors.RGB(255, 199, 197)
		ColorBut2 =      Colors.RGB(253, 224, 220)
		ColorButText1 =  Colors.Black		
		ColorEdt =       Colors.RGB(253, 224, 220)
		ColorEdtText =   Colors.Black
		ColorEdtHint =   Colors.Gray
		ColorPnlInput1 = Colors.RGB(249, 189, 187)	
		ColorPnlInput2 = Colors.RGB(249, 189, 187)
		ColorPnlInput3 = Colors.RGB(249, 189, 187)	
		ColorPnlInput4 = Colors.RGB(253, 224, 220)
		ColorPnlInput5 = Colors.RGB(249, 189, 187)
	Else If manager.GetString("theme").CompareTo("Orange Juice")=0 Then
		ColorPnlTitle =  Colors.RGB(230,98, 0)
		ColorTitleText = Colors.White
		'ColorPnlDown =   ColorPnlTitle
		ColorPnlLine =   Colors.White
		ColorPnlLine2 =  Colors.DarkGray
		ColorPnlLine3 =  ColorPnlTitle
		ColorBut3 =      Colors.Transparent
		ColorBut4 = 	 Colors.Transparent
		ColorButText2 =  Colors.RGB(236, 236, 236)
		ColorButText3 =  Colors.White
		ColorBut1 = 	 Colors.ARGB(240,255,253,170)
		ColorBut2 =      Colors.ARGB(249,255,236,179)
		ColorButText1 =  Colors.Black	
		ColorEdt =       Colors.ARGB(249,255,246,175)
		ColorEdtText =   Colors.Black
		ColorEdtHint =   Colors.Gray
		ColorPnlInput1 = Colors.RGB(255, 224, 148)	
		ColorPnlInput2 = Colors.RGB(255, 224, 148)
		ColorPnlInput3 = Colors.ARGB(249,255,246,175)	
		ColorPnlInput4 = Colors.RGB(255, 224, 148)
		ColorPnlInput5 = Colors.RGB(255, 224, 148)
	End If
	
	'Criando pagina de Airplanes
	pnlBack0.Initialize("")
	pnlBack0.Color = ColorPnlInput5
    scvMain0.Initialize(3000)
	pnlBack0.AddView(scvMain0, 0, 0, 100%x, 100%y-100dip)
	lst.Initialize(Me, scvMain0, "", "", "lst_LongClick", 1dip)
	lst.DividerColor = ColorPnlLine3
	container.AddPage(pnlBack0,"Airplanes")
	
	' Inicializando variaveis para definir se vamos editar ou adicionar um aviao.
	ID_edt = 0
	Airp.add = 0
	
	' Criando pagina de inputs
	pnlBack1.Initialize("")
	pnlBack1.Color = Colors.White
    scvMain1.Initialize(100%y)
	pnlBack1.AddView(scvMain1, 0, 0, 100%x, 100%y-100dip)
 
	' Tamanho e numero de paineis de inputs
	ib = 8dip
	tb = 40dip	
	Dim PanelNb As Int  
	PanelNb = 14
	
	' Escalonamento com tamanho do celular
	Dim hh, yy As Double
	hh = 99dip + PanelNb * (ib * 2 + tb) + PanelNb * 1dip + 1dip
	yy = Activity.Height
	xx = Activity.Width
	
	sc = yy / hh
	If sc<1 Then
		sc=1
	End If
	If Activity.Width > Activity.Height Then
		ld = 1
	Else
		ld = 0
	End If

	' Criando tela de inputs
	Dim j As Int
	For j=0 To PanelNb-1
		pnlInput.Initialize("pnlInput")
		pnlline.Initialize("pnlline")
		If j=0 Then
			scvMain1.Panel.AddView(pnlInput, 0, 0, 100%x, (ib*2+tb)*sc)
			scvMain1.Panel.AddView(pnlline, 0%x, (PanelNb * (ib * 2 + tb) + (PanelNb) * 1dip) * sc-1dip, 100%x, 1dip * sc)
		Else
			scvMain1.Panel.AddView(pnlInput, 0%x, (j * (ib*2+tb)+j*1dip)*sc, 100%x, (ib*2+tb)*sc)
			scvMain1.Panel.AddView(pnlline, 0%x, (j * (ib*2+tb)+j*1dip-1dip)*sc, 100%x,1dip*sc)
		End If
		
	    pnlInput.Tag=j
	    If (j Mod 2)=1 Then
			pnlInput.Color = ColorPnlInput1		
	    Else
	        pnlInput.Color = ColorPnlInput2
		End If
		pnlline.Color = ColorPnlLine3
		
		Dim filter As IME
		filter.Initialize("")	
		
		Select j
		Case 0
			btnAirplane.Initialize("btnAirplane")
			pnlInput.AddView(btnAirplane, 3%x, ib*sc, 30%x, tb*sc)
			btnAirplane.Text = "Airplane"
			btnAirplane.TextSize = 15*sc
			btnAirplane.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2),Array As Int(ColorBut1, ColorPnlTitle))
			Dim panelspn As Panel
			panelspn.Initialize("panelspn")
			pnlInput.AddView(panelspn, 37%x, ib * sc, 60%x, tb * sc)
			panelspn.Background=ButtonGradient(Array As Int(ColorEdt, ColorEdt),Array As Int(ColorBut1, ColorPnlTitle))
			spnAirp.Initialize("spnAirp")
			spnAirp.TextSize = 14*sc
			SpinnerCreate
			'SetNinePatchDrawable(spnAirp, "spinner_ab_default_holo_light_am")
		Case 1
		    btnAltType.Initialize("btnAltType")
			pnlInput.AddView(btnAltType, 3%x, ib*sc, 30%x, tb*sc)
			btnAltType.Text = "Hp"
			btnAltType.TextSize = 15*sc
			btnAltType.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2),Array As Int(ColorBut1, ColorPnlTitle))
			edtAlt.Initialize("edtAlt")
		    pnlInput.AddView(edtAlt,37%x, ib*sc, 36%x, tb*sc)
			edtAlt.Hint="Altitude"
			edtAlt.InputType = edtAlt.INPUT_TYPE_DECIMAL_NUMBERS
			edtAlt.ForceDoneButton = True
			edtAlt.TextSize = 13*sc
			filter.SetCustomFilter(edtAlt, edtAlt.INPUT_TYPE_DECIMAL_NUMBERS, "0123456789.-")
			btnAltUnit.Initialize("btnAltUnit")
			btnAltUnit.Background = ButtonGradient(Array As Int(ColorBut1, ColorBut2),Array As Int(ColorBut1, ColorPnlTitle))
		    pnlInput.AddView(btnAltUnit,77%x, ib*sc, 20%x, tb*sc)
		    btnAltUnit.Text="ft"
			btnAltUnit.TextSize = 15*sc
			edtAlt.TextColor = ColorEdtText
			edtAlt.Color = ColorEdt
			edtAlt.HintColor = ColorEdtHint
			btnAltType.TextColor = ColorButText1
			btnAltUnit.TextColor = ColorButText1
			'SetNinePatchButton2(edtAlt, "apptheme_textfield_default_holo_light","","", "apptheme_textfield_activated_holo_light","")
		Case 2
		    btnTempType.Initialize("btnTempType")
