Sub AltType_Click
	If indAltType<>2 And indSpdType<>7 Then
		Gps1.Stop
		Ready = False
		GpsCheck = 1
	Else If indAltType=2 Then
		If GpsCheck2 = 1 Then
			rp.CheckAndRequest(rp.PERMISSION_ACCESS_FINE_LOCATION)
			Wait For Activity_PermissionResult (Permission As String, Result1 As Boolean)
			GpsCheck2 = 0
			GpsStatus = Result1
		End If
		If GpsStatus Then
		    If Gps1.GPSEnabled = False And GpsCheck=1 Then
	            ToastMessageShow("Please enable the GPS device.", True)
		    	StartActivity(Gps1.LocationSettingsIntent) 'Will open the relevant settings screen.
		    	GpsCheck = 0
		    Else If Gps1.GPSEnabled = False And GpsCheck=0 Then
		    	ToastMessageShow("GPS not enabled.", True)
	        End If
		    If Not(Ready) Then
		    	Gps1.Start(100,1)
		    	Ready = True
		    End If
		Else
			ToastMessageShow("Denied location access", True)
		End If
	End If
	If indAltType < 0 Then
	Else If indAltType=0 Or indAltType=1 Or indAltType=2 Then
		If indAltType=0 Then
			If xx > 340dip Or sc > 1 Then
				btnAltType.Text = MakeSubscript("Altitude H", "p", "")
			Else
				btnAltType.Text = MakeSubscript("H", "p", "")
			End If
		Else If indAltType=1 Then
			If xx > 340dip Or sc > 1 Then
				btnAltType.Text = MakeSubscript("Altitude H", "g", "")
			Else
				btnAltType.Text = MakeSubscript("H", "g", "")
			End If
		Else If indAltType=2 Then
			If xx > 340dip Or sc > 1 Then
				btnAltType.Text = MakeSubscript("Altitude H", "g", "")
			Else
				btnAltType.Text = MakeSubscript("H", "g", "")	
			End If
		End If
		edtAlt.Hint = "Altitude"
		pa.StopListening
		If indAltUnit < 0 Then
		Else If indAltUnit = 0 Then
			btnAltUnit.Text = "ft"
			kAlt = 0.3048
		Else If indAltUnit = 1 Then
			btnAltUnit.Text = "m"
			kAlt = 1
		Else If indAltUnit = 2 Then
			btnAltUnit.Text = "km"
			kAlt = 1000
		Else If indAltUnit = 3 Then
			btnAltUnit.Text = "nm"
			kAlt = 1852
		Else If indAltUnit = 4 Then
			btnAltUnit.Text = "mi"
			kAlt = 1609.344
		Else If indAltUnit = 5 Then
			btnAltUnit.Text = "in"
			kAlt = 0.0254
		End If
		If indAltType = 2 Then
			edtAlt.Text = NumberFormat2(GPSalt / kAlt,1,1,1,False)
		End If	
	Else If indAltType = 3 Then
		If xx > 340dip Or sc > 1 Then
			btnAltType.Text = "Static Pressure"
		Else
			btnAltType.Text = "P"
		End If
		edtAlt.Hint = "Pressure"
		pa.StopListening
		If indAltUnit < 0 Then
		Else If indAltUnit = 0 Then
			btnAltUnit.Text = "mbar"
			kPres = 100
		Else If indAltUnit = 1 Then
			btnAltUnit.Text = "Pa"
			kPres = 1
		Else If indAltUnit = 2 Then
			btnAltUnit.Text = "hPa"
			kPres = 100
		Else If indAltUnit = 3 Then
			btnAltUnit.Text = "atm"
			kPres = 101325
		Else If indAltUnit = 4 Then
			btnAltUnit.Text = "mmHg"
			kPres = 133.3223684
		Else If indAltUnit = 5 Then
			btnAltUnit.Text = "psi"
			kPres = 6894.75729
		End If
	Else If indAltType = 4 Then
		pa.Initialize2(pa.TYPE_PRESSURE,3)
		Dim listen As Boolean
		listen=pa.StartListening("Sensor1")
		If listen = False Then
		Msgbox2Async("Pressure Sensor is not supported in this device.", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
		Wait For Msbox_Result (Idx98 As Int)
		End If
		If xx > 340dip Or sc > 1 Then
			btnAltType.Text = "Sensor Pressure"
		Else
			btnAltType.Text = "P"
		End If
		btnAltUnit.Text = "mbar"
		kPres = 100
		If indAltUnit < 0 Then
		Else If indAltUnit = 0 Then
			btnAltUnit.Text = "mbar"
			kPres2 = 1
		Else If indAltUnit = 1 Then
			btnAltUnit.Text = "Pa"
			kPres2 = 1*100
		Else If indAltUnit = 2 Then
			btnAltUnit.Text = "hPa"
			kPres2 = 0.01*100
		Else If indAltUnit = 3 Then
			btnAltUnit.Text = "atm"
			kPres2 = 1/101325*100
		Else If indAltUnit = 4 Then
			btnAltUnit.Text = "mmHg"
			kPres2 = 0.007500616827042*100
		Else If indAltUnit = 5 Then
			btnAltUnit.Text = "psi"
			kPres2 = 0.0001450378911491*100
		End If
		edtAlt.Text = NumberFormat2(PressureSensor*kPres2,1,2,2,False)
	End If	
End Sub

Sub AltUnit_Click
	If indAltType=0 Or indAltType=1 Or indAltType=2 Then
		If indAltUnit < 0 Then
		Else If indAltUnit = 0 Then
			btnAltUnit.Text = "ft"
			kAlt = 0.3048
		Else If indAltUnit = 1 Then
			btnAltUnit.Text = "m"
			kAlt = 1
		Else If indAltUnit = 2 Then
			btnAltUnit.Text = "km"
			kAlt = 1000
		Else If indAltUnit = 3 Then
			btnAltUnit.Text = "nm"
			kAlt = 1852
		Else If indAltUnit = 4 Then
			btnAltUnit.Text = "mi"
			kAlt = 1609.344
		Else If indAltUnit = 5 Then
			btnAltUnit.Text = "in"
			kAlt = 0.0254
		End If
	Else If indAltType=3 Then
		If indAltUnit < 0 Then
		Else If indAltUnit = 0 Then
			btnAltUnit.Text = "mbar"
			kPres = 100
		Else If indAltUnit = 1 Then
			btnAltUnit.Text = "Pa"
			kPres = 1
		Else If indAltUnit = 2 Then
			btnAltUnit.Text = "hPa"
			kPres = 100
		Else If indAltUnit = 3 Then
			btnAltUnit.Text = "atm"
			kPres = 101325
		Else If indAltUnit = 4 Then
			btnAltUnit.Text = "mmHg"
			kPres = 133.3223684
		Else If indAltUnit = 5 Then
			btnAltUnit.Text = "psi"
			kPres = 6894.75729
		End If
	Else If indAltType=4 Then	
		kPres = 100
		If indAltUnit < 0 Then
		Else If indAltUnit = 0 Then
			btnAltUnit.Text = "mbar"
			kPres2 = 1
		Else If indAltUnit = 1 Then
			btnAltUnit.Text = "Pa"
			kPres2 = 1*100
		Else If indAltUnit = 2 Then
			btnAltUnit.Text = "hPa"
			kPres2 = 1
		Else If indAltUnit = 3 Then
			btnAltUnit.Text = "atm"
			kPres2 = 1/101325*100
		Else If indAltUnit = 4 Then
			btnAltUnit.Text = "mmHg"
			kPres2 = 0.007500616827042*100
		Else If indAltUnit = 5 Then
			btnAltUnit.Text = "psi"
			kPres2 = 0.0001450378911491*100
		End If
	End If
	If indAltType = 2 Or indAltType = 4 Then
		AltType_Click
	End If
End Sub

Sub TempType_Click
	If indTempType < 0 Then
	Else If indTempType = 0 Then
		btnTempType.Text = "Δ ISA"
		tmp.StopListening
	Else If indTempType = 1 Then
		If xx > 340dip Or sc > 1 Then
			btnTempType.Text = "Temperature OAT"
		Else
			btnTempType.Text = "OAT"
		End If
		tmp.StopListening
	Else If indTempType = 2 Then
		If xx > 340dip Or sc > 1 Then
			btnTempType.Text = "Temperature OAT"
		Else
			btnTempType.Text = "OAT"
		End If
		tmp.Initialize(tmp.TYPE_TEMPERATURE)
		Dim listen As Boolean
		listen=tmp.StartListening("Sensor2")
		If listen = False Then
			Msgbox2Async("Temperature Sensor is not supported in this device.", "Error", "OK","","",LoadBitmap(File.DirAssets,"icon_error.png"),True)
			Wait For Msbox_Result (Idx101 As Int)
		End If
		edtTemp.Text = NumberFormat2(TempSensor*kTemp2+cTemp2,1,2,2,False)
	End If
End Sub

Sub TempUnit_Click
	If indTempUnit < 0 Then
	Else If indTempUnit = 0 Then
		btnTempUnit.Text = "°C"
		kTemp = 1
		cTemp = 273.15
		kTemp2 = 1
		cTemp2= 0
	Else If indTempUnit = 1 Then
		btnTempUnit.Text = "°F"
		kTemp = 5/9
		cTemp = -32 * 5/9 + 273.15
		kTemp2 = 9/5
		cTemp2 = 32
	Else If indTempUnit = 2 Then
		btnTempUnit.Text = "K"
		kTemp = 1
		cTemp = 0
		kTemp2 = 1
		cTemp2 = 273.15
	End If	
End Sub

Sub SpdType_Click
	If indAltType<>2 And indSpdType<>7 Then
		Gps1.Stop
		Ready = False
		GpsCheck = 1
	Else If indSpdType=7 Then
		If GpsCheck2 = 1 Then
			rp.CheckAndRequest(rp.PERMISSION_ACCESS_FINE_LOCATION)
			Wait For Activity_PermissionResult (Permission As String, Result As Boolean)
			GpsCheck2 = 0
			GpsStatus=Result
		End If
		If GpsStatus Then
		    If Gps1.GPSEnabled = False And GpsCheck=1 Then
	            ToastMessageShow("Please enable the GPS device.", True)
		    	StartActivity(Gps1.LocationSettingsIntent) 'Will open the relevant settings screen.
		    	GpsCheck = 0
		    Else If Gps1.GPSEnabled = False And GpsCheck=0 Then
		    	ToastMessageShow("GPS not enabled.", True)
	        End If
		    If Not(Ready) Then
		    	Gps1.Start(100,1)
		    	Ready = True
		    End If
		Else
			ToastMessageShow("Denied location access", True)
		End If
	End If
	If indSpdType < 0 Then
	Else If indSpdType = 0 Then
		If xx > 340dip Or sc > 1 Then
			btnSpdType.Text = "Airspeed TAS"
		Else
			btnSpdType.Text = "TAS"
		End If
		edtSpd.Hint = "Speed"
		btnSpdUnit.Visible = True
		btnSpdDelta.Visible = False
		edtSpd.Width = 27%x 
		edtSpdDelta.Visible = False
	Else If indSpdType = 1 Then
		If xx > 340dip Or sc > 1 Then
			btnSpdType.Text = "Airspeed CAS"
		Else
			btnSpdType.Text = "CAS"
		End If
		edtSpd.Hint = "Speed"
		btnSpdUnit.Visible = True
		btnSpdDelta.Visible = False
		edtSpd.Width = 27%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 2 Then
		If xx > 340dip Or sc > 1 Then
			btnSpdType.Text = "Airspeed EAS"
		Else
			btnSpdType.Text = "EAS"
		End If
		edtSpd.Hint = "Speed"
		btnSpdUnit.Visible = True
		btnSpdDelta.Visible = False
		edtSpd.Width = 27%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 3 Then
		btnSpdType.Text = "Mach"
		If sc > 1 Or ld = 1 Or xx>300dip Then
			edtSpd.Hint = "Mach Number"
		Else
			edtSpd.Hint = "Mach"
		End If
		btnSpdUnit.Visible = False
		btnSpdDelta.Visible = False
		edtSpd.Width = 47%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 4 Then
		edtSpd.Hint = "Lift Coefficient"
		btnSpdType.Text = MakeSubscript("C", "L", "")
		btnSpdUnit.Visible = False
		btnSpdDelta.Visible = False
		edtSpd.Width = 47%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 5 Then
		If xx > 340dip Or sc > 1 Then
			btnSpdType.Text = MakeSubscript("V", "s", " Factor")
			edtSpd.Hint = "Factor"
		Else
			btnSpdType.Text = MakeSubscript("V", "s", " Fact")
			edtSpd.Hint = "Fact"
		End If
		btnSpdUnit.Visible = False
		btnSpdDelta.Visible = True
		edtSpd.Width = 13%x
		edtSpdDelta.Visible = True
	Else If indSpdType = 6 Then
		If xx > 340dip Or sc > 1 Then
			btnSpdType.Text = "Ground Speed"
		Else
			btnSpdType.Text = "Grnd Speed"
		End If
		edtSpd.Hint = "Speed"
		btnSpdUnit.Visible = True
		btnSpdDelta.Visible = False
		edtSpd.Width = 27%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 7 Then
		If xx > 340dip Or sc > 1 Then
			btnSpdType.Text = "Ground Speed"
		Else
			btnSpdType.Text = "Grnd Speed"
		End If
		btnSpdUnit.Visible = True
		edtSpd.Text = NumberFormat2(GPSspeed / kSpd, 1, 1, 1, False)
		btnSpdDelta.Visible = False
		edtSpd.Width = 27%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 8 Then
		If xx > 340dip Or sc > 1 Then
			btnSpdType.Text = "Dynamic Pressure"
			edtSpd.Hint = "Dyn. Pressure"
		Else
			btnSpdType.Text = "q"
			edtSpd.Hint = "Dynamic Pressure"
		End If
		btnSpdUnit.Visible = True
		btnSpdDelta.Visible = False
		edtSpd.Width = 27%x
		edtSpdDelta.Visible = False
	Else If indSpdType = 9 Then
		If xx > 340dip Or sc > 1 Then
			btnSpdType.Text = "Impact Pressure"
			edtSpd.Hint = "Imp. Pressure"
		Else
			btnSpdType.Text = MakeSubscript("q", "c", "")
			edtSpd.Hint = "Impact Pressure"
		End If
		btnSpdUnit.Visible = True
		btnSpdDelta.Visible = False
		edtSpd.Width = 27%x
		edtSpdDelta.Visible = False
	End If
	SpdUnit_Click
End Sub

Sub SpdUnit_Click
	If indSpdType < 8 Then
		If indSpdUnit < 0 Then
		Else If indSpdUnit = 0 Then
			btnSpdUnit.Text = "kt"
			kSpd = 1852/3600
		Else If indSpdUnit = 1 Then
			btnSpdUnit.Text = "m/s"
			kSpd = 1
		Else If indSpdUnit = 2 Then
			btnSpdUnit.Text = "km/h"
			kSpd = 1/3.6
		Else If indSpdUnit = 3 Then
			btnSpdUnit.Text = "mph"
			kSpd = 0.44704
		Else If indSpdUnit = 4 Then
			btnSpdUnit.Text = "ft/s"
			kSpd = 0.3048
		End If
	Else
		If indSpdUnit < 0 Then
		Else If indSpdUnit = 0 Then
			btnSpdUnit.Text = "mbar"
			kSpd = 100
		Else If indSpdUnit = 1 Then
			btnSpdUnit.Text = "Pa"
			kSpd = 1
		Else If indSpdUnit = 2 Then
			btnSpdUnit.Text = "hPa"
			kSpd = 100
		Else If indSpdUnit = 3 Then
			btnSpdUnit.Text = "atm"
			kSpd = 101325
		Else If indSpdUnit = 4 Then
			btnSpdUnit.Text = "mmHg"
			kSpd = 133.3223684
		Else If indSpdUnit = 5 Then
			btnSpdUnit.Text = "psi"
			kSpd = 6894.75729
		End If
	End If
	If indSpdType=7 Then
		edtSpd.Text = NumberFormat2(GPSspeed / kSpd, 1, 1, 1, False)
	End If
	
End Sub

Sub Weight_Click
	Dim w As String
	Dim count As Int: count=0
	Dim ii As Int
	If indWeightType = 0 Then
		btnWeight.Text = "Weight"
		edtWeight.Text = ""
	Else
		For ii=1 To 6
			w = a.GetDefault(ID_inp & "_W" & ii,"")
			If w.CompareTo("") <> 0 And w.CompareTo("null") <> 0 Then
			count = count + 1
			End If
			If count=indWeightType Then Exit
		Next
		If ii = 1 Then
			btnWeight.Text  = "MTOW"
		Else If ii = 2 Then
			btnWeight.Text  = "MLW"
		Else If ii = 3 Then
			btnWeight.Text  = "MZFW"
		Else If ii = 4 Then
			btnWeight.Text  = "BOW"
		Else If ii = 5 Then
			btnWeight.Text  = "Heavy"
		Else If ii = 6 Then
			btnWeight.Text  = "Light"
		End If
		edtWeight.Text = a.GetDefault(ID_inp & "_W" & ii,"")
		indWeightUnit = a.Get(ID_inp & "_Wunit")
		WeightUnit_Click
	End If
End Sub

