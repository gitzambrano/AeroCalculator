		a.Put(ii & "_F9", a.GetDefault((ID_add) & "_F9",""))
		a.Put(ii & "_F10", a.GetDefault((ID_add) & "_F10",""))
		a.Put(ii & "_F11", a.GetDefault((ID_add) & "_F11",""))
		a.Put(ii & "_F12", a.GetDefault((ID_add) & "_F12",""))
		a.Put(ii & "_F13", a.GetDefault((ID_add) & "_F13",""))
		a.Put(ii & "_Sunit", a.Get((ID_add) & "_Sunit"))
		a.Put(ii & "_cunit", a.Get((ID_add) & "_cunit"))
		a.Put(ii & "_Wunit", a.Get((ID_add) & "_Wunit"))
		a.Put("N", (N + 1))
		lst.AddCustomItem(ii, CreateItem(ii, He, ii), He)
		lst.ResizePanel
		File.WriteMap(rp.GetSafeDirDefaultExternal(""), "airplanes.txt", a)
		spnAirp.Add(a.Get(ii & "_Name"))
		Dim ListAirp As List
		ListAirp.Initialize
		ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems-1)
		File.WriteList(rp.GetSafeDirDefaultExternal(""), "taglist.txt", ListAirp)
		lst.DividerColor = ColorPnlLine3
		
