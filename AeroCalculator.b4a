Sub spnAirp_ItemClick (Position As Int, Value As Object)
	
	Dim ListAirp As List
	ListAirp.Initialize
	ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems-1)
	
	If spinnerPos<>Position Then
	indWeightType = 0
	indCLmaxType = 0
	Weight_Click
	CLmax_Click
	End If
	
	spinnerPos = Position
	
	If Position = 0 Then
	Else
		ID_inp = ListAirp.Get(Position-1)
		edtSref.Text = a.Get(ID_inp & "_S")
		edtcref.Text = a.Get(ID_inp & "_c")
	
		WeightS.Clear
		WeightS.Add("Custom Mass")
		Dim w1, w2, w3, w4, w5, w6 As String
		w1 = a.GetDefault(ID_inp & "_W1","")
		w2 = a.GetDefault(ID_inp & "_W2","")
		w3 = a.GetDefault(ID_inp & "_W3","")
		w4 = a.GetDefault(ID_inp & "_W4","")
		w5 = a.GetDefault(ID_inp & "_W5","")
		w6 = a.GetDefault(ID_inp & "_W6","")
		If w1.CompareTo("")<>0 Then
			WeightS.Add("MTOW")
		End If
		If w2.CompareTo("")<>0 Then
			WeightS.Add("MLW")
		End If
		If w3.CompareTo("")<>0 Then
			WeightS.Add("MZFW")
		End If
		If w4.CompareTo("")<>0 Then
			WeightS.Add("BOW")
		End If
		If w5.CompareTo("")<>0 Then
			WeightS.Add("Heavy")
		End If
		If w6.CompareTo("")<>0 Then
			WeightS.Add("Light")
		End If
		
		CLmaxS.Clear
		CLmaxS.Add("Custom CLmax")
		Dim f0,f1, f2, f3, f4,f5,f6,f7,f8,f9,f10,f11,f12,f13 As String
		f0 = a.GetDefault(ID_inp & "_F0","")
		f1 = a.GetDefault(ID_inp & "_F1","")
		f2 = a.GetDefault(ID_inp & "_F2","")
		f3 = a.GetDefault(ID_inp & "_F3","")
		f4 = a.GetDefault(ID_inp & "_F4","")
		f5 = a.GetDefault(ID_inp & "_F5","")
		f6 = a.GetDefault(ID_inp & "_F6","")
		f7 = a.GetDefault(ID_inp & "_F7","")
		f8 = a.GetDefault(ID_inp & "_F8","")
		f9 = a.GetDefault(ID_inp & "_F9","")
		f10 = a.GetDefault(ID_inp & "_F10","")
		f11 = a.GetDefault(ID_inp & "_F11","")
		f12 = a.GetDefault(ID_inp & "_F12","")
		f13 = a.GetDefault(ID_inp & "_F13","")

		If f0.CompareTo("")<>0 And f0.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 0")
		End If
		If f1.CompareTo("")<>0 And f1.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 1")
		End If
		If f2.CompareTo("")<>0 And f2.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 2")
		End If
		If f3.CompareTo("")<>0 And f3.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 3")
		End If
		If f4.CompareTo("")<>0 And f4.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 4")
		End If
		If f5.CompareTo("")<>0 And f5.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 5")
		End If
		If f6.CompareTo("")<>0 And f6.CompareTo("null")<>0  Then
			CLmaxS.Add("Flap 6")
		End If
		If f7.CompareTo("")<>0 And f7.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 7")
		End If
		If f8.CompareTo("")<>0 And f8.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 8")
		End If
		If f9.CompareTo("")<>0 And f9.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 9")
		End If
		If f10.CompareTo("")<>0 And f10.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 10")
		End If
		If f11.CompareTo("")<>0 And f11.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 11")
		End If
		If f12.CompareTo("")<>0 And f12.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 12")
		End If
		If f13.CompareTo("")<>0 And f13.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 13")
		End If
		
		indSrefUnit = a.Get(ID_inp & "_Sunit")
		indcrefUnit = a.Get(ID_inp & "_cunit")
		indWeightUnit = a.Get(ID_inp & "_Wunit")
		SrefUnit_Click
		crefUnit_Click
		WeightUnit_Click
	End If

End Sub

Sub btnAltType_Click
	Dim Alts() As String
	Alts = Array As String("Pressure Altitude","Geometric Altitude","Altitude from GPS","Pressure","Pressure from Sensor")
	Dim record As Int = indAltType
	InputListAsync(Alts, "Choose the Type of Altitude", record,True)
	Wait For InputList_Result (Index As Int)
	If Index=DialogResponse.Cancel Then
		indAltType = record
	Else
		indAltType = Index
	End If
	If indAltType <> record Then
		edtAlt.Text=""
	End If
AltType_Click
End Sub

Sub btnAltUnit_Click
	Dim AltUnits() As String
	If indAltType=0 Or indAltType=1 Or indAltType=2 Then
		AltUnits = Array As String("ft", "m", "km", "nm", "mi", "in")
		InputListAsync(AltUnits, "Choose the Unit of Altitude", indAltUnit,True)
		Wait For InputList_Result (Index As Int)
		If Index <> DialogResponse.CANCEL Then
			indAltUnit = Index
		End If
	Else If indAltType=3 Or indAltType=4 Then
		AltUnits = Array As String("mbar", "Pa", "hPa", "atm", "mmHg", "psi")
		InputListAsync(AltUnits, "Choose the Unit of Pressure", indAltUnit,True)
		Wait For InputList_Result (Index As Int)
		If Index <> DialogResponse.CANCEL Then
			indAltUnit = Index
		End If
	End If
AltUnit_Click
End Sub

