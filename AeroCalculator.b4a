		pnlanim=lst.FindPanelWithID(ii)
		Dim a2 As Animation
		a2.InitializeAlpha("a2",0,1)
		a2.Duration = 900
		a2.Start(pnlanim)
		
	End Select
	Return True
End Sub

Sub lst_LongClick(pnl As Panel, ID As Object)
	VibrateTap
	lst.StartDragAndDrop(pnl, "lst_AfterDrop")
End Sub

Sub lst_AfterDrop(StartPosition As Int, EndPosition As Int)
	Dim ListAirp As List
	ListAirp.Initialize
	If lst.NumberOfItems > 0 Then
		ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems - 1)
		File.WriteList(rp.GetSafeDirDefaultExternal(""), "taglist.txt", ListAirp)
	End If
	RefreshAirplanesList
End Sub

Sub lst_Click(pnl As Panel, ID As Object)
	Dim now As Long = DateTime.Now
	Dim thisID As Int = ID
	If thisID = lastAirpClickID And (now - lastAirpClickTime) < 400 Then
		lastAirpClickTime = 0
		lastAirpClickID = -1
		SelectAirplane(thisID)
	Else
		lastAirpClickTime = now
		lastAirpClickID = thisID
	End If
End Sub

Public Sub SelectAirplane(ID As Int)
	Dim ListAirp As List
	ListAirp.Initialize
	If lst.NumberOfItems > 0 Then
		ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems - 1)
	Else If File.Exists(rp.GetSafeDirDefaultExternal(""), "taglist.txt") Then
		ListAirp = File.ReadList(rp.GetSafeDirDefaultExternal(""), "taglist.txt")
	End If
	Dim pos As Int = ListAirp.IndexOf(ID)
	If pos >= 0 Then
		spnAirp.SelectedIndex = pos + 1
		spnAirp_ItemClick(pos + 1, spnAirp.SelectedItem)
		VibrateTap
		RefreshAirplanesList
		pager.GotoPage(1, True)
	End If
End Sub

Sub SpinnerCreate
	spnAirp.Width = panelspn.Width
	spnAirp.Height = panelspn.Height
	panelspn.AddView(spnAirp, 0, 0, panelspn.Width, panelspn.Height)
	spnAirp.TextColor = ColorEdtText
	spnAirp.DropdownTextColor = ColorEdtText
	spnAirp.DropdownBackgroundColor = ColorPnlInput5
	ConfigureAirplaneSpinner(spnAirp)

	Dim lblSpnChevron As Label
	lblSpnChevron.Initialize("lblSpnChevron")
	lblSpnChevron.Text = Chr(9662)
	lblSpnChevron.TextSize = 10 * sc
	lblSpnChevron.TextColor = ColorEdtText
	lblSpnChevron.Gravity = Bit.Or(Gravity.CENTER_VERTICAL, Gravity.CENTER_HORIZONTAL)
	panelspn.AddView(lblSpnChevron, panelspn.Width - 18dip * sc, 0, 16dip * sc, panelspn.Height)
End Sub

Sub lblSpnChevron_Click
	Try
		Dim jo As JavaObject = spnAirp
		jo.RunMethod("performClick", Null)
	Catch
		Log("spn click: " & LastException.Message)
	End Try
End Sub

Sub spnAirp_ItemClick (Position As Int, Value As Object)
	
	Dim ListAirp As List
	ListAirp.Initialize
	ListAirp = lst.CreateTagList(0, 0, lst.NumberOfItems-1)
	
	If spinnerPos<>Position Then
	indWeightType = 0
	indCLmaxType = 0
	Weight_Click
	CLmax_Click
	End If
	
	spinnerPos = Position
	ConfigureAirplaneSpinner(spnAirp)
	
	If Position = 0 Then
	Else
		ID_inp = ListAirp.Get(Position-1)
		ID_use = ID_inp
		edtSref.Text = a.Get(ID_inp & "_S")
		edtcref.Text = a.Get(ID_inp & "_c")
	
		WeightS.Clear
		WeightS.Add("Custom Mass|Manual mass entry")
		Dim w1, w2, w3, w4, w5, w6 As String
		w1 = a.GetDefault(ID_inp & "_W1","")
		w2 = a.GetDefault(ID_inp & "_W2","")
		w3 = a.GetDefault(ID_inp & "_W3","")
		w4 = a.GetDefault(ID_inp & "_W4","")
		w5 = a.GetDefault(ID_inp & "_W5","")
		w6 = a.GetDefault(ID_inp & "_W6","")
		If w1.CompareTo("")<>0 Then
			WeightS.Add("MTOW|Maximum takeoff weight")
		End If
		If w2.CompareTo("")<>0 Then
			WeightS.Add("MLW|Maximum landing weight")
		End If
		If w3.CompareTo("")<>0 Then
			WeightS.Add("MZFW|Maximum zero fuel weight")
		End If
		If w4.CompareTo("")<>0 Then
			WeightS.Add("BOW|Basic operational weight")
		End If
		If w5.CompareTo("")<>0 Then
			WeightS.Add("Heavy|Heavy configuration weight")
		End If
		If w6.CompareTo("")<>0 Then
			WeightS.Add("Light|Light configuration weight")
		End If
		
		CLmaxS.Clear
		CLmaxS.Add("Custom Maximum Lift Coefficient|User-defined maximum lift coefficient")
		Dim f0,f1, f2, f3, f4,f5,f6,f7,f8,f9,f10,f11,f12,f13 As String
		f0 = a.GetDefault(ID_inp & "_F0","")
		f1 = a.GetDefault(ID_inp & "_F1","")
		f2 = a.GetDefault(ID_inp & "_F2","")
		f3 = a.GetDefault(ID_inp & "_F3","")
		f4 = a.GetDefault(ID_inp & "_F4","")
		f5 = a.GetDefault(ID_inp & "_F5","")
		f6 = a.GetDefault(ID_inp & "_F6","")
		f7 = a.GetDefault(ID_inp & "_F7","")
		f8 = a.GetDefault(ID_inp & "_F8","")
		f9 = a.GetDefault(ID_inp & "_F9","")
		f10 = a.GetDefault(ID_inp & "_F10","")
		f11 = a.GetDefault(ID_inp & "_F11","")
		f12 = a.GetDefault(ID_inp & "_F12","")
		f13 = a.GetDefault(ID_inp & "_F13","")

		If f0.CompareTo("")<>0 And f0.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 0 (clean)|Flap 0 (clean configuration) maximum lift coefficient")
		End If
		If f1.CompareTo("")<>0 And f1.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 1|Flap 1 maximum lift coefficient")
		End If
		If f2.CompareTo("")<>0 And f2.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 2|Flap 2 maximum lift coefficient")
		End If
		If f3.CompareTo("")<>0 And f3.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 3|Flap 3 maximum lift coefficient")
		End If
		If f4.CompareTo("")<>0 And f4.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 4|Flap 4 maximum lift coefficient")
		End If
		If f5.CompareTo("")<>0 And f5.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 5|Flap 5 maximum lift coefficient")
		End If
		If f6.CompareTo("")<>0 And f6.CompareTo("null")<>0  Then
			CLmaxS.Add("Flap 6|Flap 6 maximum lift coefficient")
		End If
		If f7.CompareTo("")<>0 And f7.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 7|Flap 7 maximum lift coefficient")
		End If
		If f8.CompareTo("")<>0 And f8.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 8|Flap 8 maximum lift coefficient")
		End If
		If f9.CompareTo("")<>0 And f9.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 9|Flap 9 maximum lift coefficient")
		End If
		If f10.CompareTo("")<>0 And f10.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 10|Flap 10 maximum lift coefficient")
		End If
		If f11.CompareTo("")<>0 And f11.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 11|Flap 11 maximum lift coefficient")
		End If
		If f12.CompareTo("")<>0 And f12.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 12|Flap 12 maximum lift coefficient")
		End If
		If f13.CompareTo("")<>0 And f13.CompareTo("null")<>0 Then
			CLmaxS.Add("Flap 13|Flap 13 maximum lift coefficient")
		End If
		
		indSrefUnit = a.Get(ID_inp & "_Sunit")
		indcrefUnit = a.Get(ID_inp & "_cunit")
		indWeightUnit = a.Get(ID_inp & "_Wunit")
		SrefUnit_Click
		crefUnit_Click
		WeightUnit_Click
	End If

End Sub

