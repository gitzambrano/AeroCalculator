			edtSpdDelta.HintColor = ColorEdtHint
			edtSpdDelta.Typeface = Typeface.DEFAULT_BOLD
			edtSpdDelta.Visible = False
			btnSpdType.TextColor = ColorButText1
			btnSpdUnit.TextColor = ColorButText1
			btnSpdDelta.TextColor = ColorButText1
			'SetNinePatchButton2(edtSpd, "apptheme_textfield_default_holo_light","","", "apptheme_textfield_activated_holo_light","")
			'SetNinePatchButton2(edtSpdDelta, "apptheme_textfield_default_holo_light","","", "apptheme_textfield_activated_holo_light","")
