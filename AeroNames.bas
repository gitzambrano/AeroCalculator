' Help texts, maintained by hand. Keep in sync with web/src/catalog.ts and docs/quantity_catalog.json.
' tools/generate_latex_assets.js renders the Equation entries into Files/katex/eq.
Sub Process_Globals
End Sub
Public Sub Help(Key As String) As String
    Select Key
    Case "Hp"
        Return "Pressure altitude / H_P" & CRLF & CRLF & "Definition: Pressure altitude: altitude in the ISA atmosphere corresponding to the entered static pressure." & CRLF & CRLF & "Equation: p_{\mathrm{ISA}}(H_P) = p" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Hydrostatic balance relates pressure to altitude in the layered ISA atmosphere. Inverting that pressure profile gives an equivalent pressure altitude, not a measurement of height above the ground."
    Case "Hg"
        Return "Geometric altitude / h" & CRLF & CRLF & "Definition: Geometric altitude: physical height above mean sea level." & CRLF & CRLF & "Equation: h = \frac{r_0 \, H}{r_0 - H}" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Geometric height measures distance above sea level. The spherical-Earth conversion accounts for weakening gravity when converting between geometric and geopotential altitude."
    Case "P"
        Return "Static pressure / p" & CRLF & CRLF & "Definition: Static atmospheric pressure. AeroCalculator converts it to pressure altitude." & CRLF & CRLF & "Equation: p = \rho \, R \, T" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: The ISA hydrostatic pressure profile represents the weight of the air column above the selected level. Local density then follows the ideal-gas relation using the entered temperature."
    Case "Δ ISA"
        Return "ISA temperature deviation / ΔT" & CRLF & CRLF & "Definition: Temperature deviation from the ISA temperature at the current pressure altitude." & CRLF & CRLF & "Equation: \Delta T = T - T_{\mathrm{ISA}}(H_P)" & CRLF & CRLF & "SI/reference unit: K" & CRLF & CRLF & "Model Physics: The temperature offset changes the local thermal state at the same pressure altitude. Warmer air at fixed pressure has lower density; colder air has higher density."
    Case "OAT"
        Return "Outside air temperature / OAT" & CRLF & CRLF & "Definition: Outside air temperature at the aircraft condition." & CRLF & CRLF & "Equation: T = T_{\mathrm{ISA}}(H_P) + \Delta T" & CRLF & CRLF & "SI/reference unit: K" & CRLF & CRLF & "Model Physics: Static air temperature sets density and sound speed. Adding the ISA temperature offset gives the local temperature without changing the selected pressure level."
    Case "TAS"
        Return "True airspeed / TAS" & CRLF & CRLF & "Definition: True Airspeed: aircraft speed relative to the surrounding air mass." & CRLF & CRLF & "Equation: \mathrm{TAS} = M \cdot a" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: True airspeed measures motion through the air mass. Combining it with local density sets dynamic pressure; combining it with local sound speed gives Mach number."
    Case "CAS"
        Return "Calibrated airspeed / CAS" & CRLF & CRLF & "Definition: Indicated airspeed corrected for instrument and position errors. CAS is related to impact pressure using standard sea-level references." & CRLF & CRLF & "Equation: \mathrm{CAS} = a_0 \sqrt{\frac{2}{\gamma - 1} \left[ \left( \frac{q_c}{p_0} + 1 \right)^{\frac{\gamma - 1}{\gamma}} - 1 \right]}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: CAS is the speed in standard sea-level air that produces the same pitot impact pressure. The subsonic isentropic conversion accounts for compression as the flow is brought to rest."
    Case "EAS"
        Return "Equivalent airspeed / EAS" & CRLF & CRLF & "Definition: Equivalent Airspeed: speed at standard sea-level density with the same dynamic pressure as the current flight condition." & CRLF & CRLF & "Equation: \mathrm{EAS} = \mathrm{TAS} \sqrt{\frac{\rho}{\rho_0}}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: EAS preserves dynamic pressure when replacing the actual density with standard sea-level density. Equal EAS gives equal aerodynamic force for the same area and lift coefficient."
    Case "Mach"
        Return "Mach number / M" & CRLF & CRLF & "Definition: Mach number: True Airspeed divided by the local speed of sound." & CRLF & CRLF & "Equation: M = \frac{\mathrm{TAS}}{a}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: Mach compares airspeed with the speed of pressure disturbances in the local air. The pitot conversion used here describes subsonic, isentropic deceleration with gamma = 1.4."
    Case "CL"
        Return "Lift coefficient / C_L" & CRLF & CRLF & "Definition: Lift coefficient. With mass, load factor and reference area, it defines the required dynamic pressure." & CRLF & CRLF & "Equation: C_L = \frac{n \cdot m \cdot g_0}{q \cdot S_{\mathrm{REF}}}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The lift equation balances aerodynamic lift against the selected normal load, n times weight. Increasing mass or load factor requires more dynamic pressure or a larger lift coefficient."
    Case "Vs Factor"
        Return "Stall speed factor / V_S factor" & CRLF & CRLF & "Definition: Multiplier applied to the 1-g calibrated stall speed. The optional +Δ term is added in knots." & CRLF & CRLF & "Equation: \mathrm{CAS} = \mathrm{factor} \times V_{S,\mathrm{CAS}} + \Delta \mathrm{CAS}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The multiplier scales the 1-g stall reference expressed as CAS; the optional delta adds a fixed speed in knots. It specifies a speed margin and does not by itself prescribe a maneuver load factor."
    Case "Ground Speed"
        Return "Ground speed / GS" & CRLF & CRLF & "Definition: Aircraft speed relative to the ground: the air-relative velocity plus the wind." & CRLF & CRLF & "Equation: V_{\mathrm{ground}} = V_{\mathrm{air}} + V_{\mathrm{wind}}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: The ground-velocity vector is the sum of air-relative velocity and wind velocity. Directions and sideslip determine the vector components; scalar speeds cannot simply be added for arbitrary wind angles."
    Case "Qdyn"
        Return "Dynamic pressure / q" & CRLF & CRLF & "Definition: Dynamic pressure q = ½ρ·TAS²." & CRLF & CRLF & "Equation: q = \frac{1}{2} \rho \, \mathrm{TAS}^2" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: Dynamic pressure is kinetic energy per unit volume of moving air. It scales aerodynamic forces and rises with density and the square of true airspeed."
    Case "Qc"
        Return "Impact pressure / q_c" & CRLF & CRLF & "Definition: Impact pressure equals total pressure minus static pressure for the documented subsonic model." & CRLF & CRLF & "Equation: q_c = p \left[ \left( 1 + \frac{\gamma - 1}{2} M^2 \right)^{\frac{\gamma}{\gamma - 1}} - 1 \right]" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: A pitot opening brings the flow to rest and converts kinetic energy into compression. Impact pressure is stagnation minus static pressure; it approaches dynamic pressure at low Mach number."
    Case "Weight"
        Return "Aircraft mass / m" & CRLF & CRLF & "Definition: Aircraft mass used for lift, stall-speed and maneuver calculations." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: The entered quantity is mass; multiplying by standard gravity gives weight. The selected normal load factor then sets the lift required by the maneuver."
    Case "Sref"
        Return "Wing reference area / S_{REF}" & CRLF & CRLF & "Definition: Wing reference area used in aerodynamic force and coefficient calculations." & CRLF & CRLF & "Equation: L = q \, S_{\mathrm{REF}} \, C_L" & CRLF & CRLF & "SI/reference unit: m²" & CRLF & CRLF & "Model Physics: Reference area is the chosen normalization area in the lift equation. A larger area produces more lift at the same dynamic pressure and lift coefficient; it does not determine wing shape."
    Case "cref"
        Return "Reference chord / c_{REF}" & CRLF & CRLF & "Definition: Wing reference chord used to calculate Reynolds number." & CRLF & CRLF & "Equation: \mathrm{Re} = \frac{\rho \, \mathrm{TAS} \, c_{\mathrm{REF}}}{\mu}" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Reference chord sets the length scale for Reynolds number. Comparing inertial transport with molecular viscosity at that scale characterizes the flow regime; this calculation does not predict transition or separation."
    Case "CLmax"
        Return "Maximum lift coefficient / C_{L,MAX}" & CRLF & CRLF & "Definition: Maximum lift coefficient used to calculate the 1-g stall speed." & CRLF & CRLF & "Equation: V_{S,\mathrm{TAS}} = \sqrt{\frac{2 \, m \, g_0}{\rho \, S_{\mathrm{REF}} \, C_{L,\mathrm{MAX}}}}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The limiting lift coefficient sets the lowest 1-g speed that can support the aircraft weight. Its value must come from aircraft data for the chosen flap configuration; the calculator does not predict it from geometry."
    Case "NzPullup"
        Return "Pull-up load factor / N_Z" & CRLF & CRLF & "Definition: Normal load factor for a pull-up maneuver. Bank angle is zero." & CRLF & CRLF & "Equation: L = n \cdot m \cdot g_0" & CRLF & CRLF & "SI/reference unit: g" & CRLF & CRLF & "Model Physics: Normal load factor is lift divided by weight. The unbanked pull-up model increases lift demand without introducing the bank relation used for a level turn."
    Case "NzTurn"
        Return "Level turn load factor / N_Z" & CRLF & CRLF & "Definition: Normal load factor in a coordinated level turn. Bank angle is derived from n = 1/cos(φ)." & CRLF & CRLF & "Equation: n = \frac{1}{\cos \varphi}" & CRLF & CRLF & "SI/reference unit: g" & CRLF & CRLF & "Model Physics: In a coordinated level turn, the vertical component of lift balances weight and the horizontal component provides centripetal acceleration. This gives n = 1/cos(bank), with bank magnitude below 90 degrees."
    Case "BankTurn"
        Return "Level turn bank angle / φ" & CRLF & CRLF & "Definition: Bank angle for a coordinated level turn. Load factor is derived from n = 1/cos(φ)." & CRLF & CRLF & "Equation: n = \frac{1}{\cos \varphi}" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: In a coordinated level turn, the vertical component of lift balances weight and the horizontal component provides centripetal acceleration. This gives n = 1/cos(bank), with bank magnitude below 90 degrees."
    Case "Track"
        Return "Ground track angle / χ" & CRLF & CRLF & "Definition: Track angle: direction of the ground-velocity vector." & CRLF & CRLF & "Equation: \vec{V}_{\mathrm{ground}} = \vec{V}_{\mathrm{air}} + \vec{V}_{\mathrm{wind}}" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: Track is the direction of the ground-velocity vector. Wind shifts it away from the air-relative direction through the horizontal wind triangle."
    Case "Heading"
        Return "Aircraft heading / ψ" & CRLF & CRLF & "Definition: Heading angle: direction the aircraft longitudinal axis points." & CRLF & CRLF & "Equation: \psi = \chi + \mathrm{drift}" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: Heading describes the aircraft longitudinal axis. Sideslip relates that axis to the air-relative velocity, and wind then determines the ground track."
    Case "Sideslip"
        Return "Sideslip angle / β" & CRLF & CRLF & "Definition: Sideslip angle β: angle between the aircraft heading and the air-relative velocity direction." & CRLF & CRLF & "Equation: \beta = \angle\left(\psi,\ \vec{V}_{\mathrm{air}}\right)" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: Sideslip is the angular difference between the aircraft axis and its air-relative motion. The wind triangle uses it to orient the airspeed vector; it does not calculate side force or yaw dynamics."
    Case "Drift"
        Return "Drift angle / drift" & CRLF & CRLF & "Definition: Drift angle: heading minus track." & CRLF & CRLF & "Equation: \mathrm{drift} = \psi - \chi" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: Drift is heading minus ground track. It combines the effects of wind and the selected sideslip rather than describing a force or an aerodynamic coefficient."
    Case "HeadWind"
        Return "Reference headwind / HW" & CRLF & CRLF & "Definition: Wind component along the selected runway/reference direction. Positive means headwind." & CRLF & CRLF & "Equation: \mathrm{HW} = V_W \cos(\psi_W - \psi_{\mathrm{RWY}})" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: Projecting wind onto the selected runway axis gives the headwind component. A positive value opposes motion along that axis; a negative value is tailwind."
    Case "Wind Speed"
        Return "Wind speed / V_W" & CRLF & CRLF & "Definition: Wind-vector magnitude. Use Wind Direction for its direction." & CRLF & CRLF & "Equation: V_W = \sqrt{\mathrm{HW}^2 + \mathrm{CW}^2}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: Wind speed is the magnitude of the horizontal wind vector. Resolving or combining its perpendicular components preserves that vector magnitude."
    Case "CrossWind"
        Return "Reference crosswind / CW" & CRLF & CRLF & "Definition: Wind component perpendicular to the selected runway/reference direction." & CRLF & CRLF & "Equation: \mathrm{CW} = V_W \sin(\psi_W - \psi_{\mathrm{RWY}})" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: Projecting wind onto the axis perpendicular to the runway gives the signed crosswind component. Together with headwind it reconstructs the horizontal wind vector."
    Case "Runway Angle"
        Return "Runway reference angle / RWY" & CRLF & CRLF & "Definition: Reference direction used to resolve headwind and crosswind components." & CRLF & CRLF & "Equation: \psi_{\mathrm{RWY}} = \text{runway heading}" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: The runway/reference direction defines the axes for headwind and crosswind. Rotating those axes changes the components without changing the physical wind vector."
    Case "Wind Direction"
        Return "Wind direction from / wind from" & CRLF & CRLF & "Definition: Direction the wind blows from (meteorological wind-from convention)." & CRLF & CRLF & "Equation: \psi_W = \text{meteorological wind direction}" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: Wind direction follows the meteorological convention: the direction the wind comes from. The velocity vector points the opposite way; zero wind has no physical direction."
    Case "Pressure Altitude"
        Return "Pressure altitude / H_P" & CRLF & CRLF & "Definition: Pressure altitude: altitude in the ISA atmosphere corresponding to the entered static pressure." & CRLF & CRLF & "Equation: p_{\mathrm{ISA}}(H_P) = p" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Hydrostatic balance relates pressure to altitude in the layered ISA atmosphere. Inverting that pressure profile gives an equivalent pressure altitude, not a measurement of height above the ground."
    Case "Geometric Altitude"
        Return "Geometric altitude / h" & CRLF & CRLF & "Definition: Geometric altitude: physical height above mean sea level." & CRLF & CRLF & "Equation: h = \frac{r_0 \, H}{r_0 - H}" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Geometric height measures distance above sea level. The spherical-Earth conversion accounts for weakening gravity when converting between geometric and geopotential altitude."
    Case "Pressure"
        Return "Static pressure / p" & CRLF & CRLF & "Definition: Static atmospheric pressure. AeroCalculator converts it to pressure altitude." & CRLF & CRLF & "Equation: p = \rho \, R \, T" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: The ISA hydrostatic pressure profile represents the weight of the air column above the selected level. Local density then follows the ideal-gas relation using the entered temperature."
    Case "Temperature"
        Return "Outside air temperature / OAT" & CRLF & CRLF & "Definition: Outside air temperature at the aircraft condition." & CRLF & CRLF & "Equation: T = T_{\mathrm{ISA}}(H_P) + \Delta T" & CRLF & CRLF & "SI/reference unit: K" & CRLF & CRLF & "Model Physics: Static air temperature sets density and sound speed. Adding the ISA temperature offset gives the local temperature without changing the selected pressure level."
    Case "Delta ISA"
        Return "ISA temperature deviation / ΔT" & CRLF & CRLF & "Definition: Temperature deviation from the ISA temperature at the current pressure altitude." & CRLF & CRLF & "Equation: \Delta T = T - T_{\mathrm{ISA}}(H_P)" & CRLF & CRLF & "SI/reference unit: K" & CRLF & CRLF & "Model Physics: The temperature offset changes the local thermal state at the same pressure altitude. Warmer air at fixed pressure has lower density; colder air has higher density."
    Case "True Airspeed"
        Return "True airspeed / TAS" & CRLF & CRLF & "Definition: True Airspeed: aircraft speed relative to the surrounding air mass." & CRLF & CRLF & "Equation: \mathrm{TAS} = M \cdot a" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: True airspeed measures motion through the air mass. Combining it with local density sets dynamic pressure; combining it with local sound speed gives Mach number."
    Case "Calibrated Airspeed"
        Return "Calibrated airspeed / CAS" & CRLF & CRLF & "Definition: Indicated airspeed corrected for instrument and position errors. CAS is related to impact pressure using standard sea-level references." & CRLF & CRLF & "Equation: \mathrm{CAS} = a_0 \sqrt{\frac{2}{\gamma - 1} \left[ \left( \frac{q_c}{p_0} + 1 \right)^{\frac{\gamma - 1}{\gamma}} - 1 \right]}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: CAS is the speed in standard sea-level air that produces the same pitot impact pressure. The subsonic isentropic conversion accounts for compression as the flow is brought to rest."
    Case "Equivalent Airspeed"
        Return "Equivalent airspeed / EAS" & CRLF & CRLF & "Definition: Equivalent Airspeed: speed at standard sea-level density with the same dynamic pressure as the current flight condition." & CRLF & CRLF & "Equation: \mathrm{EAS} = \mathrm{TAS} \sqrt{\frac{\rho}{\rho_0}}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: EAS preserves dynamic pressure when replacing the actual density with standard sea-level density. Equal EAS gives equal aerodynamic force for the same area and lift coefficient."
    Case "Lift Coefficient CL"
        Return "Lift coefficient / C_L" & CRLF & CRLF & "Definition: Lift coefficient. With mass, load factor and reference area, it defines the required dynamic pressure." & CRLF & CRLF & "Equation: C_L = \frac{n \cdot m \cdot g_0}{q \cdot S_{\mathrm{REF}}}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The lift equation balances aerodynamic lift against the selected normal load, n times weight. Increasing mass or load factor requires more dynamic pressure or a larger lift coefficient."
    Case "Dynamic Pressure"
        Return "Dynamic pressure / q" & CRLF & CRLF & "Definition: Dynamic pressure q = ½ρ·TAS²." & CRLF & CRLF & "Equation: q = \frac{1}{2} \rho \, \mathrm{TAS}^2" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: Dynamic pressure is kinetic energy per unit volume of moving air. It scales aerodynamic forces and rises with density and the square of true airspeed."
    Case "Impact Pressure"
        Return "Impact pressure / q_c" & CRLF & CRLF & "Definition: Impact pressure equals total pressure minus static pressure for the documented subsonic model." & CRLF & CRLF & "Equation: q_c = p \left[ \left( 1 + \frac{\gamma - 1}{2} M^2 \right)^{\frac{\gamma}{\gamma - 1}} - 1 \right]" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: A pitot opening brings the flow to rest and converts kinetic energy into compression. Impact pressure is stagnation minus static pressure; it approaches dynamic pressure at low Mach number."
    Case "Bank Angle φ"
        Return "Level turn bank angle / φ" & CRLF & CRLF & "Definition: Bank angle for a coordinated level turn. Load factor is derived from n = 1/cos(φ)." & CRLF & CRLF & "Equation: n = \frac{1}{\cos \varphi}" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: In a coordinated level turn, the vertical component of lift balances weight and the horizontal component provides centripetal acceleration. This gives n = 1/cos(bank), with bank magnitude below 90 degrees."
    Case "Track Angle"
        Return "Ground track angle / χ" & CRLF & CRLF & "Definition: Track angle: direction of the ground-velocity vector." & CRLF & CRLF & "Equation: \vec{V}_{\mathrm{ground}} = \vec{V}_{\mathrm{air}} + \vec{V}_{\mathrm{wind}}" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: Track is the direction of the ground-velocity vector. Wind shifts it away from the air-relative direction through the horizontal wind triangle."
    Case "Heading Angle Ψ"
        Return "Aircraft heading / ψ" & CRLF & CRLF & "Definition: Heading angle: direction the aircraft longitudinal axis points." & CRLF & CRLF & "Equation: \psi = \chi + \mathrm{drift}" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: Heading describes the aircraft longitudinal axis. Sideslip relates that axis to the air-relative velocity, and wind then determines the ground track."
    Case "Drift Angle"
        Return "Drift angle / drift" & CRLF & CRLF & "Definition: Drift angle: heading minus track." & CRLF & CRLF & "Equation: \mathrm{drift} = \psi - \chi" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: Drift is heading minus ground track. It combines the effects of wind and the selected sideslip rather than describing a force or an aerodynamic coefficient."
    Case "Sideslip Angle β"
        Return "Sideslip angle / β" & CRLF & CRLF & "Definition: Sideslip angle β: angle between the aircraft heading and the air-relative velocity direction." & CRLF & CRLF & "Equation: \beta = \angle\left(\psi,\ \vec{V}_{\mathrm{air}}\right)" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: Sideslip is the angular difference between the aircraft axis and its air-relative motion. The wind triangle uses it to orient the airspeed vector; it does not calculate side force or yaw dynamics."
    Case "Geopotential Altitude"
    ' H_G below is renderer markup: FormatScriptedText displays g as a subscript; the underscore is never shown.
        Return "Geopotential altitude / H_G" & CRLF & CRLF & "Definition: Effective gravitational altitude used by the standard atmosphere." & CRLF & CRLF & "Equation: H = \frac{r_0 \, h}{r_0 + h}" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Geopotential height expresses gravitational potential as an equivalent height at standard gravity. For pressure-altitude input, the temperature correction represents the changed thickness of a warmer or colder air column."
    Case "Density Altitude"
        Return "Density altitude / H_ρ" & CRLF & CRLF & "Definition: ISA altitude with the same density as the current condition." & CRLF & CRLF & "Equation: \rho_{\mathrm{ISA}}(H_\rho) = \rho" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Density altitude is the ISA level with the same air density as the current condition. It summarizes density effects on aerodynamic forces without claiming that the aircraft is physically at that height."
    Case "Temperature Altitude"
        Return "Temperature altitude / H_T" & CRLF & CRLF & "Definition: Altitude returned by the documented temperature-altitude convention. Temperature alone is not a unique altitude across all layers." & CRLF & CRLF & "Equation: T_{\mathrm{ISA}}(H_T) = T" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: This is a tropospheric temperature-equivalent height, using the ISA lapse rate. Temperatures at or below 216.65 K return 11 km in this convention; temperature alone cannot identify a unique altitude across all ISA layers."
    Case "Density"
        Return "Air density / ρ" & CRLF & CRLF & "Definition: Mass of air per unit volume." & CRLF & CRLF & "Equation: \rho = \frac{p}{R \, T}" & CRLF & CRLF & "SI/reference unit: kg/m³" & CRLF & CRLF & "Model Physics: The ideal-gas equation links density to static pressure and absolute temperature for dry air. At the same pressure, heating expands the air and reduces its mass per unit volume."
    Case "Total Temperature"
        Return "Total air temperature / TAT" & CRLF & CRLF & "Definition: Isentropic stagnation temperature for a calorically perfect gas." & CRLF & CRLF & "Equation: T_T = T \left( 1 + \frac{\gamma - 1}{2} M^2 \right)" & CRLF & CRLF & "SI/reference unit: K" & CRLF & CRLF & "Model Physics: Adiabatic deceleration converts kinetic energy into internal energy, raising temperature as the air is brought to rest. The ideal stagnation relation uses a constant specific-heat ratio of 1.4, without a probe recovery correction."
    Case "Viscosity"
        Return "Dynamic viscosity / μ" & CRLF & CRLF & "Definition: Dynamic viscosity from the documented temperature correlation." & CRLF & CRLF & "Equation: \mu = \mu_0 \, \frac{T_0 + C}{T + C} \left( \frac{T}{T_0} \right)^{3/2}" & CRLF & CRLF & "SI/reference unit: Pa·s" & CRLF & CRLF & "Model Physics: Sutherland correlation represents the temperature dependence of molecular momentum transport in air. Dynamic viscosity increases with temperature and supplies the viscous scale in Reynolds number."
    Case "Sound Speed"
        Return "Speed of sound / a" & CRLF & CRLF & "Definition: Local speed of sound in the ideal-gas model." & CRLF & CRLF & "Equation: a = \sqrt{\gamma \, R \, T}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: Small pressure disturbances propagate through ideal air at a speed set by absolute temperature and the specific-heat ratio. Warmer air has a higher sound speed."
    Case "Stall Speed Vs"
        Return "Reference stall speed / V_S" & CRLF & CRLF & "Definition: 1-g reference stall speed, independent of maneuver load factor. The TAS value from the equation is displayed as its CAS equivalent." & CRLF & CRLF & "Equation: V_{S,\mathrm{TAS}} = \sqrt{\frac{2 \, m \, g_0}{\rho \, S_{\mathrm{REF}} \, C_{L,\mathrm{MAX}}}}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: At the 1-g stall reference, maximum lift just balances weight. The result is converted from TAS to CAS; maneuver load factor does not alter this reference value."
    Case "Reynolds"
        Return "Reynolds number / Re" & CRLF & CRLF & "Definition: Ratio of inertial and viscous effects based on reference chord." & CRLF & CRLF & "Equation: \mathrm{Re} = \frac{\rho \, \mathrm{TAS} \, c_{\mathrm{REF}}}{\mu}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: Reynolds number compares inertial and viscous effects over the reference chord. Increasing speed, density, or chord increases this ratio; increasing viscosity reduces it."
    Case "Pressure Ratio δ"
        Return "Pressure ratio / δ" & CRLF & CRLF & "Definition: Pressure divided by standard sea-level pressure." & CRLF & CRLF & "Equation: \delta = \frac{p}{p_0}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: Dividing static pressure by standard sea-level pressure gives a dimensionless atmospheric pressure scale. It is used to normalize weight and compare conditions across pressure levels."
    Case "Density Ratio σ"
        Return "Density ratio / σ" & CRLF & CRLF & "Definition: Density divided by standard sea-level density." & CRLF & CRLF & "Equation: \sigma = \frac{\rho}{\rho_0}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The density ratio compares local air density with standard sea-level density. Its square root relates true and equivalent airspeed at equal dynamic pressure."
    Case "Temperature Ratio θ"
        Return "Temperature ratio / θ" & CRLF & CRLF & "Definition: Absolute temperature divided by standard sea-level temperature." & CRLF & CRLF & "Equation: \theta = \frac{T}{T_0}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The temperature ratio compares absolute local temperature with the standard sea-level temperature. Absolute temperature is required because molecular thermal energy sets sound speed and the ideal-gas density relation."
    Case "Total Pressure"
        Return "Total pressure / p_T" & CRLF & CRLF & "Definition: Stagnation pressure from the subsonic isentropic relation." & CRLF & CRLF & "Equation: p_T = p + q_c" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: Stagnation pressure is the pressure after ideal subsonic, isentropic deceleration to rest. Adding pitot impact pressure to static pressure gives this total pressure; shocks and flow losses are not modeled."
    Case "DynPressure * S / g"
        Return "Dynamic pressure force equivalent / qS/g_0" & CRLF & CRLF & "Definition: Dynamic pressure times reference area, expressed as force in kgf." & CRLF & CRLF & "Equation: \frac{q \cdot S_{\mathrm{REF}}}{g_0}" & CRLF & CRLF & "SI/reference unit: kgf" & CRLF & CRLF & "Model Physics: Dynamic pressure times reference area gives an aerodynamic force scale before multiplying by a force coefficient. Dividing by standard gravity expresses that force in kgf; it is not aircraft mass."
    Case "Lift Force"
        Return "Lift force / L" & CRLF & CRLF & "Definition: Lift required by the selected mass and maneuver, displayed in kgf." & CRLF & CRLF & "Equation: \frac{L}{g_0} = \frac{q \cdot S_{\mathrm{REF}} \cdot C_L}{g_0} = n \cdot m" & CRLF & CRLF & "SI/reference unit: kgf" & CRLF & CRLF & "Model Physics: Lift is dynamic pressure times reference area and lift coefficient, and equals the selected normal load times weight. The displayed kgf value converts that force using standard gravity."
    Case "Weight/Delta W/δ"
        Return "Weight divided by pressure ratio / W/δ" & CRLF & CRLF & "Definition: Weight normalized by pressure ratio, displayed in kgf." & CRLF & CRLF & "Equation: \frac{W}{\delta \cdot g_0} = \frac{m}{\delta}" & CRLF & CRLF & "SI/reference unit: kgf" & CRLF & CRLF & "Model Physics: Dividing weight by pressure ratio normalizes the aircraft load to standard sea-level pressure. The kgf display is a force normalization, not a change in the actual aircraft mass."
    Case "Load Factor Nz"
        Return "Normal load factor / N_Z" & CRLF & CRLF & "Definition: Selected normal load factor. In a coordinated level turn, the load factor follows the selected bank angle or determines the bank angle." & CRLF & CRLF & "Equation: n = \frac{L}{W} = \frac{1}{\cos \varphi}" & CRLF & CRLF & "SI/reference unit: g" & CRLF & CRLF & "Model Physics: Normal load factor measures lift relative to weight. In the level-turn mode it follows the vertical lift balance; in pull-up mode it is supplied directly."
    Case "Turn Radius"
        Return "Turn radius / r" & CRLF & CRLF & "Definition: Signed level-turn radius, unavailable at zero bank." & CRLF & CRLF & "Equation: r = \frac{\mathrm{TAS}^2}{g_0 \tan \varphi}" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: The horizontal component of lift supplies centripetal acceleration in a coordinated level turn. More bank tightens the turn at a fixed TAS; zero bank gives no finite turn radius."
    Case "Turn Rate"
        Return "Turn rate / ω" & CRLF & CRLF & "Definition: Signed angular turn rate under the level-turn assumption." & CRLF & CRLF & "Equation: \omega = \frac{g_0 \tan \varphi}{\mathrm{TAS}}" & CRLF & CRLF & "SI/reference unit: rad/s" & CRLF & CRLF & "Model Physics: Turn rate is the angular response to the centripetal acceleration supplied by banked lift. At a fixed bank, increasing TAS reduces the rate; the sign follows the selected turn direction."
    Case "AlongTrack Headwind"
        Return "Along-track headwind / HW_χ" & CRLF & CRLF & "Definition: Positive headwind opposes travel along the calculated track." & CRLF & CRLF & "Equation: \mathrm{HW}_\chi = V_W \cos(\psi_W - \chi)" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: Projecting wind against the calculated ground track gives the along-track headwind. Positive headwind reduces the ground-speed component relative to motion through the air."
    Case "AlongTrack Crosswind"
        Return "Along-track crosswind / CW_χ" & CRLF & CRLF & "Definition: Wind component perpendicular to the calculated track. The sign follows the documented convention." & CRLF & CRLF & "Equation: \mathrm{CW}_\chi = V_W \sin(\psi_W - \chi)" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: Projecting wind perpendicular to the calculated ground track gives its signed lateral component. This is a change of reference axes, not an additional wind velocity."
    Case "mass.MTOW"
        Return "Maximum takeoff mass / m_{TO}" & CRLF & CRLF & "Definition: Maximum mass approved for takeoff for the selected aircraft configuration. The value is supplied by the aircraft profile." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: This aircraft-data mass describes the selected takeoff loading limit. It enters the force balance as weight through m times standard gravity; the calculator does not derive the approved limit."
    Case "mass.MLW"
        Return "Maximum landing mass / m_L" & CRLF & CRLF & "Definition: Maximum mass approved for landing for the selected aircraft configuration. The value is supplied by the aircraft profile." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: This aircraft-data mass describes the selected landing loading limit. It enters lift and stall calculations through weight; the calculator does not derive the approved limit."
    Case "mass.MZFW"
        Return "Maximum zero-fuel mass / m_{ZFW}" & CRLF & CRLF & "Definition: Maximum aircraft mass without usable fuel, as defined by the aircraft data. The value is supplied by the aircraft profile." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: Zero-fuel mass separates the aircraft and payload loading from usable fuel. The stored value supplies mass to the force balance rather than being inferred from wing geometry."
    Case "mass.BOW"
        Return "Basic operating mass / m_{BOW}" & CRLF & CRLF & "Definition: Basic operating mass as defined by the aircraft operator or aircraft data. The value is supplied by the aircraft profile." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: Basic operating mass represents the equipped aircraft baseline defined by its operator. Selecting it supplies a mass for the lift and stall-speed equations."
    Case "mass.Heavy"
        Return "Heavy reference mass / m_{HEAVY}" & CRLF & CRLF & "Definition: User-defined heavy reference mass for the selected aircraft. This label has no standardized regulatory definition." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: This user-defined reference mass specifies a loading case. It supplies weight to the aerodynamic force balance; the label does not impose a universal aircraft limit."
    Case "mass.Light"
        Return "Light reference mass / m_{LIGHT}" & CRLF & CRLF & "Definition: User-defined light reference mass for the selected aircraft. This label has no standardized regulatory definition." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: This user-defined reference mass specifies a loading case. It supplies weight to the aerodynamic force balance; the label does not impose a universal aircraft limit."
    Case "CLmaxFlap"
        Return "Maximum lift coefficient by flap setting / C_{L,MAX}" & CRLF & CRLF & "Definition: Maximum lift coefficient recorded for one aircraft flap configuration. Each value is supplied by the aircraft profile." & CRLF & CRLF & "Equation: V_{S,\mathrm{TAS}} = \sqrt{\frac{2 \, m \, g_0}{\rho \, S_{\mathrm{REF}} \, C_{L,\mathrm{MAX}}}}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The limiting lift coefficient sets the lowest 1-g speed that can support the aircraft weight. Its value must come from aircraft data for the chosen flap configuration; the calculator does not predict it from geometry."
    Case Else
        Return "No help text is available for this item."
    End Select
End Sub
