' Help texts, maintained by hand. Keep in sync with web/src/catalog.ts and docs/quantity_catalog.json.
' tools/generate_latex_assets.js renders the Equation entries into Files/katex/eq.
Sub Process_Globals
End Sub
Public Sub Help(Key As String) As String
    Select Key
    Case "Hp"
        Return "Pressure altitude / H_P" & CRLF & CRLF & "Definition: ISA altitude corresponding to the local static pressure. Positive: pressure below ISA sea-level pressure." & CRLF & CRLF & "Equation: p_{\mathrm{ISA}}(H_P) = p" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Hydrostatic balance relates pressure to altitude in the layered ISA atmosphere. Inverting that pressure profile gives an equivalent pressure altitude, not a measurement of height above the ground."
    Case "Hg"
        Return "Geometric altitude / h" & CRLF & CRLF & "Definition: Geometric height above mean sea level. Positive: above mean sea level." & CRLF & CRLF & "Equation: h = \frac{r_0 \, H}{r_0 - H}" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Geometric height measures distance above sea level. The spherical-Earth conversion accounts for weakening gravity when converting between geometric and geopotential altitude."
    Case "P"
        Return "Static pressure / p" & CRLF & CRLF & "Definition: Absolute static pressure of the surrounding air." & CRLF & CRLF & "Equation: p = \rho \, R \, T" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: The ISA hydrostatic pressure profile represents the weight of the air column above the selected level. Local density then follows the ideal-gas relation using the entered temperature."
    Case "Δ ISA"
        Return "ISA temperature deviation / ΔT" & CRLF & CRLF & "Definition: Difference between actual static air temperature and ISA temperature at the same pressure altitude. Positive: warmer than ISA." & CRLF & CRLF & "Equation: \Delta T = T - T_{\mathrm{ISA}}(H_P)" & CRLF & CRLF & "SI/reference unit: K" & CRLF & CRLF & "Model Physics: The temperature offset changes the local thermal state at the same pressure altitude. Warmer air at fixed pressure has lower density; colder air has higher density."
    Case "OAT"
        Return "Outside air temperature / OAT" & CRLF & CRLF & "Definition: Static temperature of the surrounding air." & CRLF & CRLF & "Equation: T = T_{\mathrm{ISA}}(H_P) + \Delta T" & CRLF & CRLF & "SI/reference unit: K" & CRLF & CRLF & "Model Physics: Static air temperature sets density and sound speed. Adding the ISA temperature offset gives the local temperature without changing the selected pressure level."
    Case "TAS"
        Return "True airspeed / TAS" & CRLF & CRLF & "Definition: Magnitude of aircraft velocity relative to the surrounding air. Nonnegative." & CRLF & CRLF & "Equation: \mathrm{TAS} = M \cdot a" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: True airspeed measures motion through the air mass. Combining it with local density sets dynamic pressure; combining it with local sound speed gives Mach number."
    Case "CAS"
        Return "Calibrated airspeed / CAS" & CRLF & CRLF & "Definition: Airspeed at ISA sea-level conditions producing the same impact pressure as the actual flight condition. Nonnegative." & CRLF & CRLF & "Equation: \mathrm{CAS} = a_0 \sqrt{\frac{2}{\gamma - 1} \left[ \left( \frac{q_c}{p_0} + 1 \right)^{\frac{\gamma - 1}{\gamma}} - 1 \right]}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: The subsonic isentropic Pitot relation converts actual impact pressure to the speed that gives the same impact pressure at ISA sea level; compressibility is included."
    Case "EAS"
        Return "Equivalent airspeed / EAS" & CRLF & CRLF & "Definition: Airspeed at ISA sea-level conditions producing the same dynamic pressure as the actual flight condition. Nonnegative." & CRLF & CRLF & "Equation: \mathrm{EAS} = \mathrm{TAS} \sqrt{\frac{\rho}{\rho_0}}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: Equivalent airspeed preserves dynamic pressure: q = 0.5 ρ TAS² = 0.5 ρ₀ EAS². Unlike CAS, it is not defined by impact pressure."
    Case "Mach"
        Return "Mach number / M" & CRLF & CRLF & "Definition: Ratio of true airspeed to local speed of sound. Nonnegative." & CRLF & CRLF & "Equation: M = \frac{\mathrm{TAS}}{a}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: Mach compares airspeed with the speed of pressure disturbances in the local air. The pitot conversion used here describes subsonic, isentropic deceleration with gamma = 1.4."
    Case "CL"
        Return "Lift coefficient / C_L" & CRLF & CRLF & "Definition: Aerodynamic lift coefficient based on dynamic pressure and wing reference area. Positive: lift toward the aircraft upper side." & CRLF & CRLF & "Equation: C_L = \frac{n \cdot m \cdot g_0}{q \cdot S_{\mathrm{REF}}}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The lift equation balances aerodynamic lift against the selected normal load, n times weight. Increasing mass or load factor requires more dynamic pressure or a larger lift coefficient."
    Case "Vs Factor Output"
        Return "Stall speed factor / V_S factor" & CRLF & CRLF & "Definition: Ratio of current calibrated airspeed to reference 1-g stall speed in CAS. Nonnegative." & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: This dimensionless output is current CAS divided by the 1-g reference stall CAS. It is not an accelerated-stall speed or a maneuver load factor."
    Case "Vs Factor"
        Return "Stall speed factor / V_S factor" & CRLF & CRLF & "Definition: Input multiplier applied to reference 1-g stall speed in CAS, with an optional additive CAS increment. Nonnegative multiplier." & CRLF & CRLF & "Equation: \mathrm{CAS} = \mathrm{factor} \times V_{S,\mathrm{CAS}} + \Delta \mathrm{CAS}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The input factor scales the 1-g stall speed expressed as CAS; the optional additive increment is specified in knots. It does not change the reference stall speed or model accelerated stall."
    Case "Ground Speed"
        Return "Ground speed / GS" & CRLF & CRLF & "Definition: Magnitude of aircraft horizontal velocity relative to the ground. Nonnegative." & CRLF & CRLF & "Equation: V_{\mathrm{ground}} = V_{\mathrm{air}} + V_{\mathrm{wind}}" & CRLF & CRLF & "SI/reference unit: m/s"
    Case "Qdyn"
        Return "Dynamic pressure / q" & CRLF & CRLF & "Definition: Dynamic pressure of the air-relative flow. Nonnegative." & CRLF & CRLF & "Equation: q = \frac{1}{2} \rho \, \mathrm{TAS}^2" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: Dynamic pressure is kinetic energy per unit volume of moving air. It scales aerodynamic forces and rises with density and the square of true airspeed."
    Case "Qc"
        Return "Impact pressure / q_c" & CRLF & CRLF & "Definition: Difference between stagnation pressure and static pressure. Nonnegative in the adopted subsonic model." & CRLF & CRLF & "Equation: q_c = p \left[ \left( 1 + \frac{\gamma - 1}{2} M^2 \right)^{\frac{\gamma}{\gamma - 1}} - 1 \right]" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: A pitot opening brings the flow to rest and converts kinetic energy into compression. Impact pressure is stagnation minus static pressure; it approaches dynamic pressure at low Mach number."
    Case "Weight"
        Return "Aircraft mass / m" & CRLF & CRLF & "Definition: Aircraft weight, expressed as mass in the selected units for aerodynamic calculations. Nonnegative." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: Although traditionally labeled weight, this input is a mass-equivalent value in kg (or other mass units). Gravitational weight force is W = m g₀."
    Case "Sref"
        Return "Wing reference area / S_{REF}" & CRLF & CRLF & "Definition: Wing reference area used to define aerodynamic coefficients. Positive area." & CRLF & CRLF & "Equation: L = q \, S_{\mathrm{REF}} \, C_L" & CRLF & CRLF & "SI/reference unit: m²" & CRLF & CRLF & "Model Physics: Reference area is the chosen normalization area in the lift equation. A larger area produces more lift at the same dynamic pressure and lift coefficient; it does not determine wing shape."
    Case "cref"
        Return "Reference chord / c_{REF}" & CRLF & CRLF & "Definition: Wing reference chord used to calculate Reynolds number. Positive length." & CRLF & CRLF & "Equation: \mathrm{Re} = \frac{\rho \, \mathrm{TAS} \, c_{\mathrm{REF}}}{\mu}" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Reference chord sets the length scale for Reynolds number. Comparing inertial transport with molecular viscosity at that scale characterizes the flow regime; this calculation does not predict transition or separation."
    Case "CLmax"
        Return "Maximum lift coefficient / C_{L,MAX}" & CRLF & CRLF & "Definition: Maximum lift coefficient for the selected aircraft configuration. Positive coefficient." & CRLF & CRLF & "Equation: V_{S,\mathrm{TAS}} = \sqrt{\frac{2 \, m \, g_0}{\rho \, S_{\mathrm{REF}} \, C_{L,\mathrm{MAX}}}}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The limiting lift coefficient sets the lowest 1-g speed that can support the aircraft weight. Its value must come from aircraft data for the chosen flap configuration; the calculator does not predict it from geometry."
    Case "NzPullup"
        Return "Pull-up load factor / N_Z" & CRLF & CRLF & "Definition: Ratio of aerodynamic lift to aircraft weight in an unbanked maneuver. Positive: lift toward the aircraft upper side." & CRLF & CRLF & "Equation: L = n \cdot m \cdot g_0" & CRLF & CRLF & "SI/reference unit: g" & CRLF & CRLF & "Model Physics: Normal load factor is lift divided by weight. The unbanked pull-up model increases lift demand without introducing the bank relation used for a level turn."
    Case "NzTurn"
        Return "Level turn load factor / N_Z" & CRLF & CRLF & "Definition: Load factor in a coordinated level turn. Positive and not less than 1 in the adopted model." & CRLF & CRLF & "Equation: n = \frac{1}{\cos \varphi}" & CRLF & CRLF & "SI/reference unit: g" & CRLF & CRLF & "Model Physics: In a coordinated level turn, the vertical component of lift balances weight and the horizontal component provides centripetal acceleration. This gives n = 1/cos(bank), with bank magnitude below 90 degrees."
    Case "BankTurn"
        Return "Level turn bank angle / φ" & CRLF & CRLF & "Definition: Aircraft bank angle in a coordinated level turn. Positive: right wing down." & CRLF & CRLF & "Equation: n = \frac{1}{\cos \varphi}" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: In a coordinated level turn, the vertical component of lift balances weight and the horizontal component provides centripetal acceleration. This gives n = 1/cos(bank), with bank magnitude below 90 degrees."
    Case "Track"
        Return "Ground track angle / χ" & CRLF & CRLF & "Definition: Direction of the aircraft horizontal ground-velocity vector, measured clockwise from true north. Positive: clockwise (ground-velocity vector to the right)." & CRLF & CRLF & "Equation: \vec{V}_{\mathrm{ground}} = \vec{V}_{\mathrm{air}} + \vec{V}_{\mathrm{wind}}" & CRLF & CRLF & "SI/reference unit: rad"
    Case "Heading"
        Return "Aircraft heading / ψ" & CRLF & CRLF & "Definition: Direction in which the aircraft nose points, measured clockwise from true north. Positive: clockwise (nose to the right)." & CRLF & CRLF & "Equation: \psi = \chi + \mathrm{drift}" & CRLF & CRLF & "SI/reference unit: rad"
    Case "Sideslip"
        Return "Sideslip angle / β" & CRLF & CRLF & "Definition: Angle between the aircraft longitudinal axis and the incoming relative wind. Positive: relative wind coming from the right." & CRLF & CRLF & "Equation: \beta = \angle\left(\psi,\ \vec{V}_{\mathrm{air}}\right)" & CRLF & CRLF & "SI/reference unit: rad"
    Case "Drift"
        Return "Drift angle / drift" & CRLF & CRLF & "Definition: Angular difference between heading and ground track (heading minus track). Positive: heading to the right of track." & CRLF & CRLF & "Equation: \mathrm{drift} = \psi - \chi" & CRLF & CRLF & "SI/reference unit: rad"
    Case "HeadWind"
        Return "Reference headwind / HW" & CRLF & CRLF & "Definition: Wind component along the selected runway/reference direction. Positive: wind from ahead. Negative: tailwind." & CRLF & CRLF & "Equation: \mathrm{HW} = V_W \cos(\psi_W - \psi_{\mathrm{RWY}})" & CRLF & CRLF & "SI/reference unit: m/s"
    Case "Wind Speed"
        Return "Wind speed / V_W" & CRLF & CRLF & "Definition: Magnitude of horizontal wind velocity. Nonnegative." & CRLF & CRLF & "Equation: V_W = \sqrt{\mathrm{HW}^2 + \mathrm{CW}^2}" & CRLF & CRLF & "SI/reference unit: m/s"
    Case "CrossWind"
        Return "Reference crosswind / CW" & CRLF & CRLF & "Definition: Wind component perpendicular to the selected runway/reference direction. Positive: wind coming from the right. Negative: wind from the left." & CRLF & CRLF & "Equation: \mathrm{CW} = V_W \sin(\psi_W - \psi_{\mathrm{RWY}})" & CRLF & CRLF & "SI/reference unit: m/s"
    Case "Runway Angle"
        Return "Runway reference angle / RWY" & CRLF & CRLF & "Definition: Direction of the selected runway/reference axis, measured clockwise from true north. Positive: clockwise (reference direction to the right)." & CRLF & CRLF & "Equation: \psi_{\mathrm{RWY}} = \text{runway heading}" & CRLF & CRLF & "SI/reference unit: rad"
    Case "Wind Direction"
        Return "Wind direction from / wind from" & CRLF & CRLF & "Definition: Direction from which the wind blows, measured clockwise from true north. Positive: clockwise (wind-from direction to the right)." & CRLF & CRLF & "Equation: \psi_W = \text{meteorological wind direction}" & CRLF & CRLF & "SI/reference unit: rad"
    Case "Pressure Altitude"
        Return "Pressure altitude / H_P" & CRLF & CRLF & "Definition: ISA altitude corresponding to the local static pressure. Positive: pressure below ISA sea-level pressure." & CRLF & CRLF & "Equation: p_{\mathrm{ISA}}(H_P) = p" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Hydrostatic balance relates pressure to altitude in the layered ISA atmosphere. Inverting that pressure profile gives an equivalent pressure altitude, not a measurement of height above the ground."
    Case "Geometric Altitude"
        Return "Geometric altitude / h" & CRLF & CRLF & "Definition: Geometric height above mean sea level. Positive: above mean sea level." & CRLF & CRLF & "Equation: h = \frac{r_0 \, H}{r_0 - H}" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Geometric height measures distance above sea level. The spherical-Earth conversion accounts for weakening gravity when converting between geometric and geopotential altitude."
    Case "Pressure"
        Return "Static pressure / p" & CRLF & CRLF & "Definition: Absolute static pressure of the surrounding air." & CRLF & CRLF & "Equation: p = \rho \, R \, T" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: The ISA hydrostatic pressure profile represents the weight of the air column above the selected level. Local density then follows the ideal-gas relation using the entered temperature."
    Case "Temperature"
        Return "Outside air temperature / OAT" & CRLF & CRLF & "Definition: Static temperature of the surrounding air." & CRLF & CRLF & "Equation: T = T_{\mathrm{ISA}}(H_P) + \Delta T" & CRLF & CRLF & "SI/reference unit: K" & CRLF & CRLF & "Model Physics: Static air temperature sets density and sound speed. Adding the ISA temperature offset gives the local temperature without changing the selected pressure level."
    Case "Delta ISA"
        Return "ISA temperature deviation / ΔT" & CRLF & CRLF & "Definition: Difference between actual static air temperature and ISA temperature at the same pressure altitude. Positive: warmer than ISA." & CRLF & CRLF & "Equation: \Delta T = T - T_{\mathrm{ISA}}(H_P)" & CRLF & CRLF & "SI/reference unit: K" & CRLF & CRLF & "Model Physics: The temperature offset changes the local thermal state at the same pressure altitude. Warmer air at fixed pressure has lower density; colder air has higher density."
    Case "True Airspeed"
        Return "True airspeed / TAS" & CRLF & CRLF & "Definition: Magnitude of aircraft velocity relative to the surrounding air. Nonnegative." & CRLF & CRLF & "Equation: \mathrm{TAS} = M \cdot a" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: True airspeed measures motion through the air mass. Combining it with local density sets dynamic pressure; combining it with local sound speed gives Mach number."
    Case "Calibrated Airspeed"
        Return "Calibrated airspeed / CAS" & CRLF & CRLF & "Definition: Airspeed at ISA sea-level conditions producing the same impact pressure as the actual flight condition. Nonnegative." & CRLF & CRLF & "Equation: \mathrm{CAS} = a_0 \sqrt{\frac{2}{\gamma - 1} \left[ \left( \frac{q_c}{p_0} + 1 \right)^{\frac{\gamma - 1}{\gamma}} - 1 \right]}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: The subsonic isentropic Pitot relation converts actual impact pressure to the speed that gives the same impact pressure at ISA sea level; compressibility is included."
    Case "Equivalent Airspeed"
        Return "Equivalent airspeed / EAS" & CRLF & CRLF & "Definition: Airspeed at ISA sea-level conditions producing the same dynamic pressure as the actual flight condition. Nonnegative." & CRLF & CRLF & "Equation: \mathrm{EAS} = \mathrm{TAS} \sqrt{\frac{\rho}{\rho_0}}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: Equivalent airspeed preserves dynamic pressure: q = 0.5 ρ TAS² = 0.5 ρ₀ EAS². Unlike CAS, it is not defined by impact pressure."
    Case "Lift Coefficient CL"
        Return "Lift coefficient / C_L" & CRLF & CRLF & "Definition: Aerodynamic lift coefficient based on dynamic pressure and wing reference area. Positive: lift toward the aircraft upper side." & CRLF & CRLF & "Equation: C_L = \frac{n \cdot m \cdot g_0}{q \cdot S_{\mathrm{REF}}}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The lift equation balances aerodynamic lift against the selected normal load, n times weight. Increasing mass or load factor requires more dynamic pressure or a larger lift coefficient."
    Case "Dynamic Pressure"
        Return "Dynamic pressure / q" & CRLF & CRLF & "Definition: Dynamic pressure of the air-relative flow. Nonnegative." & CRLF & CRLF & "Equation: q = \frac{1}{2} \rho \, \mathrm{TAS}^2" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: Dynamic pressure is kinetic energy per unit volume of moving air. It scales aerodynamic forces and rises with density and the square of true airspeed."
    Case "Impact Pressure"
        Return "Impact pressure / q_c" & CRLF & CRLF & "Definition: Difference between stagnation pressure and static pressure. Nonnegative in the adopted subsonic model." & CRLF & CRLF & "Equation: q_c = p \left[ \left( 1 + \frac{\gamma - 1}{2} M^2 \right)^{\frac{\gamma}{\gamma - 1}} - 1 \right]" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: A pitot opening brings the flow to rest and converts kinetic energy into compression. Impact pressure is stagnation minus static pressure; it approaches dynamic pressure at low Mach number."
    Case "Bank Angle φ"
        Return "Level turn bank angle / φ" & CRLF & CRLF & "Definition: Aircraft bank angle in a coordinated level turn. Positive: right wing down." & CRLF & CRLF & "Equation: n = \frac{1}{\cos \varphi}" & CRLF & CRLF & "SI/reference unit: rad" & CRLF & CRLF & "Model Physics: In a coordinated level turn, the vertical component of lift balances weight and the horizontal component provides centripetal acceleration. This gives n = 1/cos(bank), with bank magnitude below 90 degrees."
    Case "Track Angle"
        Return "Ground track angle / χ" & CRLF & CRLF & "Definition: Direction of the aircraft horizontal ground-velocity vector, measured clockwise from true north. Positive: clockwise (ground-velocity vector to the right)." & CRLF & CRLF & "Equation: \vec{V}_{\mathrm{ground}} = \vec{V}_{\mathrm{air}} + \vec{V}_{\mathrm{wind}}" & CRLF & CRLF & "SI/reference unit: rad"
    Case "Heading Angle Ψ"
        Return "Aircraft heading / ψ" & CRLF & CRLF & "Definition: Direction in which the aircraft nose points, measured clockwise from true north. Positive: clockwise (nose to the right)." & CRLF & CRLF & "Equation: \psi = \chi + \mathrm{drift}" & CRLF & CRLF & "SI/reference unit: rad"
    Case "Drift Angle"
        Return "Drift angle / drift" & CRLF & CRLF & "Definition: Angular difference between heading and ground track (heading minus track). Positive: heading to the right of track." & CRLF & CRLF & "Equation: \mathrm{drift} = \psi - \chi" & CRLF & CRLF & "SI/reference unit: rad"
    Case "Sideslip Angle β"
        Return "Sideslip angle / β" & CRLF & CRLF & "Definition: Angle between the aircraft longitudinal axis and the incoming relative wind. Positive: relative wind coming from the right." & CRLF & CRLF & "Equation: \beta = \angle\left(\psi,\ \vec{V}_{\mathrm{air}}\right)" & CRLF & CRLF & "SI/reference unit: rad"
    Case "Geopotential Altitude"
    ' H_G below is renderer markup: FormatScriptedText displays g as a subscript; the underscore is never shown.
        Return "Geopotential altitude / H_G" & CRLF & CRLF & "Definition: Altitude equivalent to gravitational potential energy per unit mass under constant standard gravity. Positive: above the reference datum." & CRLF & CRLF & "Equation: H = \frac{r_0 \, h}{r_0 + h}" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Geopotential height represents gravitational potential using standard gravity. When derived from pressure altitude, the calculator applies its specified temperature-offset model; this is not simply geometric height."
    Case "Density Altitude"
        Return "Density altitude / H_ρ" & CRLF & CRLF & "Definition: ISA altitude corresponding to the actual air density. Positive: above ISA sea level." & CRLF & CRLF & "Equation: \rho_{\mathrm{ISA}}(H_\rho) = \rho" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: Density altitude is the ISA level with the same air density as the current condition. It summarizes density effects on aerodynamic forces without claiming that the aircraft is physically at that height."
    Case "Temperature Altitude"
        Return "Temperature altitude / H_T" & CRLF & CRLF & "Definition: Tropospheric ISA altitude corresponding to actual static temperature, limited to 11 km in this model. Positive: above ISA sea level." & CRLF & CRLF & "Equation: T_{\mathrm{ISA}}(H_T) = T" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: The calculation uses the tropospheric ISA lapse rate and caps temperatures at or below 216.65 K at 11 km. Temperature alone cannot identify a unique altitude across all ISA layers."
    Case "Density"
        Return "Air density / ρ" & CRLF & CRLF & "Definition: Mass of air per unit volume. Positive scalar." & CRLF & CRLF & "Equation: \rho = \frac{p}{R \, T}" & CRLF & CRLF & "SI/reference unit: kg/m³" & CRLF & CRLF & "Model Physics: The ideal-gas equation links density to static pressure and absolute temperature for dry air. At the same pressure, heating expands the air and reduces its mass per unit volume."
    Case "Total Temperature"
        Return "Total air temperature / TAT" & CRLF & CRLF & "Definition: Stagnation temperature obtained by adiabatically bringing the air-relative flow to rest." & CRLF & CRLF & "Equation: T_T = T \left( 1 + \frac{\gamma - 1}{2} M^2 \right)" & CRLF & CRLF & "SI/reference unit: K" & CRLF & CRLF & "Model Physics: Adiabatic deceleration converts kinetic energy into internal energy, raising temperature as the air is brought to rest. The ideal stagnation relation uses a constant specific-heat ratio of 1.4, without a probe recovery correction."
    Case "Viscosity"
        Return "Dynamic viscosity / μ" & CRLF & CRLF & "Definition: Dynamic viscosity of air at the local static temperature. Positive scalar." & CRLF & CRLF & "Equation: \mu = \mu_0 \, \frac{T_0 + C}{T + C} \left( \frac{T}{T_0} \right)^{3/2}" & CRLF & CRLF & "SI/reference unit: Pa·s" & CRLF & CRLF & "Model Physics: Air viscosity represents molecular momentum transport. Sutherland's law models its dependence on static temperature: dynamic viscosity increases with temperature and sets the viscous scale in Reynolds number."
    Case "Sound Speed"
        Return "Speed of sound / a" & CRLF & CRLF & "Definition: Speed of propagation of small pressure disturbances in the surrounding air. Positive scalar." & CRLF & CRLF & "Equation: a = \sqrt{\gamma \, R \, T}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: Small pressure disturbances propagate through ideal air at a speed set by absolute temperature and the specific-heat ratio. Warmer air has a higher sound speed."
    Case "Stall Speed Vs"
        Return "Reference stall speed / V_S" & CRLF & CRLF & "Definition: Reference 1-g stall speed for the selected aircraft mass and configuration, expressed as CAS. Nonnegative." & CRLF & CRLF & "Equation: V_{S,\mathrm{TAS}} = \sqrt{\frac{2 \, m \, g_0}{\rho \, S_{\mathrm{REF}} \, C_{L,\mathrm{MAX}}}}" & CRLF & CRLF & "SI/reference unit: m/s" & CRLF & CRLF & "Model Physics: At the 1-g stall reference, maximum lift just balances weight. The result is converted from TAS to CAS; maneuver load factor does not alter this reference value."
    Case "Reynolds"
        Return "Reynolds number / Re" & CRLF & CRLF & "Definition: Ratio of inertial to viscous effects based on true airspeed and reference chord. Nonnegative." & CRLF & CRLF & "Equation: \mathrm{Re} = \frac{\rho \, \mathrm{TAS} \, c_{\mathrm{REF}}}{\mu}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: Reynolds number compares inertial and viscous effects over the reference chord. Increasing speed, density, or chord increases this ratio; increasing viscosity reduces it."
    Case "Pressure Ratio δ"
        Return "Pressure ratio / δ" & CRLF & CRLF & "Definition: Ratio of local static pressure to standard sea-level pressure. Positive scalar." & CRLF & CRLF & "Equation: \delta = \frac{p}{p_0}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: Dividing static pressure by standard sea-level pressure gives a dimensionless atmospheric pressure scale. It is used to normalize weight and compare conditions across pressure levels."
    Case "Density Ratio σ"
        Return "Density ratio / σ" & CRLF & CRLF & "Definition: Ratio of local air density to standard sea-level density. Positive scalar." & CRLF & CRLF & "Equation: \sigma = \frac{\rho}{\rho_0}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The density ratio compares local air density with standard sea-level density. Its square root relates true and equivalent airspeed at equal dynamic pressure."
    Case "Temperature Ratio θ"
        Return "Temperature ratio / θ" & CRLF & CRLF & "Definition: Ratio of local absolute temperature to standard sea-level absolute temperature. Positive scalar." & CRLF & CRLF & "Equation: \theta = \frac{T}{T_0}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The temperature ratio compares absolute local temperature with the standard sea-level temperature. Absolute temperature is required because molecular thermal energy sets sound speed and the ideal-gas density relation."
    Case "Total Pressure"
        Return "Total pressure / p_T" & CRLF & CRLF & "Definition: Stagnation pressure of the air-relative flow under isentropic conditions." & CRLF & CRLF & "Equation: p_T = p + q_c" & CRLF & CRLF & "SI/reference unit: Pa" & CRLF & CRLF & "Model Physics: Stagnation pressure is the pressure after ideal subsonic, isentropic deceleration to rest. Adding pitot impact pressure to static pressure gives this total pressure; shocks and flow losses are not modeled."
    Case "DynPressure * S / g"
        Return "Dynamic pressure force equivalent / qS/g_0" & CRLF & CRLF & "Definition: Aerodynamic reference force qS expressed numerically in kilogram-force (kgf). Nonnegative." & CRLF & CRLF & "Equation: \frac{q \cdot S_{\mathrm{REF}}}{g_0}" & CRLF & CRLF & "SI/reference unit: kgf" & CRLF & CRLF & "Model Physics: Dynamic pressure times reference area gives an aerodynamic force scale before multiplying by a force coefficient. Dividing by standard gravity expresses that force in kgf; it is not aircraft mass."
    Case "Lift Force"
        Return "Lift force / L" & CRLF & CRLF & "Definition: Aerodynamic lift force required by the selected load factor. Positive: lift toward the aircraft upper side." & CRLF & CRLF & "Equation: \frac{L}{g_0} = \frac{q \cdot S_{\mathrm{REF}} \cdot C_L}{g_0} = n \cdot m" & CRLF & CRLF & "SI/reference unit: kgf" & CRLF & CRLF & "Model Physics: Lift is dynamic pressure times reference area and lift coefficient, and equals the selected normal load times weight. The displayed kgf value converts that force using standard gravity."
    Case "Weight/Delta W/δ"
        Return "Weight divided by pressure ratio / W/δ" & CRLF & CRLF & "Definition: Aircraft weight divided by atmospheric pressure ratio δ. Positive for positive aircraft weight." & CRLF & CRLF & "Equation: \frac{W}{\delta \cdot g_0} = \frac{m}{\delta}" & CRLF & CRLF & "SI/reference unit: kgf" & CRLF & CRLF & "Model Physics: Dividing weight by pressure ratio normalizes the aircraft load to standard sea-level pressure. The kgf display is a force normalization, not a change in the actual aircraft mass."
    Case "Load Factor Nz"
        Return "Normal load factor / N_Z" & CRLF & CRLF & "Definition: Ratio of aerodynamic lift to aircraft weight. Positive: lift toward the aircraft upper side." & CRLF & CRLF & "Equation: n = \frac{L}{W} = \frac{1}{\cos \varphi}" & CRLF & CRLF & "SI/reference unit: g" & CRLF & CRLF & "Model Physics: Normal load factor measures lift relative to weight. In the level-turn mode it follows the vertical lift balance; in pull-up mode it is supplied directly."
    Case "Turn Radius"
        Return "Turn radius / r" & CRLF & CRLF & "Definition: Signed radius of a coordinated level turn relative to the air mass. Positive: right turn. Negative: left turn." & CRLF & CRLF & "Equation: r = \frac{\mathrm{TAS}^2}{g_0 \tan \varphi}" & CRLF & CRLF & "SI/reference unit: m" & CRLF & CRLF & "Model Physics: The radius and turn rate use true airspeed in a coordinated level-turn model. A steady wind translates the air-relative circular path; the ground path is not generally circular."
    Case "Turn Rate"
        Return "Turn rate / ω" & CRLF & CRLF & "Definition: Rate of change of aircraft heading in a coordinated level turn. Positive: clockwise (right turn)." & CRLF & CRLF & "Equation: \omega = \frac{g_0 \tan \varphi}{\mathrm{TAS}}" & CRLF & CRLF & "SI/reference unit: rad/s" & CRLF & CRLF & "Model Physics: The rate is calculated for a coordinated, constant-altitude turn using true airspeed and bank angle. The sign follows turn direction, not wind direction."
    Case "AlongTrack Headwind"
        Return "Along-track headwind / HW_χ" & CRLF & CRLF & "Definition: Wind component along the aircraft ground track. Positive: wind from ahead. Negative: tailwind." & CRLF & CRLF & "Equation: \mathrm{HW}_\chi = V_W \cos(\psi_W - \chi)" & CRLF & CRLF & "SI/reference unit: m/s"
    Case "AlongTrack Crosswind"
        Return "Along-track crosswind / CW_χ" & CRLF & CRLF & "Definition: Wind component perpendicular to the aircraft ground track. Positive: wind coming from the right. Negative: wind from the left." & CRLF & CRLF & "Equation: \mathrm{CW}_\chi = V_W \sin(\psi_W - \chi)" & CRLF & CRLF & "SI/reference unit: m/s"
    Case "mass.MTOW"
        Return "Maximum takeoff weight / m_{TO}" & CRLF & CRLF & "Definition: Maximum takeoff weight approved for the aircraft, expressed as mass in the selected units." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: The conventional aircraft-data name uses weight, while the profile stores the numerical mass equivalent used by the calculator."
    Case "mass.MLW"
        Return "Maximum landing weight / m_L" & CRLF & CRLF & "Definition: Maximum landing weight approved for the aircraft, expressed as mass in the selected units." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: The conventional aircraft-data name uses weight, while the profile stores the numerical mass equivalent used by the calculator."
    Case "mass.MZFW"
        Return "Maximum zero-fuel weight / m_{ZFW}" & CRLF & CRLF & "Definition: Maximum zero-fuel weight, excluding usable fuel, expressed as mass in the selected units." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: The conventional aircraft-data name uses weight, while the profile stores the numerical mass equivalent used by the calculator."
    Case "mass.BOW"
        Return "Basic operating weight / m_{BOW}" & CRLF & CRLF & "Definition: Basic Operating Weight as defined by the aircraft manufacturer." & CRLF & CRLF & "SI/reference unit: kg"
    Case "mass.Heavy"
        Return "Heavy reference weight / m_{HEAVY}" & CRLF & CRLF & "Definition: User-defined heavy reference weight, expressed as mass in the selected units." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: Heavy is a user-defined loading reference, not a regulatory weight limit."
    Case "mass.Light"
        Return "Light reference weight / m_{LIGHT}" & CRLF & CRLF & "Definition: User-defined light reference weight, expressed as mass in the selected units." & CRLF & CRLF & "Equation: W = m \cdot g_0 \quad (\text{weight})" & CRLF & CRLF & "SI/reference unit: kg" & CRLF & CRLF & "Model Physics: Light is a user-defined loading reference, not a regulatory weight limit."
    Case "CLmaxFlap"
        Return "Maximum lift coefficient by flap setting / C_{L,MAX}" & CRLF & CRLF & "Definition: Maximum lift coefficient for the specified flap configuration. Positive coefficient." & CRLF & CRLF & "Equation: V_{S,\mathrm{TAS}} = \sqrt{\frac{2 \, m \, g_0}{\rho \, S_{\mathrm{REF}} \, C_{L,\mathrm{MAX}}}}" & CRLF & CRLF & "SI/reference unit: —" & CRLF & CRLF & "Model Physics: The limiting lift coefficient sets the lowest 1-g speed that can support the aircraft weight. Its value must come from aircraft data for the chosen flap configuration; the calculator does not predict it from geometry."
    Case Else
        Return "No help text is available for this item."
    End Select
End Sub
